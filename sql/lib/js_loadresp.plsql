--
-- sql/lib/js_loadresp.plsql
--
-- The client script of section 20_load_response (Load vs response time).
-- @@-included by sql/20_load_response.sql, after its markup and payload.
--
-- No literal tilde below (SET DEFINE tilde).  GENERATED: the body below
-- (BEGIN .. END) is written by tools/js2plsql.sh from the readable source
-- sql/lib/src/js_loadresp.js -- edit that file and regenerate.
--
BEGIN
    DBMS_OUTPUT.PUT_LINE('<script>');
    DBMS_OUTPUT.PUT_LINE('/* js_loadresp: client half of section 20 (Load vs response time).');
    DBMS_OUTPUT.PUT_LINE('   Draws the scatter of window.AWR_DATA.loadresp into #load-response');
    DBMS_OUTPUT.PUT_LINE('   .lr-plot as inline SVG: the grey cloud (one dot per snapshot interval),');
    DBMS_OUTPUT.PUT_LINE('   the normal curve (bin medians, dashed) and its middle-half band, the');
    DBMS_OUTPUT.PUT_LINE('   prior windows (rings, data-w) and the Current window (accent dot +');
    DBMS_OUTPUT.PUT_LINE('   label).  The segmented controls switch the load / response pair and');
    DBMS_OUTPUT.PUT_LINE('   the "Reads as" sentence (computed in PL/SQL per pair).  Redraws on');
    DBMS_OUTPUT.PUT_LINE('   resize (ResizeObserver), awr:view and window resize; draws nothing');
    DBMS_OUTPUT.PUT_LINE('   while the plot has no width (a closed library row).  Colours come from');
    DBMS_OUTPUT.PUT_LINE('   CSS classes only.  Pure ASCII. */');
    DBMS_OUTPUT.PUT_LINE('(function(){');
    DBMS_OUTPUT.PUT_LINE('''use strict'';');
    DBMS_OUTPUT.PUT_LINE('var doc=document,NS=''http://www.w3.org/2000/svg'',D=null,sec=null,plot=null,cur={x:0,y:0},tip=null,lastW=0;');
    DBMS_OUTPUT.PUT_LINE('function el(n,a,p){var e=doc.createElementNS(NS,n);for(var k in a)if(a[k]!=null)e.setAttribute(k,a[k]);if(p)p.appendChild(e);return e;}');
    DBMS_OUTPUT.PUT_LINE('function tx(p,x,y,s,c,anc){var t=el(''text'',{x:x,y:y,''class'':c||null,''text-anchor'':anc||null},p);t.textContent=s;return t;}');
    DBMS_OUTPUT.PUT_LINE('function esc(s){return String(s).replace(/&/g,''&amp;'').replace(/</g,''&lt;'').replace(/>/g,''&gt;'');}');
    DBMS_OUTPUT.PUT_LINE('/* fmt_num''s look: about 4 significant digits, k / M / G past 1e4 / 1e6 / 1e9 */');
    DBMS_OUTPUT.PUT_LINE('function fmt(v){');
    DBMS_OUTPUT.PUT_LINE('  if(v==null||isNaN(v))return ''\u2014'';if(v===0)return ''0'';');
    DBMS_OUTPUT.PUT_LINE('  var a=Math.abs(v),s=v<0?''-'':'''',u='''';');
    DBMS_OUTPUT.PUT_LINE('  if(a>=1e9){a/=1e9;u='' G'';}else if(a>=1e6){a/=1e6;u='' M'';}else if(a>=1e4){a/=1e3;u='' k'';}');
    DBMS_OUTPUT.PUT_LINE('  var d=a>=1000?0:a>=100?1:a>=10?2:a>=1?3:4,t=a.toFixed(d);');
    DBMS_OUTPUT.PUT_LINE('  if(!u&&a>=1000)t=t.replace(/\B(?=(\d{3})+(?!\d))/g,'','');');
    DBMS_OUTPUT.PUT_LINE('  if(!u&&a<1)t=String(+a.toPrecision(4));');
    DBMS_OUTPUT.PUT_LINE('  return s+t+u;');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('/* x / y of pair p from the five window / interval metrics');
    DBMS_OUTPUT.PUT_LINE('   m = [user calls/s, executions/s, logical reads/s, service time ms, DB time cs/s] */');
    DBMS_OUTPUT.PUT_LINE('/* an axis tick: no trailing zeros, k / M past 1e4 / 1e6 */');
    DBMS_OUTPUT.PUT_LINE('function tfmt(v){var a=Math.abs(v),u='''';if(a>=1e6){v/=1e6;u=''M'';}else if(a>=1e4){v/=1e3;u=''k'';}');
    DBMS_OUTPUT.PUT_LINE('  var t=String(+v.toFixed(6));if(!u&&Math.abs(v)>=1000)t=t.replace(/\B(?=(\d{3})+(?!\d))/g,'','');return t+u;}');
    DBMS_OUTPUT.PUT_LINE('function xv(p,m){var v=m[p%3];return v!=null&&v>0?v:null;}');
    DBMS_OUTPUT.PUT_LINE('function yv(p,m){var x=xv(p,m);if(x==null)return null;if(p<3)return m[3];if(m[4]==null)return null;return m[4]*10/x*(p%3===2?1000:1);}');
    DBMS_OUTPUT.PUT_LINE('function pid(){return cur.x+3*cur.y;}');
    DBMS_OUTPUT.PUT_LINE('function niceStep(span,n){var r=span/n,p=Math.pow(10,Math.floor(Math.log(r)/Math.LN10)),q=r/p;return (q<1.5?1:q<3?2:q<7?5:10)*p;}');
    DBMS_OUTPUT.PUT_LINE('function pctl(a,q){if(!a.length)return null;var s=a.slice().sort(function(x,y){return x-y;}),i=(s.length-1)*q,l=Math.floor(i),h=Math.ceil(i);return s[l]+(s[h]-s[l])*(i-l);}');
    DBMS_OUTPUT.PUT_LINE('var MON=[''Jan'',''Feb'',''Mar'',''Apr'',''May'',''Jun'',''Jul'',''Aug'',''Sep'',''Oct'',''Nov'',''Dec''],DY=[''Sun'',''Mon'',''Tue'',''Wed'',''Thu'',''Fri'',''Sat''];');
    DBMS_OUTPUT.PUT_LINE('var T0=0;');
    DBMS_OUTPUT.PUT_LINE('function tAt(min){var d=new Date(T0+min*60000),z=function(v){return (v<10?''0'':'''')+v;};');
    DBMS_OUTPUT.PUT_LINE('  return DY[d.getUTCDay()]+'' ''+d.getUTCDate()+'' ''+MON[d.getUTCMonth()]+'' ''+z(d.getUTCHours())+'':''+z(d.getUTCMinutes());}');
    DBMS_OUTPUT.PUT_LINE('function tipOn(html,cx,cy){if(!tip)return;tip.innerHTML=html;tip.hidden=false;');
    DBMS_OUTPUT.PUT_LINE('  var x=cx+14,y=cy+16,w=tip.offsetWidth,h=tip.offsetHeight;');
    DBMS_OUTPUT.PUT_LINE('  if(x+w>innerWidth-8)x=cx-w-12;if(y+h>innerHeight-8)y=cy-h-12;');
    DBMS_OUTPUT.PUT_LINE('  tip.style.left=Math.max(8,x)+''px'';tip.style.top=Math.max(8,y)+''px'';}');
    DBMS_OUTPUT.PUT_LINE('function tipOff(){if(tip)tip.hidden=true;}');
    DBMS_OUTPUT.PUT_LINE('function draw(){');
    DBMS_OUTPUT.PUT_LINE('  if(!D||!plot)return;');
    DBMS_OUTPUT.PUT_LINE('  var W=plot.clientWidth;if(!W)return;lastW=W;');
    DBMS_OUTPUT.PUT_LINE('  var p=pid(),P=D.p[p],narrow=W<560,H=narrow?280:350,L=narrow?40:52,R=narrow?10:18,T=26,B=40,i,k;');
    DBMS_OUTPUT.PUT_LINE('  plot.innerHTML='''';');
    DBMS_OUTPUT.PUT_LINE('  if(!P||!P.n){plot.innerHTML=''<p class="note">No intervals with this load and response pair.</p>'';return;}');
    DBMS_OUTPUT.PUT_LINE('  /* points */');
    DBMS_OUTPUT.PUT_LINE('  var bx=[],by=[],bi=[];');
    DBMS_OUTPUT.PUT_LINE('  for(i=0;i<D.bt.length;i++){var m=[D.b0[i],D.b1[i],D.b2[i],D.b3[i],D.b4[i]],x=xv(p,m),y=yv(p,m);if(x==null||y==null)continue;bx.push(x);by.push(y);bi.push(i);}');
    DBMS_OUTPUT.PUT_LINE('  var ws=[];D.w.forEach(function(w){if(w.v!==''Y''||!w.m.length)return;var x=xv(p,w.m),y=yv(p,w.m);if(x==null||y==null)return;ws.push({w:w,x:x,y:y});});');
    DBMS_OUTPUT.PUT_LINE('  var cw=null;ws.forEach(function(o){if(o.w.o===0)cw=o;});');
    DBMS_OUTPUT.PUT_LINE('  /* axis ranges: the windows and the curve always fit; the cloud up to');
    DBMS_OUTPUT.PUT_LINE('     its 98th / 96th percentile (outliers pin to the edge with a caret) */');
    DBMS_OUTPUT.PUT_LINE('  var xm=pctl(bx,0.98)||0,ym=pctl(by,0.96)||0;');
    DBMS_OUTPUT.PUT_LINE('  ws.forEach(function(o){xm=Math.max(xm,o.x);ym=Math.max(ym,o.y);});');
    DBMS_OUTPUT.PUT_LINE('  P.c.forEach(function(c){xm=Math.max(xm,c[0]);ym=Math.max(ym,c[3]);});');
    DBMS_OUTPUT.PUT_LINE('  if(!(xm>0))xm=1;if(!(ym>0))ym=1;');
    DBMS_OUTPUT.PUT_LINE('  var xs=niceStep(xm*1.05,narrow?4:6),ys=niceStep(ym*1.08,5),xM=Math.ceil(xm*1.05/xs)*xs,yM=Math.ceil(ym*1.08/ys)*ys;');
    DBMS_OUTPUT.PUT_LINE('  var X=function(v){return L+(W-L-R)*Math.min(v,xM)/xM;},Y=function(v){return H-B-(H-T-B)*Math.min(v,yM)/yM;};');
    DBMS_OUTPUT.PUT_LINE('  var s=el(''svg'',{width:W,height:H,viewBox:''0 0 ''+W+'' ''+H,''class'':''lr-svg'',role:''img'',');
    DBMS_OUTPUT.PUT_LINE('    ''aria-label'':P.xl+'' against ''+P.yl+'': ''+bx.length+'' snapshot intervals, ''+ws.length+'' windows''+(cw?'', Current ''+fmt(cw.x)+'' ''+P.xu+'', ''+fmt(cw.y)+'' ''+P.yu:'''')},plot);');
    DBMS_OUTPUT.PUT_LINE('  for(var v=0;v<=yM+ys/2;v+=ys){el(''line'',{x1:L,x2:W-R,y1:Y(v),y2:Y(v),''class'':v?''lr-g'':''lr-ax''},s);tx(s,L-6,Y(v)+4,tfmt(v),''lr-tl'',''end'');}');
    DBMS_OUTPUT.PUT_LINE('  for(v=0;v<=xM+xs/2;v+=xs){el(''line'',{x1:X(v),x2:X(v),y1:H-B,y2:H-B+4,''class'':''lr-ax''},s);tx(s,X(v),H-B+16,tfmt(v),''lr-tl'',X(v)>W-R-14?''end'':''middle'');}');
    DBMS_OUTPUT.PUT_LINE('  el(''line'',{x1:L,x2:L,y1:T,y2:H-B,''class'':''lr-ax''},s);');
    DBMS_OUTPUT.PUT_LINE('  tx(s,L-(narrow?36:48),12,P.yl,''lr-at'');tx(s,W-R,H-4,P.xl,''lr-at'',''end'');');
    DBMS_OUTPUT.PUT_LINE('  /* the normal band + curve */');
    DBMS_OUTPUT.PUT_LINE('  if(P.c.length>=2){');
    DBMS_OUTPUT.PUT_LINE('    var up='''',dn='''',ln='''';');
    DBMS_OUTPUT.PUT_LINE('    P.c.forEach(function(c,j){up+=(j?''L'':''M'')+X(c[0]).toFixed(1)+'' ''+Y(c[3]).toFixed(1);ln+=(j?''L'':''M'')+X(c[0]).toFixed(1)+'' ''+Y(c[1]).toFixed(1);});');
    DBMS_OUTPUT.PUT_LINE('    for(j=P.c.length-1;j>=0;j--)dn+=''L''+X(P.c[j][0]).toFixed(1)+'' ''+Y(P.c[j][2]).toFixed(1);');
    DBMS_OUTPUT.PUT_LINE('    el(''path'',{d:up+dn+''Z'',''class'':''lr-band''},s);el(''path'',{d:ln,''class'':''lr-norm''},s);');
    DBMS_OUTPUT.PUT_LINE('  }');
    DBMS_OUTPUT.PUT_LINE('  var j;');
    DBMS_OUTPUT.PUT_LINE('  /* the cloud */');
    DBMS_OUTPUT.PUT_LINE('  var gb=el(''g'',{''class'':''lr-cloud''},s);');
    DBMS_OUTPUT.PUT_LINE('  for(k=0;k<bx.length;k++){var ix=bi[k],out=bx[k]>xM||by[k]>yM,c=D.bc[ix]===1;');
    DBMS_OUTPUT.PUT_LINE('    el(out?''rect'':''circle'',out?{x:X(bx[k])-2,y:Y(by[k])-2,width:4,height:4,''class'':''lr-b out''+(c?'' c'':''''),''data-b'':k}');
    DBMS_OUTPUT.PUT_LINE('      :{cx:X(bx[k]).toFixed(1),cy:Y(by[k]).toFixed(1),r:c?2.6:2,''class'':''lr-b''+(c?'' c'':''''),''data-b'':k},gb);}');
    DBMS_OUTPUT.PUT_LINE('  /* prior windows, then Current */');
    DBMS_OUTPUT.PUT_LINE('  ws.forEach(function(o){if(o.w.o===0)return;');
    DBMS_OUTPUT.PUT_LINE('    el(''circle'',{cx:X(o.x).toFixed(1),cy:Y(o.y).toFixed(1),r:5,''class'':''lr-w'',''data-w'':o.w.o,''data-k'':''w''+o.w.o,tabindex:0,');
    DBMS_OUTPUT.PUT_LINE('      ''aria-label'':o.w.l+'' window, ''+o.w.t.replace(/&ndash;/g,''-'')+'': ''+fmt(o.x)+'' ''+P.xu+'', ''+fmt(o.y)+'' ''+P.yu},s);});');
    DBMS_OUTPUT.PUT_LINE('  if(cw){');
    DBMS_OUTPUT.PUT_LINE('    var cx=X(cw.x),cy=Y(cw.y),e=P.e;');
    DBMS_OUTPUT.PUT_LINE('    if(e!=null&&e>0){var ey=Y(e);if(Math.abs(ey-cy)>14){el(''line'',{x1:cx,x2:cx,y1:ey,y2:cy+(cy<ey?9:-9),''class'':''lr-cl''},s);');
    DBMS_OUTPUT.PUT_LINE('      el(''circle'',{cx:cx,cy:ey,r:3,''class'':''lr-ce''},s);}}');
    DBMS_OUTPUT.PUT_LINE('    el(''circle'',{cx:cx,cy:cy,r:7,''class'':''lr-cur'',''data-w'':0,''data-k'':''w0'',tabindex:0,');
    DBMS_OUTPUT.PUT_LINE('      ''aria-label'':''Current window: ''+fmt(cw.x)+'' ''+P.xu+'', ''+fmt(cw.y)+'' ''+P.yu},s);');
    DBMS_OUTPUT.PUT_LINE('    var right=cx<L+(W-L-R)*0.62,lx=cx+(right?13:-13),an=right?''start'':''end'',ly=Math.max(T+12,Math.min(H-B-24,cy+4));');
    DBMS_OUTPUT.PUT_LINE('    tx(s,lx,ly,narrow?''Current ''+fmt(cw.y)+'' ms'':''Current: ''+fmt(cw.y)+'' ''+P.yu,''lr-cll'',an);');
    DBMS_OUTPUT.PUT_LINE('    if(e!=null&&e>0)tx(s,lx,ly+15,(cw.y/e).toFixed(1)+''\u00d7 ''+(narrow?''the curve'':''the dashed curve (''+fmt(e)+'' ms) at this load''),''lr-cls'',an);');
    DBMS_OUTPUT.PUT_LINE('  }');
    DBMS_OUTPUT.PUT_LINE('  var rt=sec.querySelector(''.lr-rt'');if(rt&&P.r&&rt.getAttribute(''data-p'')!==String(p)){rt.innerHTML=P.r;rt.setAttribute(''data-p'',p);mkFill(rt);}');
    DBMS_OUTPUT.PUT_LINE('  /* hover + focus */');
    DBMS_OUTPUT.PUT_LINE('  s.addEventListener(''mousemove'',function(ev){var t=ev.target,h=hint(t,P,bx,by,bi,ws);if(h)tipOn(h,ev.clientX,ev.clientY);else tipOff();});');
    DBMS_OUTPUT.PUT_LINE('  s.addEventListener(''mouseleave'',tipOff);');
    DBMS_OUTPUT.PUT_LINE('  s.addEventListener(''focusin'',function(ev){var h=hint(ev.target,P,bx,by,bi,ws);if(h){var r=ev.target.getBoundingClientRect();tipOn(h,r.right,r.top);}});');
    DBMS_OUTPUT.PUT_LINE('  s.addEventListener(''focusout'',tipOff);');
    DBMS_OUTPUT.PUT_LINE('  s.addEventListener(''click'',function(ev){go(ev.target);});');
    DBMS_OUTPUT.PUT_LINE('  s.addEventListener(''keydown'',function(ev){if(ev.key===''Enter''||ev.key==='' ''){if(go(ev.target))ev.preventDefault();}});');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('/* the release slot of the sentence (js_wingrid fills the first copy) */');
    DBMS_OUTPUT.PUT_LINE('function mkFill(r){var W=window.AWR_WG;if(!W||!W.markerAt)return;');
    DBMS_OUTPUT.PUT_LINE('  [].forEach.call(r.querySelectorAll(''[data-mk-at]''),function(e){var m=W.markerAt(+e.getAttribute(''data-mk-at''));if(!m)return;');
    DBMS_OUTPUT.PUT_LINE('    e.textContent=(e.getAttribute(''data-mk-pre'')||'''')+m.l+'' (''+m.t+'')'';e.title=m.l+'', ''+m.t;e.hidden=false;});}');
    DBMS_OUTPUT.PUT_LINE('function go(t){var k=t&&t.getAttribute&&t.getAttribute(''data-k'');if(!k)return false;');
    DBMS_OUTPUT.PUT_LINE('  var r=doc.getElementById(''lr-''+k);if(r&&window.AWR_goTo){window.AWR_goTo(r,true,false);return true;}return false;}');
    DBMS_OUTPUT.PUT_LINE('function hint(t,P,bx,by,bi,ws){');
    DBMS_OUTPUT.PUT_LINE('  if(!t||!t.getAttribute)return '''';');
    DBMS_OUTPUT.PUT_LINE('  var b=t.getAttribute(''data-b'');');
    DBMS_OUTPUT.PUT_LINE('  if(b!=null){b=+b;return ''<b>''+tAt(D.bt[bi[b]])+''</b><br><span class="tm">snapshot interval''+(D.bc[bi[b]]===1?'', in the Current window'':'''')+''</span><br>''');
    DBMS_OUTPUT.PUT_LINE('    +fmt(bx[b])+'' ''+esc(P.xu)+''<br>''+fmt(by[b])+'' ''+esc(P.yu);}');
    DBMS_OUTPUT.PUT_LINE('  var k=t.getAttribute(''data-k'');if(!k)return '''';');
    DBMS_OUTPUT.PUT_LINE('  var o=+k.slice(1),w=null;ws.forEach(function(x){if(x.w.o===o)w=x;});if(!w)return '''';');
    DBMS_OUTPUT.PUT_LINE('  return ''<b>''+w.w.t+''</b><br><span class="tm">''+(o===0?''Current window'':esc(w.w.l)+'' window'')+'', window average</span><br>''');
    DBMS_OUTPUT.PUT_LINE('    +fmt(w.x)+'' ''+esc(P.xu)+''<br>''+fmt(w.y)+'' ''+esc(P.yu)+(o===0&&P.e!=null?''<br><span class="tm">the dashed curve at that load: ''+fmt(P.e)+''</span>'':'''');');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('function setPair(xi,yi){');
    DBMS_OUTPUT.PUT_LINE('  if(xi!=null)cur.x=xi;if(yi!=null)cur.y=yi;');
    DBMS_OUTPUT.PUT_LINE('  if(!D.p[pid()].n){/* fall back to the response kind that has data */cur.y=1-cur.y;}');
    DBMS_OUTPUT.PUT_LINE('  [].forEach.call(sec.querySelectorAll(''.lr-seg button''),function(b){');
    DBMS_OUTPUT.PUT_LINE('    var on=b.hasAttribute(''data-x'')?+b.getAttribute(''data-x'')===cur.x:+b.getAttribute(''data-y'')===cur.y;');
    DBMS_OUTPUT.PUT_LINE('    b.setAttribute(''aria-pressed'',on?''true'':''false'');');
    DBMS_OUTPUT.PUT_LINE('    if(b.hasAttribute(''data-y''))b.disabled=!D.p[cur.x+3*(+b.getAttribute(''data-y''))].n;});');
    DBMS_OUTPUT.PUT_LINE('  draw();');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('function boot(){');
    DBMS_OUTPUT.PUT_LINE('  D=(window.AWR_DATA||{}).loadresp||null;sec=doc.getElementById(''load-response'');');
    DBMS_OUTPUT.PUT_LINE('  if(!D||!sec)return;');
    DBMS_OUTPUT.PUT_LINE('  plot=sec.querySelector(''.lr-plot'');if(!plot)return;');
    DBMS_OUTPUT.PUT_LINE('  var m=/^(\d+)-(\d+)-(\d+) (\d+):(\d+)/.exec(D.t0||'''');T0=m?Date.UTC(+m[1],+m[2]-1,+m[3],+m[4],+m[5]):0;');
    DBMS_OUTPUT.PUT_LINE('  tip=doc.getElementById(''tip'');if(!tip){tip=doc.createElement(''div'');tip.id=''tip'';tip.setAttribute(''role'',''tooltip'');tip.hidden=true;doc.body.appendChild(tip);}');
    DBMS_OUTPUT.PUT_LINE('  cur.x=D.def%3;cur.y=Math.floor(D.def/3);');
    DBMS_OUTPUT.PUT_LINE('  sec.classList.add(''lr-js'');');
    DBMS_OUTPUT.PUT_LINE('  sec.querySelector(''.lr-chart'').addEventListener(''click'',function(ev){');
    DBMS_OUTPUT.PUT_LINE('    var b=ev.target.closest&&ev.target.closest(''.lr-seg button'');if(!b||b.disabled)return;');
    DBMS_OUTPUT.PUT_LINE('    if(b.hasAttribute(''data-x''))setPair(+b.getAttribute(''data-x''),null);else setPair(null,+b.getAttribute(''data-y''));});');
    DBMS_OUTPUT.PUT_LINE('  setPair(null,null);');
    DBMS_OUTPUT.PUT_LINE('  if(window.ResizeObserver)new ResizeObserver(function(){if(plot.clientWidth!==lastW)draw();}).observe(plot);');
    DBMS_OUTPUT.PUT_LINE('  doc.addEventListener(''awr:view'',function(){setTimeout(draw,30);});');
    DBMS_OUTPUT.PUT_LINE('  window.addEventListener(''resize'',function(){if(plot.clientWidth!==lastW)draw();});');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('if(doc.readyState===''loading'')doc.addEventListener(''DOMContentLoaded'',boot);else boot();');
    DBMS_OUTPUT.PUT_LINE('})();');
    DBMS_OUTPUT.PUT_LINE('</script>');
END;
/
