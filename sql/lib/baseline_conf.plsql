--
-- sql/lib/baseline_conf.plsql
--
-- Plan 039: how much to trust a finding scored against n prior windows.
-- DISPLAY ONLY: nothing here scores, flags or counts anything.
--
-- The rule (policy_bucket in sql/lib/metric_policy.plsql): z = (Current -
-- mean) / max(sd, 2 % of |mean|) over the n valid prior windows, mean and
-- SAMPLE sd from the same n values.  For a metric that did not change and is
-- normally distributed, z / sqrt(1 + 1/n) follows Student's t with n - 1
-- degrees of freedom, so the nominal chance that it lands outside +/-2
-- sigma (moderate) or +/-3 sigma (large) is far above the 4.6 % / 0.3 %
-- people assume when n is small.  Two-sided, per metric, BEFORE the size
-- floors and the direction rule (a rise-only metric is about half).
--
--   conf_mod(n)    percent of unchanged metrics with |z| > 2
--   conf_large(n)  percent of unchanged metrics with |z| > 3
--   n = 3 .. 60; fewer than 3 gives NULL; more than 60 uses the n = 60 row
--   (5.2 % / 0.4 %, the normal limit is 4.6 % / 0.3 %).
--
-- The WHEN rows below are GENERATED by tools/gen_baseline_conf.py (--emit);
-- tools/gen_baseline_conf.py --check compares them with the t distribution
-- (tools/check.sh).  Each WHEN row stays on one line:
-- demo/awrdemo/helpers.py parses them (CONF_MOD / CONF_LARGE).
--
-- Include inside a DECLARE block after the plain variables (it declares
-- functions only, no TYPE; no other include is needed first).  Reads no
-- DEFINE.  No tilde-words in comments below.
-- Twin: demo/awrdemo/helpers.py (conf_mod, conf_large, conf_pct_txt,
-- conf_every, conf_title, conf_verdict).
--

    FUNCTION conf_mod(p_n NUMBER) RETURN NUMBER IS
        v_n PLS_INTEGER;
    BEGIN
        IF p_n IS NULL OR p_n < 3 THEN
            RETURN NULL;
        END IF;
        v_n := LEAST(TRUNC(p_n), 60);
        CASE v_n
            WHEN 3 THEN RETURN 22.54;
            WHEN 4 THEN RETURN 17.16;
            WHEN 5 THEN RETURN 14.19;
            WHEN 6 THEN RETURN 12.33;
            WHEN 7 THEN RETURN 11.06;
            WHEN 8 THEN RETURN 10.13;
            WHEN 9 THEN RETURN 9.43;
            WHEN 10 THEN RETURN 8.89;
            WHEN 11 THEN RETURN 8.45;
            WHEN 12 THEN RETURN 8.09;
            WHEN 13 THEN RETURN 7.80;
            WHEN 14 THEN RETURN 7.54;
            WHEN 15 THEN RETURN 7.33;
            WHEN 16 THEN RETURN 7.14;
            WHEN 17 THEN RETURN 6.97;
            WHEN 18 THEN RETURN 6.83;
            WHEN 19 THEN RETURN 6.70;
            WHEN 20 THEN RETURN 6.59;
            WHEN 21 THEN RETURN 6.48;
            WHEN 22 THEN RETURN 6.39;
            WHEN 23 THEN RETURN 6.30;
            WHEN 24 THEN RETURN 6.23;
            WHEN 25 THEN RETURN 6.16;
            WHEN 26 THEN RETURN 6.09;
            WHEN 27 THEN RETURN 6.03;
            WHEN 28 THEN RETURN 5.98;
            WHEN 29 THEN RETURN 5.92;
            WHEN 30 THEN RETURN 5.88;
            WHEN 31 THEN RETURN 5.83;
            WHEN 32 THEN RETURN 5.79;
            WHEN 33 THEN RETURN 5.75;
            WHEN 34 THEN RETURN 5.71;
            WHEN 35 THEN RETURN 5.68;
            WHEN 36 THEN RETURN 5.65;
            WHEN 37 THEN RETURN 5.62;
            WHEN 38 THEN RETURN 5.59;
            WHEN 39 THEN RETURN 5.56;
            WHEN 40 THEN RETURN 5.53;
            WHEN 41 THEN RETURN 5.51;
            WHEN 42 THEN RETURN 5.48;
            WHEN 43 THEN RETURN 5.46;
            WHEN 44 THEN RETURN 5.44;
            WHEN 45 THEN RETURN 5.42;
            WHEN 46 THEN RETURN 5.40;
            WHEN 47 THEN RETURN 5.38;
            WHEN 48 THEN RETURN 5.36;
            WHEN 49 THEN RETURN 5.35;
            WHEN 50 THEN RETURN 5.33;
            WHEN 51 THEN RETURN 5.31;
            WHEN 52 THEN RETURN 5.30;
            WHEN 53 THEN RETURN 5.28;
            WHEN 54 THEN RETURN 5.27;
            WHEN 55 THEN RETURN 5.26;
            WHEN 56 THEN RETURN 5.24;
            WHEN 57 THEN RETURN 5.23;
            WHEN 58 THEN RETURN 5.22;
            WHEN 59 THEN RETURN 5.21;
            WHEN 60 THEN RETURN 5.20;
            ELSE RETURN NULL;
        END CASE;
        RETURN NULL;
    END conf_mod;

    FUNCTION conf_large(p_n NUMBER) RETURN NUMBER IS
        v_n PLS_INTEGER;
    BEGIN
        IF p_n IS NULL OR p_n < 3 THEN
            RETURN NULL;
        END IF;
        v_n := LEAST(TRUNC(p_n), 60);
        CASE v_n
            WHEN 3 THEN RETURN 12.17;
            WHEN 4 THEN RETURN 7.48;
            WHEN 5 THEN RETURN 5.20;
            WHEN 6 THEN RETURN 3.90;
            WHEN 7 THEN RETURN 3.09;
            WHEN 8 THEN RETURN 2.55;
            WHEN 9 THEN RETURN 2.16;
            WHEN 10 THEN RETURN 1.88;
            WHEN 11 THEN RETURN 1.66;
            WHEN 12 THEN RETURN 1.49;
            WHEN 13 THEN RETURN 1.36;
            WHEN 14 THEN RETURN 1.24;
            WHEN 15 THEN RETURN 1.15;
            WHEN 16 THEN RETURN 1.08;
            WHEN 17 THEN RETURN 1.01;
            WHEN 18 THEN RETURN 0.95;
            WHEN 19 THEN RETURN 0.91;
            WHEN 20 THEN RETURN 0.86;
            WHEN 21 THEN RETURN 0.83;
            WHEN 22 THEN RETURN 0.79;
            WHEN 23 THEN RETURN 0.76;
            WHEN 24 THEN RETURN 0.74;
            WHEN 25 THEN RETURN 0.71;
            WHEN 26 THEN RETURN 0.69;
            WHEN 27 THEN RETURN 0.67;
            WHEN 28 THEN RETURN 0.65;
            WHEN 29 THEN RETURN 0.64;
            WHEN 30 THEN RETURN 0.62;
            WHEN 31 THEN RETURN 0.61;
            WHEN 32 THEN RETURN 0.59;
            WHEN 33 THEN RETURN 0.58;
            WHEN 34 THEN RETURN 0.57;
            WHEN 35 THEN RETURN 0.56;
            WHEN 36 THEN RETURN 0.55;
            WHEN 37 THEN RETURN 0.54;
            WHEN 38 THEN RETURN 0.53;
            WHEN 39 THEN RETURN 0.52;
            WHEN 40 THEN RETURN 0.52;
            WHEN 41 THEN RETURN 0.51;
            WHEN 42 THEN RETURN 0.50;
            WHEN 43 THEN RETURN 0.50;
            WHEN 44 THEN RETURN 0.49;
            WHEN 45 THEN RETURN 0.48;
            WHEN 46 THEN RETURN 0.48;
            WHEN 47 THEN RETURN 0.47;
            WHEN 48 THEN RETURN 0.47;
            WHEN 49 THEN RETURN 0.46;
            WHEN 50 THEN RETURN 0.46;
            WHEN 51 THEN RETURN 0.46;
            WHEN 52 THEN RETURN 0.45;
            WHEN 53 THEN RETURN 0.45;
            WHEN 54 THEN RETURN 0.44;
            WHEN 55 THEN RETURN 0.44;
            WHEN 56 THEN RETURN 0.44;
            WHEN 57 THEN RETURN 0.43;
            WHEN 58 THEN RETURN 0.43;
            WHEN 59 THEN RETURN 0.43;
            WHEN 60 THEN RETURN 0.42;
            ELSE RETURN NULL;
        END CASE;
        RETURN NULL;
    END conf_large;

    -- a percentage as text: 17 / 7.5 / 0.46 (whole percent from 10, one
    -- decimal from 1, two below)
    FUNCTION conf_pct_txt(p_pct NUMBER) RETURN VARCHAR2 IS
    BEGIN
        IF p_pct IS NULL THEN
            RETURN NULL;
        ELSIF p_pct >= 10 THEN
            RETURN TO_CHAR(ROUND(p_pct), 'FM990');
        ELSIF p_pct >= 1 THEN
            RETURN TO_CHAR(ROUND(p_pct, 1), 'FM990.0', 'NLS_NUMERIC_CHARACTERS=''.,''');
        END IF;
        RETURN TO_CHAR(ROUND(p_pct, 2), 'FM990.00', 'NLS_NUMERIC_CHARACTERS=''.,''');
    END conf_pct_txt;

    -- "1 in 6" for a percentage (the quotient rounded ONCE: to a whole number, from 100 on to ten)
    FUNCTION conf_every(p_pct NUMBER) RETURN VARCHAR2 IS
        v_k NUMBER;
    BEGIN
        IF p_pct IS NULL OR p_pct <= 0 THEN
            RETURN NULL;
        END IF;
        v_k := 100 / p_pct;
        IF v_k >= 100 THEN
            v_k := ROUND(v_k, -1);
        ELSE
            v_k := ROUND(v_k);
        END IF;
        RETURN '1 in ' || TO_CHAR(v_k, 'FM999990');
    END conf_every;

    -- the title text of a card's "n = 4" qualifier (plain ASCII, no quotes)
    FUNCTION conf_title(p_n NUMBER) RETURN VARCHAR2 IS
    BEGIN
        IF conf_mod(p_n) IS NULL THEN
            RETURN NULL;
        END IF;
        RETURN 'Scored against ' || TO_CHAR(TRUNC(p_n)) || ' prior windows. A metric that did not change'
            || ' still lands outside +/-2 sigma about ' || conf_pct_txt(conf_mod(p_n)) || '% of the time ('
            || conf_every(conf_mod(p_n)) || ') and outside +/-3 sigma about '
            || conf_pct_txt(conf_large(p_n)) || '% (' || conf_every(conf_large(p_n))
            || '), before the size floors.'
            || CASE WHEN p_n > 60 THEN ' (Rates shown for 60 windows.)' END;
    END conf_title;

    -- the verdict's note for a thin baseline: 3 to 5 valid prior windows;
    -- NULL otherwise.  One li (class hn-conf) for ul#narrative-slot.
    FUNCTION conf_verdict(p_n NUMBER) RETURN VARCHAR2 IS
    BEGIN
        IF p_n IS NULL OR p_n < 3 OR p_n > 5 THEN
            RETURN NULL;
        END IF;
        RETURN '<li class="hn-conf" data-n="' || TO_CHAR(TRUNC(p_n)) || '"><span class="hw">'
            || '<b class="hl">Thin baseline:</b> ' || TO_CHAR(TRUNC(p_n)) || ' prior windows. With so few, a'
            || ' metric that did not really change still lands outside &plusmn;2&sigma; about 1 time in '
            || TO_CHAR(ROUND(100 / conf_mod(p_n))) || ' and outside &plusmn;3&sigma; about 1 in '
            || TO_CHAR(ROUND(100 / conf_large(p_n))) || ' (before the size floors). Read a lone moderate'
            || ' finding as a hint; more windows (weeks_back) tighten this. '
            || '<a class="go" href="#about">How scoring works&nbsp;&rarr;</a></span></li>';
    END conf_verdict;
