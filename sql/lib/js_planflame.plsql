--
-- sql/lib/js_planflame.plsql
--
-- The client script of section 23_plan_flame (Plan shape, old vs new).
-- @@-included by sql/23_plan_flame.sql, after its markup and payload.
--
-- No literal tilde below (SET DEFINE tilde).  GENERATED: the body below
-- (BEGIN .. END) is written by tools/js2plsql.sh from the readable source
-- sql/lib/src/js_planflame.js -- edit that file and regenerate.
--
BEGIN
    DBMS_OUTPUT.PUT_LINE('<script>');
    DBMS_OUTPUT.PUT_LINE('// js_planflame: client half of section 23_plan_flame (Plan shape, old vs new).');
    DBMS_OUTPUT.PUT_LINE('// Reads window.AWR_DATA.planflame = {spw, min, mode, st:[{id, sql, p:[plan]}]},');
    DBMS_OUTPUT.PUT_LINE('// plan = {r: "old"|"new"|"cur", phv, div, n, nol, lines, state, s:[step]},');
    DBMS_OUTPUT.PUT_LINE('// step = [id, parent_id, operation, options, owner, object, self samples,');
    DBMS_OUTPUT.PUT_LINE('//         {class: samples on the step}, hidden steps without samples].');
    DBMS_OUTPUT.PUT_LINE('// Draws one icicle per plan into div.pf-plot[data-q] of div.pf-st#<id>: root');
    DBMS_OUTPUT.PUT_LINE('// on top, width = inclusive samples per window (both plans of a statement');
    DBMS_OUTPUT.PUT_LINE('// on ONE scale), the step''s own samples on the right end of its bar,');
    DBMS_OUTPUT.PUT_LINE('// split by activity class; a step without samples is a thin sliver.');
    DBMS_OUTPUT.PUT_LINE('(function(){');
    DBMS_OUTPUT.PUT_LINE('''use strict'';');
    DBMS_OUTPUT.PUT_LINE('var doc=document,NS=''http://www.w3.org/2000/svg'',D=null,TIP=null;');
    DBMS_OUTPUT.PUT_LINE('var MID=String.fromCharCode(183),ELL=String.fromCharCode(8230),DASH=String.fromCharCode(8211);');
    DBMS_OUTPUT.PUT_LINE('var ORD=[''CPU'',''User I/O'',''System I/O'',''Commit'',''Application'',''Concurrency'',''Network'',''Configuration'',''Scheduler'',''Cluster'',''Administrative'',''Queueing'',''Other''];');
    DBMS_OUTPUT.PUT_LINE('var RH=22,CAP=14,MAXR=18;');
    DBMS_OUTPUT.PUT_LINE('function col(c){var m=window.AWR_WAIT_COLORS||{};return m[c]||''#9AA3AD'';}');
    DBMS_OUTPUT.PUT_LINE('function el(n,a,p){var e=doc.createElementNS(NS,n);for(var k in a)if(a.hasOwnProperty(k))e.setAttribute(k,a[k]);if(p)p.appendChild(e);return e;}');
    DBMS_OUTPUT.PUT_LINE('function esc(s){return String(s==null?'''':s).replace(/[&<>"]/g,function(c){return c===''&''?''&amp;'':c===''<''?''&lt;'':c===''>''?''&gt;'':''&quot;'';});}');
    DBMS_OUTPUT.PUT_LINE('function fs(v){return v>=100?String(Math.round(v)):v>=10?v.toFixed(1):v>=1?v.toFixed(1):v>0?v.toFixed(2):''0'';}');
    DBMS_OUTPUT.PUT_LINE('function pc(a,b){return b>0?Math.round(100*a/b)+''%'':''0%'';}');
    DBMS_OUTPUT.PUT_LINE('function stepTxt(n){return [n.op,n.opt,n.obj].filter(function(x){return x;}).join('' '');}');
    DBMS_OUTPUT.PUT_LINE('/* ---- the tree of one plan */');
    DBMS_OUTPUT.PUT_LINE('function build(P){');
    DBMS_OUTPUT.PUT_LINE('  var by={},root=null;');
    DBMS_OUTPUT.PUT_LINE('  P.s.forEach(function(a){by[a[0]]={id:a[0],pid:a[1],op:a[2],opt:a[3],own:a[4],obj:a[5],s:a[6],c:a[7]||{},hid:a[8]||0,ch:[]};});');
    DBMS_OUTPUT.PUT_LINE('  P.s.forEach(function(a){var n=by[a[0]],p=n.pid!=null?by[n.pid]:null;if(p&&p!==n)p.ch.push(n);else if(n.id===0||!root)root=n;});');
    DBMS_OUTPUT.PUT_LINE('  if(!root)return null;');
    DBMS_OUTPUT.PUT_LINE('  (function tot(n){var t=n.s;n.ch.forEach(function(c){t+=tot(c);});n.t=t;return t;})(root);');
    DBMS_OUTPUT.PUT_LINE('  return root;');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('/* display tree: chains of steps without samples of their own and one busy');
    DBMS_OUTPUT.PUT_LINE('   child fold into one bar (only when the plan is deeper than CAP rows);');
    DBMS_OUTPUT.PUT_LINE('   children without samples become slivers */');
    DBMS_OUTPUT.PUT_LINE('function rowsOf(n){if(!n.t)return 1;var m=0;n.ch.forEach(function(c){m=Math.max(m,rowsOf(c));});return 1+m;}');
    DBMS_OUTPUT.PUT_LINE('function disp(n,fold){');
    DBMS_OUTPUT.PUT_LINE('  var chain=[n],cur=n,lost=0;');
    DBMS_OUTPUT.PUT_LINE('  if(fold){while(cur.s===0){var pos=cur.ch.filter(function(c){return c.t>0;});if(pos.length!==1)break;');
    DBMS_OUTPUT.PUT_LINE('    cur.ch.forEach(function(c){if(!c.t)lost+=1+c.hid;});lost+=cur.hid;cur=pos[0];chain.push(cur);}}');
    DBMS_OUTPUT.PUT_LINE('  var d={n:cur,chain:chain,lost:lost,t:n.t,kids:[]};');
    DBMS_OUTPUT.PUT_LINE('  cur.ch.forEach(function(c){if(c.t>0)d.kids.push(disp(c,fold));});');
    DBMS_OUTPUT.PUT_LINE('  cur.ch.forEach(function(c){if(!c.t)d.kids.push({sl:1,n:c,t:0,hid:c.hid,kids:[]});});');
    DBMS_OUTPUT.PUT_LINE('  if(cur.hid>0)d.kids.push({sl:1,n:null,t:0,hid:cur.hid,kids:[]});');
    DBMS_OUTPUT.PUT_LINE('  return d;');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('function depth(d){var m=0;d.kids.forEach(function(k){m=Math.max(m,depth(k));});return 1+m;}');
    DBMS_OUTPUT.PUT_LINE('function slivers(d,row){var c=d.sl?1:0;if(!d.sl&&row<MAXR-1)d.kids.forEach(function(k){c+=slivers(k,row+1);});d.nsl=c;return c;}');
    DBMS_OUTPUT.PUT_LINE('/* ---- tooltip (own element; js_timeline''s #tip is driven by its grid) */');
    DBMS_OUTPUT.PUT_LINE('function tipOn(html,x,y){if(!TIP)return;TIP.innerHTML=html;TIP.hidden=false;');
    DBMS_OUTPUT.PUT_LINE('  var w=TIP.offsetWidth,h=TIP.offsetHeight,a=x+14,b=y+16;');
    DBMS_OUTPUT.PUT_LINE('  if(a+w>innerWidth-8)a=x-w-12;if(b+h>innerHeight-8)b=y-h-12;');
    DBMS_OUTPUT.PUT_LINE('  TIP.style.left=Math.max(8,a)+''px'';TIP.style.top=Math.max(8,b)+''px'';}');
    DBMS_OUTPUT.PUT_LINE('function tipOff(){if(TIP)TIP.hidden=true;}');
    DBMS_OUTPUT.PUT_LINE('function tipHtml(d,P,tot){');
    DBMS_OUTPUT.PUT_LINE('  var div=P.div||1,spw=D.spw||10,sec=function(n){return n*spw/div;},h;');
    DBMS_OUTPUT.PUT_LINE('  if(d.sl){');
    DBMS_OUTPUT.PUT_LINE('    if(!d.n)return ''<b>''+d.hid+'' step''+(d.hid!==1?''s'':'''')+'' without samples</b><br><span class="tm">folded; the plan table lists the steps with samples</span>'';');
    DBMS_OUTPUT.PUT_LINE('    return ''<b>''+esc(stepTxt(d.n))+''</b><br><span class="tm">line ''+d.n.id+'', no ASH samples''+(d.hid?'' (with ''+d.hid+'' step''+(d.hid!==1?''s'':'''')+'' below)'':'''')+''</span>'';');
    DBMS_OUTPUT.PUT_LINE('  }');
    DBMS_OUTPUT.PUT_LINE('  var n=d.n,own=n.own&&n.obj?n.own+''.''+n.obj:'''';');
    DBMS_OUTPUT.PUT_LINE('  h=''<b>''+esc(stepTxt(n))+''</b><br><span class="tm">line ''+n.id+(own?'' ''+MID+'' ''+esc(own):'''')+''</span>'';');
    DBMS_OUTPUT.PUT_LINE('  h+=''<div class="tr2"><span>With the steps below</span><b>''+fs(sec(d.t))+'' s ''+MID+'' ''+pc(d.t,tot)+''</b></div>'';');
    DBMS_OUTPUT.PUT_LINE('  h+=''<div class="tr2"><span>On the step itself</span><b>''+fs(sec(n.s))+'' s</b></div>'';');
    DBMS_OUTPUT.PUT_LINE('  ORD.forEach(function(c){var v=n.c[c];if(v)h+=''<div class="tr2"><span><i class="sw" style="--sw:''+col(c)+''"></i>''+esc(c)+''</span><b>''+fs(sec(v))+'' s ''+MID+'' ''+pc(v,n.s)+''</b></div>'';});');
    DBMS_OUTPUT.PUT_LINE('  if(n.id===0&&P.nol)h+=''<span class="tm">''+P.nol+'' sample''+(P.nol!==1?''s'':'''')+'' without a plan line counted here</span><br>'';');
    DBMS_OUTPUT.PUT_LINE('  if(d.chain.length>1){var up=d.chain.slice(0,-1),nm=function(c){return esc(stepTxt(c))+'' (''+c.id+'')'';};');
    DBMS_OUTPUT.PUT_LINE('    h+=''<span class="tm">Folded into this bar, no samples of their own: ''+(up.length<=3?up.map(nm).join('', ''):up.length+'' steps, ''+nm(up[0])+'' down to ''+nm(up[up.length-1]))+''</span><br>'';}');
    DBMS_OUTPUT.PUT_LINE('  if(d.lost)h+=''<span class="tm">''+d.lost+'' step''+(d.lost!==1?''s'':'''')+'' without samples folded</span><br>'';');
    DBMS_OUTPUT.PUT_LINE('  if(d.cut)h+=''<span class="tm">Deeper steps not drawn: see the plan table</span>'';');
    DBMS_OUTPUT.PUT_LINE('  return h+''<span class="tm">''+(P.r===''old''?''mean of ''+div+'' prior window''+(div!==1?''s'':''''):''Current window'')+'', ''+(n.s?n.s+'' sample''+(n.s!==1?''s'':'''')+'' on the step'':''no sample on the step'')+''</span>'';');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('/* ---- one icicle */');
    DBMS_OUTPUT.PUT_LINE('/* the first candidate label that fits the bar, measured on the real text');
    DBMS_OUTPUT.PUT_LINE('   (an estimate only when the text cannot be measured) */');
    DBMS_OUTPUT.PUT_LINE('function label(g,d,x,y,w,sx,onc,P){');
    DBMS_OUTPUT.PUT_LINE('  /* on a bar mostly coloured by its own samples the label is white on the');
    DBMS_OUTPUT.PUT_LINE('     colour; else it stays on the neutral part left of the colour */');
    DBMS_OUTPUT.PUT_LINE('  var lx=onc?Math.max(x,sx):x,room=onc?x+w-lx-10:sx-x-9;');
    DBMS_OUTPUT.PUT_LINE('  if(room<14)return;');
    DBMS_OUTPUT.PUT_LINE('  var n=d.n,full=stepTxt(n),sec=fs(d.t*(D.spw||10)/(P.div||1))+'' s'';');
    DBMS_OUTPUT.PUT_LINE('  var cand=[full+''  ''+sec,full,n.obj?n.op+'' ''+n.obj:null,n.obj||(n.op+(n.opt?'' ''+n.opt:'''')),n.op];');
    DBMS_OUTPUT.PUT_LINE('  var t=el(''text'',{''class'':''pf-lb''+(onc?'' onc'':''''),x:lx+5,y:y+RH/2+4},g),len=function(s){t.textContent=s;var v=0;try{v=t.getComputedTextLength();}catch(e){}return v>0?v:s.length*6.6;};');
    DBMS_OUTPUT.PUT_LINE('  for(var i=0;i<cand.length;i++){if(cand[i]&&len(cand[i])<=room)return;}');
    DBMS_OUTPUT.PUT_LINE('  var base=n.obj||n.op;');
    DBMS_OUTPUT.PUT_LINE('  for(var m=base.length-1;m>=3;m--){if(len(base.slice(0,m)+ELL)<=room)return;}');
    DBMS_OUTPUT.PUT_LINE('  g.removeChild(t);');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('function drawPlan(box,P,dt,k,SW,blk){');
    DBMS_OUTPUT.PUT_LINE('  box.textContent='''';');
    DBMS_OUTPUT.PUT_LINE('  var W=box.clientWidth,rows=Math.min(depth(dt),MAXR),H=rows*RH+30;');
    DBMS_OUTPUT.PUT_LINE('  var svg=el(''svg'',{width:W,height:H,viewBox:''0 0 ''+W+'' ''+H,''class'':''pf-svg'',role:''img''},box);');
    DBMS_OUTPUT.PUT_LINE('  var tot=dt.t,div=P.div||1;');
    DBMS_OUTPUT.PUT_LINE('  var hot=null;(function f(d){if(d.sl)return;if(!hot||d.n.s>hot.n.s)hot=d;d.kids.forEach(f);})(dt);');
    DBMS_OUTPUT.PUT_LINE('  svg.setAttribute(''aria-label'',''Icicle chart of plan ''+P.phv+'': ''+fs(tot*(D.spw||10)/div)+'' s of DB time per window''+(hot?''; most on ''+stepTxt(hot.n)+'', line ''+hot.n.id:''''));');
    DBMS_OUTPUT.PUT_LINE('  var nodes=[];');
    DBMS_OUTPUT.PUT_LINE('  function wOf(d){return d.t/div*k+(d.nsl||0)*SW;}');
    DBMS_OUTPUT.PUT_LINE('  function draw(d,x,y,row,par){');
    DBMS_OUTPUT.PUT_LINE('    var w=wOf(d),g=el(''g'',{''class'':d.sl?''pf-g pf-s'':''pf-g'',tabindex:''-1''},svg);');
    DBMS_OUTPUT.PUT_LINE('    g._pf={d:d,par:par,kids:[],x:x,y:y,w:w};if(par)par._pf.kids.push(g);nodes.push(g);');
    DBMS_OUTPUT.PUT_LINE('    if(d.sl){if(SW>0)el(''rect'',{x:x+0.5,y:y+1,width:Math.max(0.8,SW-1),height:RH-2,''class'':''pf-slr''},g);return g;}');
    DBMS_OUTPUT.PUT_LINE('    var n=d.n;if(n.obj)g.setAttribute(''data-o'',(n.own||'''')+''.''+n.obj);');
    DBMS_OUTPUT.PUT_LINE('    el(''rect'',{x:x+0.5,y:y+0.5,width:Math.max(1,w-1),height:RH-1,rx:2,''class'':''pf-bg''},g);');
    DBMS_OUTPUT.PUT_LINE('    var sw=n.s/div*k,sx=x+w-sw,cls=ORD.filter(function(c){return n.c[c];}).sort(function(a,b){return n.c[b]-n.c[a];}),cx=sx;');
    DBMS_OUTPUT.PUT_LINE('    var csum=0;cls.forEach(function(c){csum+=n.c[c];});');
    DBMS_OUTPUT.PUT_LINE('    cls.forEach(function(c){var cw2=sw*n.c[c]/(csum||1);if(cw2>0.15)el(''rect'',{x:cx+0.5,y:y+1,width:Math.max(0.6,cw2-(cw2>2?1:0)),height:RH-2,''class'':''pf-own'',style:''fill:''+col(c)},g);cx+=cw2;});');
    DBMS_OUTPUT.PUT_LINE('    if(row>=MAXR-1&&d.kids.some(function(q){return !q.sl;})){d.cut=1;el(''line'',{x1:x+1,x2:x+w-1,y1:y+RH-1,y2:y+RH-1,''class'':''pf-cut''},g);}');
    DBMS_OUTPUT.PUT_LINE('    label(g,d,x,y,w,sx,sx<=x+w*0.45,P);');
    DBMS_OUTPUT.PUT_LINE('    if(!d.cut&&row<MAXR-1){var kx=x;d.kids.forEach(function(q){draw(q,kx,y+RH,row+1,g);kx+=wOf(q);});}');
    DBMS_OUTPUT.PUT_LINE('    return g;');
    DBMS_OUTPUT.PUT_LINE('  }');
    DBMS_OUTPUT.PUT_LINE('  var root=draw(dt,0,0,0,null);');
    DBMS_OUTPUT.PUT_LINE('  /* scale bar */');
    DBMS_OUTPUT.PUT_LINE('  var tgt=W/4,nice=[1,2,5,10,20,30,60,120,300,600,1200,1800,3600],sv=nice[0],spw=D.spw||10;');
    DBMS_OUTPUT.PUT_LINE('  nice.forEach(function(v){if(v/spw*k<=tgt)sv=v;});');
    DBMS_OUTPUT.PUT_LINE('  var bl=sv/spw*k,by=rows*RH+14;');
    DBMS_OUTPUT.PUT_LINE('  if(bl>=8){el(''line'',{x1:0.5,x2:bl,y1:by,y2:by,''class'':''pf-ax''},svg);el(''line'',{x1:0.5,x2:0.5,y1:by-4,y2:by+4,''class'':''pf-ax''},svg);el(''line'',{x1:bl,x2:bl,y1:by-4,y2:by+4,''class'':''pf-ax''},svg);');
    DBMS_OUTPUT.PUT_LINE('    var t=el(''text'',{x:bl+6,y:by+4,''class'':''pf-axl''},svg);t.textContent=sv+'' s of DB time per window'';}');
    DBMS_OUTPUT.PUT_LINE('  /* interaction */');
    DBMS_OUTPUT.PUT_LINE('  root.setAttribute(''tabindex'',''0'');');
    DBMS_OUTPUT.PUT_LINE('  nodes.forEach(function(g){');
    DBMS_OUTPUT.PUT_LINE('    var d=g._pf.d;');
    DBMS_OUTPUT.PUT_LINE('    g.addEventListener(''mouseenter'',function(e){same(blk,g,true);tipOn(tipHtml(d,P,tot),e.clientX,e.clientY);});');
    DBMS_OUTPUT.PUT_LINE('    g.addEventListener(''mousemove'',function(e){if(TIP&&!TIP.hidden)tipOn(TIP.innerHTML,e.clientX,e.clientY);});');
    DBMS_OUTPUT.PUT_LINE('    g.addEventListener(''mouseleave'',function(){same(blk,g,false);tipOff();});');
    DBMS_OUTPUT.PUT_LINE('    g.addEventListener(''focus'',function(){same(blk,g,true);var r=g.getBoundingClientRect();tipOn(tipHtml(d,P,tot),r.left+Math.min(r.width,40),r.bottom);});');
    DBMS_OUTPUT.PUT_LINE('    g.addEventListener(''blur'',function(){same(blk,g,false);tipOff();});');
    DBMS_OUTPUT.PUT_LINE('    g.addEventListener(''click'',function(){open(blk,box,d);});');
    DBMS_OUTPUT.PUT_LINE('    g.addEventListener(''keydown'',function(e){var f=g._pf,to=null,sib=f.par?f.par._pf.kids:[g],i=sib.indexOf(g);');
    DBMS_OUTPUT.PUT_LINE('      if(e.key===''ArrowDown'')to=f.kids[0];else if(e.key===''ArrowUp'')to=f.par;');
    DBMS_OUTPUT.PUT_LINE('      else if(e.key===''ArrowRight'')to=sib[i+1];else if(e.key===''ArrowLeft'')to=sib[i-1];');
    DBMS_OUTPUT.PUT_LINE('      else if(e.key===''Enter''||e.key==='' ''){e.preventDefault();open(blk,box,d);return;}');
    DBMS_OUTPUT.PUT_LINE('      else if(e.key===''Escape''){tipOff();return;}');
    DBMS_OUTPUT.PUT_LINE('      if(to){e.preventDefault();g.setAttribute(''tabindex'',''-1'');to.setAttribute(''tabindex'',''0'');to.focus();}});');
    DBMS_OUTPUT.PUT_LINE('  });');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('/* the same object in both plans lights up */');
    DBMS_OUTPUT.PUT_LINE('function same(blk,g,on){var o=g.getAttribute(''data-o'');g.classList.toggle(''pf-hov'',on);if(!o)return;');
    DBMS_OUTPUT.PUT_LINE('  blk.querySelectorAll(''.pf-g[data-o]'').forEach(function(x){if(x.getAttribute(''data-o'')===o)x.classList.toggle(''pf-same'',on);});}');
    DBMS_OUTPUT.PUT_LINE('/* click / Enter: the step''s row in the plan table */');
    DBMS_OUTPUT.PUT_LINE('function open(blk,box,d){');
    DBMS_OUTPUT.PUT_LINE('  if(d.sl&&!d.n)return;var q=box.getAttribute(''data-q''),tb=blk.querySelector(''table.pf-tb[data-pl="''+q+''"]'');if(!tb)return;');
    DBMS_OUTPUT.PUT_LINE('  var tr=tb.querySelector(''tr[data-ln="''+d.n.id+''"]'');if(!tr)return;');
    DBMS_OUTPUT.PUT_LINE('  var det=tb.closest(''details'');if(det)det.open=true;');
    DBMS_OUTPUT.PUT_LINE('  if(window.AWR_goTo)window.AWR_goTo(tr,true,false);else tr.scrollIntoView({block:''center''});');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('/* ---- one statement: both plans on one scale */');
    DBMS_OUTPUT.PUT_LINE('function drawBlock(B){');
    DBMS_OUTPUT.PUT_LINE('  var ok=B.plots.filter(function(x){return x.box.clientWidth>0;});');
    DBMS_OUTPUT.PUT_LINE('  if(!ok.length)return;');
    DBMS_OUTPUT.PUT_LINE('  var key=ok.map(function(x){return x.box.clientWidth;}).join('','');');
    DBMS_OUTPUT.PUT_LINE('  if(key===B.key)return;B.key=key;');
    DBMS_OUTPUT.PUT_LINE('  var SW=4;');
    DBMS_OUTPUT.PUT_LINE('  ok.forEach(function(x){var s=x.nsl;if(s*SW>0.3*x.box.clientWidth)SW=Math.min(SW,0.3*x.box.clientWidth/s);});');
    DBMS_OUTPUT.PUT_LINE('  if(SW<1)SW=0;');
    DBMS_OUTPUT.PUT_LINE('  var k=Infinity;');
    DBMS_OUTPUT.PUT_LINE('  ok.forEach(function(x){var T=x.dt.t/(x.P.div||1);if(T>0)k=Math.min(k,(x.box.clientWidth-x.nsl*SW-1)/T);});');
    DBMS_OUTPUT.PUT_LINE('  if(!isFinite(k)||k<=0)return;');
    DBMS_OUTPUT.PUT_LINE('  ok.forEach(function(x){drawPlan(x.box,x.P,x.dt,k,SW,B.el);});');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('function drawAll(force){if(!D)return;BL.forEach(function(B){if(force)B.key=null;drawBlock(B);});}');
    DBMS_OUTPUT.PUT_LINE('var BL=[];');
    DBMS_OUTPUT.PUT_LINE('function legend(){');
    DBMS_OUTPUT.PUT_LINE('  var lg=doc.querySelector(''#plan-flame .pf-lg'');if(!lg)return;var seen={},h='''';');
    DBMS_OUTPUT.PUT_LINE('  D.st.forEach(function(s){s.p.forEach(function(P){P.s.forEach(function(a){for(var c in a[7])if(a[7].hasOwnProperty(c))seen[c]=1;});});});');
    DBMS_OUTPUT.PUT_LINE('  ORD.forEach(function(c){if(seen[c])h+=''<span><i class="pf-sw" style="background:''+col(c)+''"></i>''+esc(c)+'' on the step itself</span>'';});');
    DBMS_OUTPUT.PUT_LINE('  h+=''<span><i class="pf-sw pf-swn"></i>time in the steps below</span><span><i class="pf-sw pf-sws"></i>step without samples</span>'';');
    DBMS_OUTPUT.PUT_LINE('  h+=''<span class="pf-lgh">Hover or focus a step (arrow keys move, Enter opens its table row); the same object lights up in the other plan.</span>'';');
    DBMS_OUTPUT.PUT_LINE('  lg.innerHTML=h;');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('/* the plan-change card of section 18 gets a "Plan shape" link */');
    DBMS_OUTPUT.PUT_LINE('function cardLinks(){');
    DBMS_OUTPUT.PUT_LINE('  D.st.forEach(function(s){');
    DBMS_OUTPUT.PUT_LINE('    var c=doc.getElementById(''f-plan-''+s.sql);if(!c||c.querySelector(''a.pf-cl''))return;');
    DBMS_OUTPUT.PUT_LINE('    var f=c.querySelector(''.fc-f'');if(!f)return;var e=f.querySelector(''.evl'')||f;');
    DBMS_OUTPUT.PUT_LINE('    var a=doc.createElement(''a'');a.className=''pf-cl'';a.href=''#''+s.id;a.textContent=''Plan shape'';');
    DBMS_OUTPUT.PUT_LINE('    e.insertBefore(a,e.firstChild);');
    DBMS_OUTPUT.PUT_LINE('  });');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('doc.addEventListener(''DOMContentLoaded'',function(){');
    DBMS_OUTPUT.PUT_LINE('  D=(window.AWR_DATA||{}).planflame||null;if(!D||!D.st)return;');
    DBMS_OUTPUT.PUT_LINE('  var sec=doc.getElementById(''plan-flame'');if(!sec)return;');
    DBMS_OUTPUT.PUT_LINE('  sec.classList.add(''pf-js'');');
    DBMS_OUTPUT.PUT_LINE('  TIP=doc.createElement(''div'');TIP.className=''planflame-tip'';TIP.setAttribute(''role'',''tooltip'');TIP.hidden=true;doc.body.appendChild(TIP);');
    DBMS_OUTPUT.PUT_LINE('  legend();');
    DBMS_OUTPUT.PUT_LINE('  D.st.forEach(function(s){');
    DBMS_OUTPUT.PUT_LINE('    var blk=doc.getElementById(s.id);if(!blk)return;var B={el:blk,plots:[],key:null};');
    DBMS_OUTPUT.PUT_LINE('    blk.querySelectorAll(''.pf-plot[data-q]'').forEach(function(box){');
    DBMS_OUTPUT.PUT_LINE('      var P=s.p[+box.getAttribute(''data-q'')];if(!P||P.state!==''Y'')return;');
    DBMS_OUTPUT.PUT_LINE('      var root=build(P);if(!root||!root.t)return;');
    DBMS_OUTPUT.PUT_LINE('      var dt=disp(root,rowsOf(root)>CAP);');
    DBMS_OUTPUT.PUT_LINE('      B.plots.push({box:box,P:P,dt:dt,nsl:slivers(dt,0)});');
    DBMS_OUTPUT.PUT_LINE('    });');
    DBMS_OUTPUT.PUT_LINE('    if(B.plots.length)BL.push(B);');
    DBMS_OUTPUT.PUT_LINE('    if(window.ResizeObserver){var ro=new ResizeObserver(function(){drawBlock(B);});B.plots.forEach(function(x){ro.observe(x.box);});}');
    DBMS_OUTPUT.PUT_LINE('  });');
    DBMS_OUTPUT.PUT_LINE('  if(!BL.length){var lg=sec.querySelector(''.pf-lg'');if(lg)lg.hidden=true;}');
    DBMS_OUTPUT.PUT_LINE('  cardLinks();');
    DBMS_OUTPUT.PUT_LINE('  drawAll(true);');
    DBMS_OUTPUT.PUT_LINE('  window.addEventListener(''resize'',function(){drawAll(false);});');
    DBMS_OUTPUT.PUT_LINE('  doc.addEventListener(''awr:view'',function(){setTimeout(function(){drawAll(false);},30);});');
    DBMS_OUTPUT.PUT_LINE('  doc.addEventListener(''toggle'',function(){drawAll(false);},true);');
    DBMS_OUTPUT.PUT_LINE('  doc.addEventListener(''scroll'',tipOff,{passive:true});');
    DBMS_OUTPUT.PUT_LINE('});');
    DBMS_OUTPUT.PUT_LINE('})();');
    DBMS_OUTPUT.PUT_LINE('</script>');
END;
/
