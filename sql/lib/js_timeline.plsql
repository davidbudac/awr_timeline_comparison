--
-- sql/lib/js_timeline.plsql
--
-- Client half of the Timeline view (v1.6.0, Mock D): the aligned window
-- grid (#tl, skeleton emitted by sql/00_params.sql, rows by the sections
-- through sql/lib/timeline.plsql), and the "Activity, whole span" charts
-- in every view (section#activity, skeleton in 00; payloads
-- window.AWR_DATA.ashx by wait class and AWR_DATA.ashe by wait event, both
-- from sql/09_ash_timeline.sql's one ASH scan).
-- Emitted once by the driver prologue, right after js_wingrid.plsql (it
-- extends window.AWR_WG); pure inline JS + SVG, CDN-free, so it works
-- offline and with ECharts blocked.  Colours come from CSS variables,
-- except the fixed wait-class palette (window.AWR_WAIT_COLORS,
-- sql/lib/js_wait_colors.plsql) and the event palette (EVP below: CPU
-- keeps the wait-class green, "Other events" a fixed grey).
--
-- Exposes window.AWR_TL:
--   take()        called by the inline script after each section's
--                 <template class="tl-src" data-lane="lane-X">: moves its
--                 rows into that lane (data-after="id" puts a row right
--                 under another one, 18's SQL Monitor rows under 06's) and
--                 unhides the lane.  Runs while the page parses.
--   reveal(el)    opens a folded lane / the "+ Show N more" rows that hide
--                 el (called by the chrome's reveal() before a goTo).
--   axLayout(m, persist)  'win' = windows side by side, 'span' = full span
--                 (persist: the reader clicked, localStorage awr-axlayout).
--   fitLabels(groups, cands, o)  the Activity band-label fitter, pure
--                 (tested by tools/js_unit_tests.js).
--   labelAlts(alts, names, k)  drops a label cut whose stem also starts
--                 another series' name (pure, unit-tested).
--   pkInfo(pk, ws) / pkText(i, wh)  plan 041: the Current window's busiest
--                 minute (AWR_DATA.ashx.pk) against the valid prior
--                 windows' ones, and its sentence (pure, unit-tested); the
--                 DB time card's "Peak" evidence row and the window stripe
--                 tooltip's "Busiest minute" line use them.
--   cpuInfo(cpu) / cpuText(i)  plan 042: the Current window's DB CPU
--                 against its cpu_count (AWR_DATA.ashx.cpu), ASH on CPU
--                 above DB CPU = waiting for a CPU, CPU-bound at 90 %
--                 (pure, unit-tested); the DB time card's "CPU" evidence
--                 row; cpuMark draws the cpu_count line on the class
--                 chart only inside its y range, cpuHead the header note
--                 ("above this scale") otherwise.
--   stackAt(pts, ord, vk, sx, v)  the series whose band is DRAWN at
--                 (sx, v): the hover / click / soft-highlight pick (pure,
--                 unit-tested; review follow-up R3).
--   flagPos(tiers, x, ws, lo, hi)  where a release flag goes: long label,
--                 then short, left-anchored or flipped, inside both edges
--                 (pure, unit-tested; R3).
-- and on window.AWR_WG:
--   pin(o)        pin window offset o (0 / null / the pinned one = unpin):
--                 its grid column tints amber, every gutter Delta compares
--                 Current against it ("vs 13 Aug"), the charts' stripe
--                 turns amber; Esc, Current or the gutter's clear unpin it
--                 (a view switch keeps it: the charts show it everywhere).
--   pinned()      the pinned offset or null.
-- At DOMContentLoaded: lane counts / fold / "+ Show N more", the prior
-- values of every grid row (from data-v; shown on hover or pin), the
-- #tl-tools (plan 031): Rows All / Flagged only, Order Report / Biggest
-- change first, saved on click as awr-tl-rows / awr-tl-order; #tl.flagonly,
-- .lane.nofl, .r.nfl; then the
-- stacked activity columns (Activity lane, and the DB time card chart of
-- the Summary view), then the two Activity charts -- ONE chart factory
-- (mkChart / draw), two instances sharing one time axis (x labels on the
-- lower one, release-marker flags on the upper one): hover crosshair +
-- tooltip with each series' AAS (mirrored on the other chart), legend
-- toggles that restack and rescale, drag-to-zoom with a minimum span
-- (zooms both), Reset / double-click, compared windows shaded -- Current
-- indigo, pinned amber, skipped grey -- click / Enter on one pins it.
-- In the Summary view the charts open compact (#activity.ax-cmp: the
-- by-class chart only, 96-px plot; #ax-more toggles, localStorage awr-ax;
-- off in the dashboard design, whose tabs show one chart at a time).
-- "Windows side by side" (SP.mode win): one panel per compared window,
-- shared y axis, 1-minute data where it covers the window; caps pin; no zoom
-- (drawWin, wSlice, panAt / wRefAt; shared with draw: hlOrd, colPts,
-- bands, flagSvg).
-- Direct labels (dlab -> fitLabels, fitted per band): each series is named
-- once, inside its band, on its thickest stretch as wide as the label
-- (at least LBH 10 px; shorter cuts when the name fits nowhere, never one
-- that another series' name starts with too), at most 6
-- a chart.  Release flags (flagSvg): markers at one spot (side by side: one
-- gap) share a group, a "+n" flag names the rest; side by side the flag
-- band is reserved only while a marker is in view.  setSvg keeps the focus
-- on a window stripe / cap through a redraw.  A pointer maps to SVG units
-- through the SVG's screen CTM (toSvg / toCli): narrower than 480 px the
-- 480-px viewBox is scaled down and centred vertically (R3).
-- v1.6.1 series highlight: a legend entry hovered / focused (or kept by a
-- click on its band, Shift+click) is drawn from zero on its own y axis,
-- the rest faded; a class lights its events (AWR_DATA.ashe.ecls) and an
-- event its class; the band under the pointer highlights in place; Esc
-- clears the highlight first, then the pinned window.
-- No literal tilde below (SET DEFINE tilde).  GENERATED: the body below
-- (BEGIN .. END) is written by tools/js2plsql.sh from the readable source
-- sql/lib/src/js_timeline.js -- edit the .js, then run tools/js2plsql.sh
-- (lint check 24 fails on a stale body).  This header is kept as is.
--
BEGIN
    DBMS_OUTPUT.PUT_LINE('<script>');
    DBMS_OUTPUT.PUT_LINE('(function(){');
    DBMS_OUTPUT.PUT_LINE('var doc=document, W=window.AWR_WG=window.AWR_WG||{}, TL=window.AWR_TL={};');
    DBMS_OUTPUT.PUT_LINE('var H1=36e5, MINUS=''\u2212'';');
    DBMS_OUTPUT.PUT_LINE('function $(s,r){return (r||doc).querySelector(s);}');
    DBMS_OUTPUT.PUT_LINE('function $$(s,r){return Array.prototype.slice.call((r||doc).querySelectorAll(s));}');
    DBMS_OUTPUT.PUT_LINE('function shown(el){return !!el&&el.getClientRects().length>0;}');
    DBMS_OUTPUT.PUT_LINE('function mk(t,c,p){var e=doc.createElement(t);if(c)e.className=c;if(p)p.appendChild(e);return e;}');
    DBMS_OUTPUT.PUT_LINE('function esc(s){return String(s==null?'''':s).replace(/[&<>"]/g,function(c){return {''&'':''&amp;'',''<'':''&lt;'',''>'':''&gt;'',''"'':''&quot;''}[c];});}');
    DBMS_OUTPUT.PUT_LINE('function num(s){if(s==null||s==='''')return null;var v=+s;return isNaN(v)?null:v;}');
    DBMS_OUTPUT.PUT_LINE('function nums(s){return String(s||'''').split('','').map(num);}');
    DBMS_OUTPUT.PUT_LINE('function cssNum(el,n,d){var v=parseFloat(getComputedStyle(el).getPropertyValue(n));return isNaN(v)?d:v;}');
    DBMS_OUTPUT.PUT_LINE('function reduced(){try{return matchMedia(''(prefers-reduced-motion: reduce)'').matches;}catch(e){return false;}}');
    DBMS_OUTPUT.PUT_LINE('/* sql/lib/fmt_num.plsql, client side: about 4 significant digits, k / M / G */');
    DBMS_OUTPUT.PUT_LINE('function grp(n){return String(n).replace(/\B(?=(\d{3})+(?!\d))/g,'','');}');
    DBMS_OUTPUT.PUT_LINE('function fmtNum(p){');
    DBMS_OUTPUT.PUT_LINE('  if(p==null)return ''\u2014'';if(p===0)return ''0'';');
    DBMS_OUTPUT.PUT_LINE('  var a=Math.abs(p),s=p<0?''-'':'''',u='''',v=a,t;');
    DBMS_OUTPUT.PUT_LINE('  if(a>=1e9){v=a/1e9;u='' G'';}else if(a>=1e6){v=a/1e6;u='' M'';}else if(a>=1e4){v=a/1e3;u='' k'';}');
    DBMS_OUTPUT.PUT_LINE('  if(v>=1000)t=grp(Math.round(v));else if(v>=100)t=grp(v.toFixed(1));else if(v>=10)t=v.toFixed(2);else if(v>=1)t=v.toFixed(3);');
    DBMS_OUTPUT.PUT_LINE('  else{var d=Math.min(6,3-Math.floor(Math.log10(v)));if(Math.round(v*1e6)===0)return s+''<0.000001'';t=String(+v.toFixed(d));if(t.charAt(0)!==''0'')t=''0''+t.slice(t.indexOf(''.''));}');
    DBMS_OUTPUT.PUT_LINE('  return s+t+u;');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('/* the page''s one Delta rule (sql/lib/band_glyph.plsql delta_span) */');
    DBMS_OUTPUT.PUT_LINE('function delta(cur,mu){');
    DBMS_OUTPUT.PUT_LINE('  if(cur==null||mu==null||mu===0)return ''\u2014'';');
    DBMS_OUTPUT.PUT_LINE('  var q=cur/mu;');
    DBMS_OUTPUT.PUT_LINE('  if(mu>0&&q>=2)return ''\u25b2 \u00d7''+(q<100?q.toFixed(1):Math.round(q));');
    DBMS_OUTPUT.PUT_LINE('  var p=(cur-mu)/Math.abs(mu)*100;');
    DBMS_OUTPUT.PUT_LINE('  return (p>=0?''\u25b2 '':''\u25bc '')+Math.abs(p).toFixed(1)+''%'';');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('function aasTxt(v){return v>=10?v.toFixed(0):v>=1?v.toFixed(1):v>=0.01?v.toFixed(2):v.toPrecision(1);}');
    DBMS_OUTPUT.PUT_LINE('function niceStep(max,n){var raw=max/n,p=Math.pow(10,Math.floor(Math.log10(raw))),m=raw/p;return (m<=1?1:m<=2?2:m<=5?5:10)*p;}');
    DBMS_OUTPUT.PUT_LINE('/* the compared windows, oldest first (window.AWR_WIN from 00_params.sql) */');
    DBMS_OUTPUT.PUT_LINE('function wins(){return (window.AWR_WIN&&window.AWR_WIN.w)||[];}');
    DBMS_OUTPUT.PUT_LINE('function winAt(o){var w=wins();for(var i=0;i<w.length;i++)if(w[i].o===+o)return w[i];return null;}');
    DBMS_OUTPUT.PUT_LINE('function idxOf(o){var w=wins();for(var i=0;i<w.length;i++)if(w[i].o===+o)return i;return -1;}');
    DBMS_OUTPUT.PUT_LINE('function offTxt(w){return w.o===0?''Current'':String(w.l).replace(''-'',MINUS);}');
    DBMS_OUTPUT.PUT_LINE('function wcol(c){return (window.AWR_WAIT_COLORS||{})[c]||''#9AA3AD'';}');
    DBMS_OUTPUT.PUT_LINE('var MON=[''Jan'',''Feb'',''Mar'',''Apr'',''May'',''Jun'',''Jul'',''Aug'',''Sep'',''Oct'',''Nov'',''Dec''],DOW=[''Sun'',''Mon'',''Tue'',''Wed'',''Thu'',''Fri'',''Sat''];');
    DBMS_OUTPUT.PUT_LINE('function PT(s){return Date.parse(String(s).replace('' '',''T'')+'':00Z'');}');
    DBMS_OUTPUT.PUT_LINE('function p2(n){return (n<10?''0'':'''')+n;}');
    DBMS_OUTPUT.PUT_LINE('function fDay(t){var d=new Date(t);return d.getUTCDate()+'' ''+MON[d.getUTCMonth()];}');
    DBMS_OUTPUT.PUT_LINE('function fAt(t){var d=new Date(t);return DOW[d.getUTCDay()]+'' ''+fDay(t)+'' ''+p2(d.getUTCHours())+'':''+p2(d.getUTCMinutes());}');
    DBMS_OUTPUT.PUT_LINE('function fHM(t){var d=new Date(t);return p2(d.getUTCHours())+'':''+p2(d.getUTCMinutes());}');
    DBMS_OUTPUT.PUT_LINE('/* ---- 1. lane sources: a section''s rows ride in <template class="tl-src">,');
    DBMS_OUTPUT.PUT_LINE('   the inline script right after it calls take() while the page parses */');
    DBMS_OUTPUT.PUT_LINE('TL.take=function(){');
    DBMS_OUTPUT.PUT_LINE('  var s=doc.currentScript,t=s&&s.previousElementSibling;');
    DBMS_OUTPUT.PUT_LINE('  if(!t||t.tagName!==''TEMPLATE'')return;');
    DBMS_OUTPUT.PUT_LINE('  var lane=doc.getElementById(t.getAttribute(''data-lane'')),box=lane&&$(''.lrows'',lane);');
    DBMS_OUTPUT.PUT_LINE('  if(!box)return;');
    DBMS_OUTPUT.PUT_LINE('  Array.prototype.slice.call(t.content.children).forEach(function(r){');
    DBMS_OUTPUT.PUT_LINE('    var a=r.getAttribute(''data-after''),ref=a?doc.getElementById(a):null;');
    DBMS_OUTPUT.PUT_LINE('    if(ref&&ref.parentNode===box){');
    DBMS_OUTPUT.PUT_LINE('      while(ref.nextElementSibling&&ref.nextElementSibling.getAttribute(''data-after'')===a)ref=ref.nextElementSibling;');
    DBMS_OUTPUT.PUT_LINE('      box.insertBefore(r,ref.nextElementSibling);');
    DBMS_OUTPUT.PUT_LINE('    }else box.appendChild(r);');
    DBMS_OUTPUT.PUT_LINE('  });');
    DBMS_OUTPUT.PUT_LINE('  lane.hidden=false;');
    DBMS_OUTPUT.PUT_LINE('  t.parentNode.removeChild(t);');
    DBMS_OUTPUT.PUT_LINE('};');
    DBMS_OUTPUT.PUT_LINE('/* open whatever hides a Timeline row: a closed lane, the folded rows */');
    DBMS_OUTPUT.PUT_LINE('TL.reveal=function(el){');
    DBMS_OUTPUT.PUT_LINE('  var lane=el&&el.closest?el.closest(''#tl .lane''):null;if(!lane)return;');
    DBMS_OUTPUT.PUT_LINE('  if(lane.getAttribute(''data-kind'')===''scored''&&el.classList.contains(''bars'')&&!flagged(el)&&lane.closest(''#tl.flagonly''))setRows(''all'',false);');
    DBMS_OUTPUT.PUT_LINE('  if(lane.classList.contains(''closed'')){lane.classList.remove(''closed'');var b=$(''.lt2'',lane);if(b)b.setAttribute(''aria-expanded'',''true'');}');
    DBMS_OUTPUT.PUT_LINE('  if(el.classList.contains(''more''))showMore(lane);');
    DBMS_OUTPUT.PUT_LINE('  setTimeout(function(){if(W.render)W.render(lane);},0);');
    DBMS_OUTPUT.PUT_LINE('};');
    DBMS_OUTPUT.PUT_LINE('function showMore(lane){lane.classList.add(''showmore'');var b=$(''.xpb'',lane);if(b)b.setAttribute(''aria-expanded'',''true'');if(W.render)W.render(lane);}');
    DBMS_OUTPUT.PUT_LINE('/* ---- 2. lanes: fold toggles, "+ Show N more", counts in the lane head */');
    DBMS_OUTPUT.PUT_LINE('function laneMeta(lane){');
    DBMS_OUTPUT.PUT_LINE('  var m=$(''.gh2 .meta'',lane);if(!m)return[0,0];');
    DBMS_OUTPUT.PUT_LINE('  var rows=$$(''.lrows > .r'',lane),kind=lane.getAttribute(''data-kind''),h='''',lg=0,md=0,nr=0;');
    DBMS_OUTPUT.PUT_LINE('  rows.forEach(function(r){if(r.classList.contains(''twin'')||r.classList.contains(''xpr''))return;var s=r.getAttribute(''data-sev'');if(s===''large'')lg++;else if(s===''moderate'')md++;else if(s)nr++;});');
    DBMS_OUTPUT.PUT_LINE('  if(kind===''scored''){');
    DBMS_OUTPUT.PUT_LINE('    if(lg)h+=''<span><i class="dotk large"></i>''+lg+'' large</span>'';');
    DBMS_OUTPUT.PUT_LINE('    if(md)h+=''<span><i class="dotk moderate"></i>''+md+'' moderate</span>'';');
    DBMS_OUTPUT.PUT_LINE('    if(nr)h+=''<span><i class="dotk typical"></i>''+nr+'' normal</span>'';');
    DBMS_OUTPUT.PUT_LINE('  }else if(kind===''sql''){');
    DBMS_OUTPUT.PUT_LINE('    var pc=$$(''.r:not(.sub) .glf.gp'',lane).length,nw=$$(''.glf.gn'',lane).length,dp=$$(''.glf.gd'',lane).length;');
    DBMS_OUTPUT.PUT_LINE('    if(pc)h+=''<span><b>\u25c6</b> ''+pc+'' plan change''+(pc>1?''s'':'''')+''</span>'';');
    DBMS_OUTPUT.PUT_LINE('    if(nw)h+=''<span><b>\u271a</b> ''+nw+'' new</span>'';');
    DBMS_OUTPUT.PUT_LINE('    if(dp)h+=''<span><b>\u25bd</b> ''+dp+'' DOP</span>'';');
    DBMS_OUTPUT.PUT_LINE('    if(!h)h=''<span class="muted">ranked, not scored</span>'';');
    DBMS_OUTPUT.PUT_LINE('  }else if(kind===''config''){');
    DBMS_OUTPUT.PUT_LINE('    var n=0,f=0;');
    DBMS_OUTPUT.PUT_LINE('    rows.forEach(function(r){if(!r.classList.contains(''p''))return;n++;var hit=false;$$(''.c'',r).forEach(function(c){if($(''.nd'',c)&&W.markerAt&&W.markerAt(+c.getAttribute(''data-w'')))hit=true;});if(hit)f++;});');
    DBMS_OUTPUT.PUT_LINE('    h=''<span class="muted">''+(f&&f===n?(n>1?''all ''+n+'' under a flag'':''under a flag''):f?f+'' of ''+n+'' under a flag'':n+'' changed'')+''</span>'';');
    DBMS_OUTPUT.PUT_LINE('  }else h=''<span class="muted">''+esc(lane.getAttribute(''data-note'')||''not scored'')+''</span>'';');
    DBMS_OUTPUT.PUT_LINE('  m.innerHTML=h;');
    DBMS_OUTPUT.PUT_LINE('  return [lg,md];');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('function lanes(){');
    DBMS_OUTPUT.PUT_LINE('  var tl=doc.getElementById(''tl'');if(!tl)return;');
    DBMS_OUTPUT.PUT_LINE('  var np=wins().length,tot=[0,0];');
    DBMS_OUTPUT.PUT_LINE('  $$(''.lane'',tl).forEach(function(lane){');
    DBMS_OUTPUT.PUT_LINE('    var more=$$(''.lrows > .r.more'',lane);');
    DBMS_OUTPUT.PUT_LINE('    if(more.length&&!$(''.r.xpr'',lane)){');
    DBMS_OUTPUT.PUT_LINE('      var x=doc.createElement(''div'');x.className=''r xpr'';x.setAttribute(''role'',''row'');');
    DBMS_OUTPUT.PUT_LINE('      var h=''<div class="l" role="rowheader"><button class="xpb" type="button" aria-expanded="false">+ Show ''+more.length+'' more ''+esc(lane.getAttribute(''data-noun'')||''rows'')+''</button></div>'';');
    DBMS_OUTPUT.PUT_LINE('      wins().forEach(function(w){h+=''<div class="c''+(w.o===0?'' cur'':'''')+''" data-w="''+w.o+''"></div>'';});');
    DBMS_OUTPUT.PUT_LINE('      x.innerHTML=h+''<div class="g" role="cell"></div>'';');
    DBMS_OUTPUT.PUT_LINE('      more[0].parentNode.insertBefore(x,more[0]);');
    DBMS_OUTPUT.PUT_LINE('      $(''.xpb'',x).addEventListener(''click'',function(){showMore(lane);});');
    DBMS_OUTPUT.PUT_LINE('    }');
    DBMS_OUTPUT.PUT_LINE('    var n=laneMeta(lane);tot[0]+=n[0];tot[1]+=n[1];');
    DBMS_OUTPUT.PUT_LINE('    var b=$(''.lt2'',lane);');
    DBMS_OUTPUT.PUT_LINE('    if(b)b.addEventListener(''click'',function(){var open=lane.classList.toggle(''closed'')===false;b.setAttribute(''aria-expanded'',String(open));if(open&&W.render)W.render(lane);});');
    DBMS_OUTPUT.PUT_LINE('    var rl=doc.querySelector(''nav.toc a[href="#''+lane.id+''"]'');');
    DBMS_OUTPUT.PUT_LINE('    if(rl)rl.hidden=lane.hidden;');
    DBMS_OUTPUT.PUT_LINE('    var jn=$(''.jumpnav a[href="#''+lane.id+''"]'',tl);if(jn)jn.hidden=lane.hidden;');
    DBMS_OUTPUT.PUT_LINE('  });');
    DBMS_OUTPUT.PUT_LINE('  var h2=$(''#timeline > h2'');');
    DBMS_OUTPUT.PUT_LINE('  if(h2&&!$(''.meta'',h2)&&(tot[0]||tot[1])){var m=mk(''span'',''meta'');m.innerHTML=(tot[0]?''<span><i class="dotk large"></i>''+tot[0]+'' large</span>'':'''')+(tot[1]?''<span><i class="dotk moderate"></i>''+tot[1]+'' moderate</span>'':'''');h2.appendChild(m);}');
    DBMS_OUTPUT.PUT_LINE('  if(!np)return;');
    DBMS_OUTPUT.PUT_LINE('  /* a skipped window (no valid snapshot pair) greys its date in the ruler */');
    DBMS_OUTPUT.PUT_LINE('  wins().forEach(function(w){if(w.v!==''N'')return;var h=$(''.ruler .h[data-w="''+w.o+''"]'',tl);if(h){h.classList.add(''skw'');h.title+='' (skipped window: left out of every baseline)'';}});');
    DBMS_OUTPUT.PUT_LINE('  /* the prior values, filled from data-v (shown on hover / pin) */');
    DBMS_OUTPUT.PUT_LINE('  $$(''.r.bars[data-v]'',tl).forEach(function(row){');
    DBMS_OUTPUT.PUT_LINE('    var v=nums(row.getAttribute(''data-v''));');
    DBMS_OUTPUT.PUT_LINE('    $$('':scope > .c[data-w]'',row).forEach(function(c){');
    DBMS_OUTPUT.PUT_LINE('      if($(''.v'',c))return;var x=v[idxOf(c.getAttribute(''data-w''))];');
    DBMS_OUTPUT.PUT_LINE('      c.insertAdjacentHTML(''afterbegin'',x==null?''<span class="v nil" aria-label="no value">\u2013</span>'':''<span class="v">''+fmtNum(x)+''</span>'');');
    DBMS_OUTPUT.PUT_LINE('    });');
    DBMS_OUTPUT.PUT_LINE('  });');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('/* ---- 2b. the row toolbar (plan 031), above the grid: "Flagged only"');
    DBMS_OUTPUT.PUT_LINE('   hides the rows of the scored lanes that are not large / moderate');
    DBMS_OUTPUT.PUT_LINE('   (folded ones included); "Biggest change first" sorts the scored lanes');
    DBMS_OUTPUT.PUT_LINE('   (waits: by added AAS when every row is in AAS, else by z; headline and');
    DBMS_OUTPUT.PUT_LINE('   load: by z; a row new in Current ranks by its Current value, see');
    DBMS_OUTPUT.PUT_LINE('   AWR_WG.changeKey), wait-class rows staying above the events.  A viewer''s');
    DBMS_OUTPUT.PUT_LINE('   choice, saved on a click only (localStorage awr-tl-rows /');
    DBMS_OUTPUT.PUT_LINE('   awr-tl-order), like awr-view.  Counts, pills and ids never change. */');
    DBMS_OUTPUT.PUT_LINE('var TLF={rows:''all'',order:''report''};');
    DBMS_OUTPUT.PUT_LINE('function lsGet(k){try{return localStorage.getItem(k);}catch(e){return null;}}');
    DBMS_OUTPUT.PUT_LINE('function lsSet(k,v){try{localStorage.setItem(k,v);}catch(e){}}');
    DBMS_OUTPUT.PUT_LINE('function scoredLanes(){return $$(''#tl .lane[data-kind="scored"]'');}');
    DBMS_OUTPUT.PUT_LINE('function laneRows(lane){return $$(''.lrows > .r.bars'',lane);}');
    DBMS_OUTPUT.PUT_LINE('function flagged(r){var s=r.getAttribute(''data-sev'');return s===''large''||s===''moderate'';}');
    DBMS_OUTPUT.PUT_LINE('function toolSync(note){');
    DBMS_OUTPUT.PUT_LINE('  $$(''#tl-tools button[data-tlf]'').forEach(function(b){b.setAttribute(''aria-pressed'',String(b.getAttribute(''data-tlf'')===TLF.rows));});');
    DBMS_OUTPUT.PUT_LINE('  $$(''#tl-tools button[data-tlo]'').forEach(function(b){b.setAttribute(''aria-pressed'',String(b.getAttribute(''data-tlo'')===TLF.order));});');
    DBMS_OUTPUT.PUT_LINE('  if(note!=null){var n=$(''#tl-tools .tlt-n'');if(n)n.innerHTML=note;}');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('function setRows(v,save,boot){');
    DBMS_OUTPUT.PUT_LINE('  var tl=doc.getElementById(''tl'');if(!tl)return;TLF.rows=v;');
    DBMS_OUTPUT.PUT_LINE('  tl.classList.toggle(''flagonly'',v===''flagged'');');
    DBMS_OUTPUT.PUT_LINE('  scoredLanes().forEach(function(l){l.classList.toggle(''nofl'',!laneRows(l).some(flagged));});');
    DBMS_OUTPUT.PUT_LINE('  toolSync();if(save)lsSet(''awr-tl-rows'',v);');
    DBMS_OUTPUT.PUT_LINE('  if(!boot&&W.render)W.render(tl);');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('function setOrder(v,save,boot){');
    DBMS_OUTPUT.PUT_LINE('  var tl=doc.getElementById(''tl'');if(!tl)return;TLF.order=v;');
    DBMS_OUTPUT.PUT_LINE('  var notes=[],valid=wins().map(function(w){return w.v!==''N'';});');
    DBMS_OUTPUT.PUT_LINE('  scoredLanes().forEach(function(lane){');
    DBMS_OUTPUT.PUT_LINE('    var rows=laneRows(lane),box=$(''.lrows'',lane);if(!rows.length||!box)return;');
    DBMS_OUTPUT.PUT_LINE('    rows.forEach(function(r,i){if(!r.hasAttribute(''data-ord''))r.setAttribute(''data-ord'',String(i));});');
    DBMS_OUTPUT.PUT_LINE('    var aas=rows.every(function(r){return r.getAttribute(''data-unit'')===''AAS'';});');
    DBMS_OUTPUT.PUT_LINE('    var key=function(r){return W.changeKey(nums(r.getAttribute(''data-v'')),num(r.getAttribute(''data-mu'')),num(r.getAttribute(''data-sd'')),aas,valid);};');
    DBMS_OUTPUT.PUT_LINE('    var grp=function(r){return /^tl-fr-w-/.test(r.id)?0:1;},ord=function(r){return +r.getAttribute(''data-ord'');};');
    DBMS_OUTPUT.PUT_LINE('    rows.sort(v===''change''?function(a,b){var g=grp(a)-grp(b);if(g)return g;var ka=key(a),kb=key(b);');
    DBMS_OUTPUT.PUT_LINE('      if(ka==null&&kb!=null)return 1;if(kb==null&&ka!=null)return -1;if(ka!==kb&&ka!=null)return kb-ka;return ord(a)-ord(b);}');
    DBMS_OUTPUT.PUT_LINE('      :function(a,b){return ord(a)-ord(b);});');
    DBMS_OUTPUT.PUT_LINE('    rows.forEach(function(r){box.appendChild(r);});');
    DBMS_OUTPUT.PUT_LINE('    var x=$(''.r.xpr'',lane),m=$(''.lrows > .r.more'',lane),nf=$(''.r.nfl'',lane),xb=$(''.xpb'',lane);');
    DBMS_OUTPUT.PUT_LINE('    if(v===''change''){if(m&&!lane.classList.contains(''showmore'')){lane.setAttribute(''data-autoshow'',''1'');showMore(lane);}');
    DBMS_OUTPUT.PUT_LINE('      notes.push(esc(($(''.lti'',lane)||{}).textContent||lane.id)+'': by ''+(aas?''added AAS'':''size of the move (z)''));}');
    DBMS_OUTPUT.PUT_LINE('    else{if(lane.hasAttribute(''data-autoshow'')){lane.removeAttribute(''data-autoshow'');lane.classList.remove(''showmore'');if(xb)xb.setAttribute(''aria-expanded'',''false'');}');
    DBMS_OUTPUT.PUT_LINE('      if(x&&m)box.insertBefore(x,m);}');
    DBMS_OUTPUT.PUT_LINE('    if(nf)box.appendChild(nf);');
    DBMS_OUTPUT.PUT_LINE('  });');
    DBMS_OUTPUT.PUT_LINE('  toolSync(notes.join(''; ''));if(save)lsSet(''awr-tl-order'',v);');
    DBMS_OUTPUT.PUT_LINE('  if(!boot&&W.render)W.render(tl);');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('function tools(){');
    DBMS_OUTPUT.PUT_LINE('  var tl=doc.getElementById(''tl'');if(!tl||!scoredLanes().length||doc.getElementById(''tl-tools''))return;');
    DBMS_OUTPUT.PUT_LINE('  scoredLanes().forEach(function(lane){var box=$(''.lrows'',lane);if(!box)return;var nf=mk(''div'',''r nfl'',box);nf.setAttribute(''role'',''row'');nf.innerHTML=''<div class="l" role="rowheader">No large or moderate row here</div>'';});');
    DBMS_OUTPUT.PUT_LINE('  var t=mk(''div'',''tl-tools'');t.id=''tl-tools'';t.setAttribute(''role'',''toolbar'');t.setAttribute(''aria-label'',''Timeline rows'');');
    DBMS_OUTPUT.PUT_LINE('  t.innerHTML=''<span class="tlt-g" role="group" aria-label="Rows"><span class="tlt-l">Rows</span><button type="button" data-tlf="all">All</button><button type="button" data-tlf="flagged">Flagged only</button></span>''');
    DBMS_OUTPUT.PUT_LINE('    +''<span class="tlt-g" role="group" aria-label="Order"><span class="tlt-l">Order</span><button type="button" data-tlo="report">Report order</button><button type="button" data-tlo="change">Biggest change first</button></span>''');
    DBMS_OUTPUT.PUT_LINE('    +''<span class="tlt-n"></span>'';');
    DBMS_OUTPUT.PUT_LINE('  tl.parentNode.insertBefore(t,tl);');
    DBMS_OUTPUT.PUT_LINE('  t.addEventListener(''click'',function(ev){var b=ev.target&&ev.target.closest?ev.target.closest(''button''):null;if(!b)return;');
    DBMS_OUTPUT.PUT_LINE('    if(b.hasAttribute(''data-tlf''))setRows(b.getAttribute(''data-tlf''),true);else if(b.hasAttribute(''data-tlo''))setOrder(b.getAttribute(''data-tlo''),true);});');
    DBMS_OUTPUT.PUT_LINE('  /* boot: no render here, the DOMContentLoaded block renders #tl next */');
    DBMS_OUTPUT.PUT_LINE('  var r=lsGet(''awr-tl-rows''),o=lsGet(''awr-tl-order'');');
    DBMS_OUTPUT.PUT_LINE('  setRows(r===''flagged''?''flagged'':''all'',false,true);setOrder(o===''change''?''change'':''report'',false,true);');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('/* ---- 3. pin a window: its column tints, the gutter compares against it */');
    DBMS_OUTPUT.PUT_LINE('var PW=null;');
    DBMS_OUTPUT.PUT_LINE('W.pinned=function(){return PW;};');
    DBMS_OUTPUT.PUT_LINE('function flashCol(o){');
    DBMS_OUTPUT.PUT_LINE('  $$(''#tl .c[data-w="''+o+''"], #tl .ruler .h[data-w="''+o+''"]'').forEach(function(c){c.classList.remove(''colflash'');void c.offsetWidth;c.classList.add(''colflash'');});');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('W.pin=function(o){');
    DBMS_OUTPUT.PUT_LINE('  var tl=doc.getElementById(''tl'');if(!tl)return;');
    DBMS_OUTPUT.PUT_LINE('  o=(o==null||o==='''')?null:+o;');
    DBMS_OUTPUT.PUT_LINE('  var same=(PW!==null&&o===PW),bd=doc.body,gt=doc.getElementById(''tl-gt''),gs=doc.getElementById(''tl-gs'');');
    DBMS_OUTPUT.PUT_LINE('  $$(''.ruler .h[aria-pressed]'',tl).forEach(function(h){h.setAttribute(''aria-pressed'',''false'');});');
    DBMS_OUTPUT.PUT_LINE('  $$(''.pc'',tl).forEach(function(x){x.classList.remove(''pc'');});');
    DBMS_OUTPUT.PUT_LINE('  $$(''.r .g .d1[data-orig]'',tl).forEach(function(d){d.innerHTML=d.getAttribute(''data-orig'');d.removeAttribute(''data-orig'');});');
    DBMS_OUTPUT.PUT_LINE('  if(same||o===null||o===0){');
    DBMS_OUTPUT.PUT_LINE('    PW=null;bd.removeAttribute(''data-pw'');');
    DBMS_OUTPUT.PUT_LINE('    if(gt)gt.textContent=''vs prior mean'';if(gs)gs.textContent=''click a date to pin'';');
    DBMS_OUTPUT.PUT_LINE('    drawAll(true);return;');
    DBMS_OUTPUT.PUT_LINE('  }');
    DBMS_OUTPUT.PUT_LINE('  var w=winAt(o),i=idxOf(o);if(!w)return;');
    DBMS_OUTPUT.PUT_LINE('  PW=o;bd.setAttribute(''data-pw'',String(o));');
    DBMS_OUTPUT.PUT_LINE('  var h=$(''.ruler .h[data-w="''+o+''"]'',tl);if(h)h.setAttribute(''aria-pressed'',''true'');');
    DBMS_OUTPUT.PUT_LINE('  $$(''[data-w="''+o+''"]'',tl).forEach(function(x){if(!x.closest(''.flags''))x.classList.add(''pc'');});');
    DBMS_OUTPUT.PUT_LINE('  $$(''.r.bars[data-v]'',tl).forEach(function(row){');
    DBMS_OUTPUT.PUT_LINE('    var d=$('':scope > .g .d1'',row);if(!d)return;');
    DBMS_OUTPUT.PUT_LINE('    var v=nums(row.getAttribute(''data-v''));');
    DBMS_OUTPUT.PUT_LINE('    d.setAttribute(''data-orig'',d.innerHTML);');
    DBMS_OUTPUT.PUT_LINE('    d.textContent=delta(v[v.length-1],v[i])+'' vs ''+w.d;');
    DBMS_OUTPUT.PUT_LINE('  });');
    DBMS_OUTPUT.PUT_LINE('  if(gt){gt.innerHTML=''vs ''+esc(w.d)+'' <button type="button" class="unpin" aria-label="Clear the pinned window">clear</button>'';$(''.unpin'',gt).addEventListener(''click'',function(){W.pin(null);});}');
    DBMS_OUTPUT.PUT_LINE('  if(gs)gs.textContent=''band stays vs prior mean'';');
    DBMS_OUTPUT.PUT_LINE('  drawAll(true);');
    DBMS_OUTPUT.PUT_LINE('};');
    DBMS_OUTPUT.PUT_LINE('doc.addEventListener(''click'',function(ev){');
    DBMS_OUTPUT.PUT_LINE('  var h=ev.target&&ev.target.closest?ev.target.closest(''#tl .ruler .h[data-w]''):null;if(!h)return;');
    DBMS_OUTPUT.PUT_LINE('  var o=+h.getAttribute(''data-w'');');
    DBMS_OUTPUT.PUT_LINE('  if(o===0){W.pin(null);flashCol(0);}else W.pin(o);');
    DBMS_OUTPUT.PUT_LINE('});');
    DBMS_OUTPUT.PUT_LINE('/* Esc: the first press clears a highlighted Activity series (hlEsc,');
    DBMS_OUTPUT.PUT_LINE('   section 6), the next one the pinned window */');
    DBMS_OUTPUT.PUT_LINE('doc.addEventListener(''keydown'',function(ev){if(ev.key!==''Escape'')return;if(hlEsc())return;if(PW!==null)W.pin(null);});');
    DBMS_OUTPUT.PUT_LINE('/* the pin survives a view switch: the Activity charts that show it are in');
    DBMS_OUTPUT.PUT_LINE('   every view (Esc, Current or the gutter''s clear unpin) */');
    DBMS_OUTPUT.PUT_LINE('doc.addEventListener(''awr:view'',function(ev){');
    DBMS_OUTPUT.PUT_LINE('  var v=ev.detail&&ev.detail.view;');
    DBMS_OUTPUT.PUT_LINE('  setTimeout(function(){drawAll(true);if(v===''timeline''){sync();startAtCurrent();}},50);');
    DBMS_OUTPUT.PUT_LINE('});');
    DBMS_OUTPUT.PUT_LINE('/* ---- 4. tooltip over the grid and the full-span chart */');
    DBMS_OUTPUT.PUT_LINE('var tip=null;');
    DBMS_OUTPUT.PUT_LINE('function tipOn(html,e){if(!tip)return;tip.innerHTML=html;tip.hidden=false;place(e);}');
    DBMS_OUTPUT.PUT_LINE('function tipOff(){if(tip)tip.hidden=true;}');
    DBMS_OUTPUT.PUT_LINE('function place(e){');
    DBMS_OUTPUT.PUT_LINE('  var x=e.clientX+14,y=e.clientY+16,w=tip.offsetWidth,h=tip.offsetHeight;');
    DBMS_OUTPUT.PUT_LINE('  if(x+w>innerWidth-8)x=e.clientX-w-12;if(y+h>innerHeight-8)y=e.clientY-h-12;');
    DBMS_OUTPUT.PUT_LINE('  tip.style.left=Math.max(8,x)+''px'';tip.style.top=Math.max(8,y)+''px'';');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('/* per-series AAS rows, top of the stack first; names / colours from the');
    DBMS_OUTPUT.PUT_LINE('   payload (classes or events), vis = the legend state (null = all) */');
    DBMS_OUTPUT.PUT_LINE('function ashRows(names,cols,get,vis,noun,hl){');
    DBMS_OUTPUT.PUT_LINE('  var h='''',tot=0,hid=false,lead=[],hs=0;');
    DBMS_OUTPUT.PUT_LINE('  for(var c=names.length-1;c>=0;c--){if(vis&&!vis[c]){hid=true;continue;}var v=get(c);if(v==null)continue;tot+=v;');
    DBMS_OUTPUT.PUT_LINE('    if(hl&&hl[c]){lead.push([c,v]);hs+=v;continue;}');
    DBMS_OUTPUT.PUT_LINE('    if(v>=0.005)h+=''<div class="tr2"><span><i class="sw" style="--sw:''+cols[c]+''"></i>''+esc(names[c])+''</span><b>''+v.toFixed(2)+''</b></div>'';}');
    DBMS_OUTPUT.PUT_LINE('  /* a highlighted series leads (its share of the total beside it); several');
    DBMS_OUTPUT.PUT_LINE('     (a wait class''s events) add their sum */');
    DBMS_OUTPUT.PUT_LINE('  var pc=function(v){return tot>0?'' <span class="tpc">''+Math.round(v/tot*100)+''%</span>'':'''';},l='''';');
    DBMS_OUTPUT.PUT_LINE('  lead.forEach(function(x){l+=''<div class="tr2 thl"><span><i class="sw" style="--sw:''+cols[x[0]]+''"></i>''+esc(names[x[0]])+''</span><b>''+x[1].toFixed(2)+pc(x[1])+''</b></div>'';});');
    DBMS_OUTPUT.PUT_LINE('  if(lead.length>1)l+=''<div class="tr2 thl"><span>Highlighted, together</span><b>''+hs.toFixed(2)+pc(hs)+''</b></div>'';');
    DBMS_OUTPUT.PUT_LINE('  return (l?''<div class="thlb">''+l+''</div>'':'''')+h+''<div class="tr2 tsum"><span>''+(hid?''Total, shown ''+(noun||''classes''):''Total'')+''</span><b>''+tot.toFixed(1)+'' AAS</b></div>'';');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('function cellTip(cell){');
    DBMS_OUTPUT.PUT_LINE('  var row=cell.closest(''.r'');if(!row||!row.getAttribute(''data-name''))return '''';');
    DBMS_OUTPUT.PUT_LINE('  var o=+cell.getAttribute(''data-w''),w=winAt(o),i=idxOf(o);if(!w)return '''';');
    DBMS_OUTPUT.PUT_LINE('  var head=''<b>''+esc(row.getAttribute(''data-name''))+''</b><br><span class="tm">''+esc(w.t)+'', ''+offTxt(w)+(w.v===''N''?'', skipped window'':'''')+''</span><br>'';');
    DBMS_OUTPUT.PUT_LINE('  if(row.classList.contains(''ash'')&&AX&&AX.win)return head+ashRows(AX.classes,AX.classes.map(wcol),function(c){return AX.win[c][i];});');
    DBMS_OUTPUT.PUT_LINE('  if(row.classList.contains(''p''))return head+''<b>''+esc(cell.getAttribute(''data-pv'')||'''')+''</b>'';');
    DBMS_OUTPUT.PUT_LINE('  var v=nums(row.getAttribute(''data-v''))[i];');
    DBMS_OUTPUT.PUT_LINE('  if(v==null)return head+''<span class="tm">''+(row.classList.contains(''q'')||row.classList.contains(''o'')?''not in the top list in this window'':''no value in this window'')+''</span>'';');
    DBMS_OUTPUT.PUT_LINE('  var g=$(''.glf'',cell);');
    DBMS_OUTPUT.PUT_LINE('  return head+''<b>''+fmtNum(v)+''</b> ''+esc(row.getAttribute(''data-unit'')||'''')+(g?''<br>''+esc(g.title):'''')');
    DBMS_OUTPUT.PUT_LINE('    +($(''i.b.brk'',cell)?''<br><span class="tm">bar cut: more than 1.5&times; the tallest prior window</span>'':'''');');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('doc.addEventListener(''mouseover'',function(e){');
    DBMS_OUTPUT.PUT_LINE('  var t=e.target;if(!t||!t.closest||!tip)return;');
    DBMS_OUTPUT.PUT_LINE('  if(t.closest(''.ashx .axp''))return;');
    DBMS_OUTPUT.PUT_LINE('  var c=t.closest(''#tl .lrows .c[data-w]'');');
    DBMS_OUTPUT.PUT_LINE('  if(c){var s=cellTip(c);if(s){tipOn(s,e);return;}}');
    DBMS_OUTPUT.PUT_LINE('  tipOff();');
    DBMS_OUTPUT.PUT_LINE('});');
    DBMS_OUTPUT.PUT_LINE('doc.addEventListener(''mousemove'',function(e){if(tip&&!tip.hidden&&!(e.target.closest&&e.target.closest(''.ashx .axp'')))place(e);},{passive:true});');
    DBMS_OUTPUT.PUT_LINE('doc.addEventListener(''scroll'',tipOff,{passive:true});');
    DBMS_OUTPUT.PUT_LINE('/* ---- 5. stacked activity per window: the Activity lane and the DB time card */');
    DBMS_OUTPUT.PUT_LINE('function stack(row,vals,opt){');
    DBMS_OUTPUT.PUT_LINE('  var A=AX,np=wins().length,tot=[],mx=0;');
    DBMS_OUTPUT.PUT_LINE('  for(var i=0;i<np;i++){var s=0;A.classes.forEach(function(c,k){s+=vals[k][i]||0;});tot.push(s);if(s>mx)mx=s;}');
    DBMS_OUTPUT.PUT_LINE('  if(!(mx>0))return false;');
    DBMS_OUTPUT.PUT_LINE('  var step=niceStep(mx,3),max=mx*1.04,ticks=[];for(var t=step;t<=max+1e-9;t+=step)ticks.push(t);');
    DBMS_OUTPUT.PUT_LINE('  var bh=cssNum(row,''--bh'',148),bb=cssNum(row,''--bb'',6),GAP=2;');
    DBMS_OUTPUT.PUT_LINE('  $$('':scope > .c[data-w]'',row).forEach(function(c){');
    DBMS_OUTPUT.PUT_LINE('    var i=idxOf(c.getAttribute(''data-w''));if(i<0)return;');
    DBMS_OUTPUT.PUT_LINE('    $$(''.stk,.gline,.dl'',c).forEach(function(x){x.parentNode.removeChild(x);});');
    DBMS_OUTPUT.PUT_LINE('    ticks.forEach(function(t){var g=mk(''i'',''gline'',c);g.style.bottom=(bb+t/max*bh)+''px'';});');
    DBMS_OUTPUT.PUT_LINE('    var st=mk(''div'',''stk'',c),y=0,segs=[];');
    DBMS_OUTPUT.PUT_LINE('    A.classes.forEach(function(name,k){');
    DBMS_OUTPUT.PUT_LINE('      var v=vals[k][i]||0,h=v/max*bh;if(h<0.4)return;');
    DBMS_OUTPUT.PUT_LINE('      var s=mk(''i'','''',st);s.style.background=wcol(name);s.style.bottom=y+''px'';s.style.height=Math.max(0.6,h-(h>4?GAP:0))+''px'';');
    DBMS_OUTPUT.PUT_LINE('      segs.push({n:name,v:v,mid:y+h/2});y+=h;');
    DBMS_OUTPUT.PUT_LINE('    });');
    DBMS_OUTPUT.PUT_LINE('    if(c.classList.contains(''cur'')&&opt.labels){');
    DBMS_OUTPUT.PUT_LINE('      var last=-99;');
    DBMS_OUTPUT.PUT_LINE('      segs.slice().sort(function(a,b){return b.v-a.v;}).slice(0,2).sort(function(a,b){return a.mid-b.mid;}).forEach(function(s){');
    DBMS_OUTPUT.PUT_LINE('        if(s.v/max*bh<8)return;');
    DBMS_OUTPUT.PUT_LINE('        var pos=Math.max(s.mid,last+16);last=pos;');
    DBMS_OUTPUT.PUT_LINE('        var d=mk(''span'',''dl'',c);d.innerHTML=''<i class="sw" style="--sw:''+wcol(s.n)+''"></i>''+aasTxt(s.v);d.title=s.n;d.style.bottom=(bb+pos)+''px'';');
    DBMS_OUTPUT.PUT_LINE('      });');
    DBMS_OUTPUT.PUT_LINE('    }');
    DBMS_OUTPUT.PUT_LINE('  });');
    DBMS_OUTPUT.PUT_LINE('  var ax=$(''.axn'',row);');
    DBMS_OUTPUT.PUT_LINE('  if(ax){ax.innerHTML='''';[0].concat(ticks).forEach(function(t){var i=mk(''i'','''',ax);i.textContent=t;i.style.bottom=(bb+t/max*bh)+''px'';});}');
    DBMS_OUTPUT.PUT_LINE('  return true;');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('function activity(){');
    DBMS_OUTPUT.PUT_LINE('  if(!AX||!AX.win||!AX.classes.length)return;');
    DBMS_OUTPUT.PUT_LINE('  $$(''#tl .r.ash'').forEach(function(row){stack(row,AX.win,{labels:true});});');
    DBMS_OUTPUT.PUT_LINE('  /* the DB time card: FOREGROUND ASH per window, stacked by wait class.');
    DBMS_OUTPUT.PUT_LINE('     DB time is foreground time and ASH''s foreground samples are its');
    DBMS_OUTPUT.PUT_LINE('     sampled estimate, so the bars measure what the headline measures;');
    DBMS_OUTPUT.PUT_LINE('     the Current value printed stays the card''s DB time. */');
    DBMS_OUTPUT.PUT_LINE('  var row=$(''#f-dbtime .fc-main .wg .r.bars'');if(!row)return;');
    DBMS_OUTPUT.PUT_LINE('  var W=AX.winfg||AX.win,np=wins().length,cur=[];');
    DBMS_OUTPUT.PUT_LINE('  AX.classes.forEach(function(c,k){cur.push([c,W[k][np-1]||0,k]);});');
    DBMS_OUTPUT.PUT_LINE('  cur.sort(function(a,b){return b[1]-a[1];});');
    DBMS_OUTPUT.PUT_LINE('  row.classList.remove(''bars'');row.classList.add(''ash'');');
    DBMS_OUTPUT.PUT_LINE('  if(!stack(row,W,{labels:true})){row.classList.remove(''ash'');row.classList.add(''bars'');return;}');
    DBMS_OUTPUT.PUT_LINE('  var tot=0;cur.forEach(function(x){tot+=x[1];});');
    DBMS_OUTPUT.PUT_LINE('  $$('':scope > .c'',row).forEach(function(c){var v=$(''.v'',c);if(v&&!c.classList.contains(''cur''))v.parentNode.removeChild(v);});');
    DBMS_OUTPUT.PUT_LINE('  $$('':scope > .c > i'',row).forEach(function(x){x.parentNode.removeChild(x);});');
    DBMS_OUTPUT.PUT_LINE('  var ul=doc.createElement(''ul'');ul.className=''leg fcleg'';ul.setAttribute(''aria-label'',''Foreground active sessions by wait class, ASH'');');
    DBMS_OUTPUT.PUT_LINE('  ul.innerHTML=cur.filter(function(x){return x[1]>0;}).map(function(x){return ''<li><i class="sw" style="--sw:''+wcol(x[0])+''"></i>''+esc(x[0])+''</li>'';}).join('''');');
    DBMS_OUTPUT.PUT_LINE('  var wg=row.closest(''.wg'');wg.parentNode.insertBefore(ul,wg);');
    DBMS_OUTPUT.PUT_LINE('  wg.title=''Foreground active sessions (ASH, a sampled estimate of DB time) per compared window, stacked by wait class; Current ''+tot.toFixed(2)+'' AAS in ASH. The Current value is the DB time headline.'';');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('/* ---- 5b. plan 041: the busiest minute per window (AWR_DATA.ashx.pk =');
    DBMS_OUTPUT.PUT_LINE('   [[week_offset, AAS, "YYYY-MM-DD HH:MI"], ...], null = unknown; all');
    DBMS_OUTPUT.PUT_LINE('   sessions, from 09''s 1-minute ASH).  Informational, never scored.');
    DBMS_OUTPUT.PUT_LINE('   pkInfo(pk, ws) (pure, unit-tested): the Current value and minute, the');
    DBMS_OUTPUT.PUT_LINE('   lowest / highest / mean of the VALID prior windows'' known values, null');
    DBMS_OUTPUT.PUT_LINE('   without a Current value.  pkText(i, wh): the sentence. */');
    DBMS_OUTPUT.PUT_LINE('function pkFmt(v){return v>=100?String(Math.round(v)):v.toFixed(1);}');
    DBMS_OUTPUT.PUT_LINE('function pkAt(t,wh){return wh>=24?fAt(PT(t)):String(t).slice(11);}');
    DBMS_OUTPUT.PUT_LINE('TL.pkInfo=function(pk,ws){');
    DBMS_OUTPUT.PUT_LINE('  if(!pk||!pk.length)return null;');
    DBMS_OUTPUT.PUT_LINE('  var by={};pk.forEach(function(e){if(e&&e[1]!=null)by[e[0]]=e;});');
    DBMS_OUTPUT.PUT_LINE('  var c=by[0];if(!c)return null;');
    DBMS_OUTPUT.PUT_LINE('  var lo=null,hi=null,s=0,n=0;');
    DBMS_OUTPUT.PUT_LINE('  (ws||[]).forEach(function(w){');
    DBMS_OUTPUT.PUT_LINE('    if(w.o===0||w.v===''N'')return;var e=by[w.o];if(!e)return;');
    DBMS_OUTPUT.PUT_LINE('    var v=e[1];if(lo===null||v<lo)lo=v;if(hi===null||v>hi)hi=v;s+=v;n++;');
    DBMS_OUTPUT.PUT_LINE('  });');
    DBMS_OUTPUT.PUT_LINE('  return {aas:c[1],at:c[2],lo:lo,hi:hi,mu:n?s/n:null,n:n};');
    DBMS_OUTPUT.PUT_LINE('};');
    DBMS_OUTPUT.PUT_LINE('TL.pkText=function(i,wh){');
    DBMS_OUTPUT.PUT_LINE('  var t=pkFmt(i.aas)+'' active sessions at ''+pkAt(i.at,wh);');
    DBMS_OUTPUT.PUT_LINE('  if(!i.n)return t;');
    DBMS_OUTPUT.PUT_LINE('  var lo=pkFmt(i.lo),hi=pkFmt(i.hi);');
    DBMS_OUTPUT.PUT_LINE('  return t+''; ''+(i.n===1?''the prior window\u2019s busiest minute '':''prior windows\u2019 busiest minutes '')+(lo===hi?lo:lo+''\u2013''+hi);');
    DBMS_OUTPUT.PUT_LINE('};');
    DBMS_OUTPUT.PUT_LINE('/* the DB time card''s evidence row (only with the card and a Current value) */');
    DBMS_OUTPUT.PUT_LINE('function pkCard(){');
    DBMS_OUTPUT.PUT_LINE('  var card=$(''#f-dbtime'');if(!card||!AX)return;');
    DBMS_OUTPUT.PUT_LINE('  var I=TL.pkInfo(AX.pk,wins());if(!I)return;');
    DBMS_OUTPUT.PUT_LINE('  var dl=$(''dl.ev'',card);');
    DBMS_OUTPUT.PUT_LINE('  if(!dl){var fb=$(''.fc-b'',card);if(!fb)return;dl=mk(''dl'',''ev'',fb);}');
    DBMS_OUTPUT.PUT_LINE('  var r=mk(''div'',''evr ev-pk'',dl);');
    DBMS_OUTPUT.PUT_LINE('  r.title=''Busiest minute of the window: ASH, all sessions, one sample every 10 s (six samples per active session in a minute, so the value moves in steps of 1/6); the window values above are averages. Not scored.'';');
    DBMS_OUTPUT.PUT_LINE('  r.innerHTML=''<dt>Peak</dt><dd><span class="id txt">Busiest minute</span><span class="de">''+esc(TL.pkText(I,AX.wh))+''</span></dd>''');
    DBMS_OUTPUT.PUT_LINE('    +''<div class="m">''+(I.mu!=null?''<span class="d s-plain" title="Current busiest minute against the mean of the prior windows\u2019 busiest minutes">''+delta(I.aas,I.mu)+''</span>'':'''')+''</div>'';');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('/* the window stripe tooltip''s line: that window''s busiest minute */');
    DBMS_OUTPUT.PUT_LINE('function pkTip(o){');
    DBMS_OUTPUT.PUT_LINE('  var e=null;((AX&&AX.pk)||[]).forEach(function(x){if(x[0]===o)e=x;});');
    DBMS_OUTPUT.PUT_LINE('  if(!e||e[1]==null)return '''';');
    DBMS_OUTPUT.PUT_LINE('  return ''<div class="tr2 tpk"><span>Busiest minute, all sessions</span><b>''+pkFmt(e[1])+'' AAS at ''+esc(pkAt(e[2],AX.wh))+''</b></div>'';');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('/* ---- 5c. plan 042: CPU capacity (AWR_DATA.ashx.cpu = {n: [cpu_count per');
    DBMS_OUTPUT.PUT_LINE('   window, oldest first, null = unknown], used: [DB CPU AAS per window],');
    DBMS_OUTPUT.PUT_LINE('   cur: {n, used, pct, ash}}, ash = the Current window''s foreground ASH on');
    DBMS_OUTPUT.PUT_LINE('   CPU).  Informational, never scored.  cpuInfo(cpu) (pure, unit-tested):');
    DBMS_OUTPUT.PUT_LINE('   null without a Current cpu_count and DB CPU; wait = ASH on CPU minus DB');
    DBMS_OUTPUT.PUT_LINE('   CPU when it passes CPUQ (10 % of DB CPU) AND CPUQA (0.5 AAS), else null');
    DBMS_OUTPUT.PUT_LINE('   (ASH counts a session on CPU while it waits in the run queue too); bound');
    DBMS_OUTPUT.PUT_LINE('   = DB CPU at or above CPUB (90 %) of cpu_count; changed = the windows''');
    DBMS_OUTPUT.PUT_LINE('   known cpu_count values differ.  cpuText(i): the card row''s sentence. */');
    DBMS_OUTPUT.PUT_LINE('var CPUQ=0.1,CPUQA=0.5,CPUB=0.9;');
    DBMS_OUTPUT.PUT_LINE('function cpuFmt(v){return v>=100?String(Math.round(v)):v>=0.1?v.toFixed(1):v.toFixed(2);}');
    DBMS_OUTPUT.PUT_LINE('TL.cpuInfo=function(cpu){');
    DBMS_OUTPUT.PUT_LINE('  var c=cpu&&cpu.cur;if(!c||!(c.n>0)||c.used==null)return null;');
    DBMS_OUTPUT.PUT_LINE('  var ash=c.ash==null?null:c.ash,d=ash==null?null:ash-c.used,lo=null,hi=null;');
    DBMS_OUTPUT.PUT_LINE('  (cpu.n||[]).forEach(function(v){if(v==null)return;if(lo===null||v<lo)lo=v;if(hi===null||v>hi)hi=v;});');
    DBMS_OUTPUT.PUT_LINE('  return {n:c.n,used:c.used,pct:c.used/c.n*100,ash:ash,wait:d!=null&&d>=CPUQ*c.used&&d>=CPUQA?d:null,');
    DBMS_OUTPUT.PUT_LINE('          bound:c.used>=CPUB*c.n,changed:lo!==null&&lo!==hi,lo:lo,hi:hi};');
    DBMS_OUTPUT.PUT_LINE('};');
    DBMS_OUTPUT.PUT_LINE('TL.cpuText=function(i){');
    DBMS_OUTPUT.PUT_LINE('  var p=Math.round(i.pct),t=''DB CPU ''+cpuFmt(i.used)+'' of cpu_count ''+i.n+'' (''+(p<1&&i.pct>0?''<1'':p)+''%)'';');
    DBMS_OUTPUT.PUT_LINE('  if(i.wait!=null)t+=''; ASH saw ''+cpuFmt(i.ash)+'' on CPU, so about ''+cpuFmt(i.wait)+'' sessions were waiting for a CPU'';');
    DBMS_OUTPUT.PUT_LINE('  if(i.bound)t+=''; CPU-bound'';');
    DBMS_OUTPUT.PUT_LINE('  return t;');
    DBMS_OUTPUT.PUT_LINE('};');
    DBMS_OUTPUT.PUT_LINE('/* the DB time card''s capacity row (only with the card and a Current');
    DBMS_OUTPUT.PUT_LINE('   cpu_count and DB CPU), after the busiest-minute row */');
    DBMS_OUTPUT.PUT_LINE('function cpuCard(){');
    DBMS_OUTPUT.PUT_LINE('  var card=$(''#f-dbtime'');if(!card||!AX)return;');
    DBMS_OUTPUT.PUT_LINE('  var I=TL.cpuInfo(AX.cpu);if(!I)return;');
    DBMS_OUTPUT.PUT_LINE('  var dl=$(''dl.ev'',card);');
    DBMS_OUTPUT.PUT_LINE('  if(!dl){var fb=$(''.fc-b'',card);if(!fb)return;dl=mk(''dl'',''ev'',fb);}');
    DBMS_OUTPUT.PUT_LINE('  var r=mk(''div'',''evr ev-cpu'',dl);');
    DBMS_OUTPUT.PUT_LINE('  r.title=''cpu_count (DBA_HIST_PARAMETER, the Current window\u2019s end snapshot) = the CPU threads the instance may use, or the instance-caging limit; DB CPU = the time model\u2019s foreground CPU time over the window.''');
    DBMS_OUTPUT.PUT_LINE('    +'' ASH counts a session on CPU also while it waits for a CPU, so ASH on CPU clearly above DB CPU means a run queue; ASH is a sample (one every 10 s).''');
    DBMS_OUTPUT.PUT_LINE('    +(I.changed?'' cpu_count changed across the compared windows (''+I.lo+''\u2013''+I.hi+'').'':'''')+'' Not scored.'';');
    DBMS_OUTPUT.PUT_LINE('  r.innerHTML=''<dt>CPU</dt><dd><span class="id txt">Capacity</span><span class="de">''+esc(TL.cpuText(I))+''</span></dd><div class="m"></div>'';');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('/* the Current cpu_count as a dashed line on the by-wait-class chart, only');
    DBMS_OUTPUT.PUT_LINE('   when it lies inside the y range [0, ymax] (the axis is never stretched to');
    DBMS_OUTPUT.PUT_LINE('   reach it: 64 CPUs over 6 AAS would flatten the chart); its label at the');
    DBMS_OUTPUT.PUT_LINE('   right end, above the line (below it when that leaves the plot or meets');
    DBMS_OUTPUT.PUT_LINE('   the highlight note nb).  {s: svg, box: the label''s box and a strip along');
    DBMS_OUTPUT.PUT_LINE('   the line, for dlab to avoid} or null; c.cpuUp = cpu_count above the range. */');
    DBMS_OUTPUT.PUT_LINE('function cpuMark(c,Y,ymax,x0,x1,top,ph,nb){');
    DBMS_OUTPUT.PUT_LINE('  var I=c.cpu;c.cpuUp=false;if(!I)return null;');
    DBMS_OUTPUT.PUT_LINE('  if(I.n>ymax+1e-9){c.cpuUp=true;return null;}');
    DBMS_OUTPUT.PUT_LINE('  var y=Y(I.n),lb=''cpu_count ''+I.n+(I.changed?'', changed'':''''),w=tw(lb),xr=x1-4,pick=null;');
    DBMS_OUTPUT.PUT_LINE('  [[y-4,[xr-w,y-14,xr,y-3]],[y+12,[xr-w,y+2,xr,y+13]]].forEach(function(q){');
    DBMS_OUTPUT.PUT_LINE('    var b=q[1];if(pick||b[1]<top-4||b[3]>top+ph)return;');
    DBMS_OUTPUT.PUT_LINE('    if(nb&&b[0]<nb[2]&&b[2]>nb[0]&&b[1]<nb[3]&&b[3]>nb[1])return;pick=q;});');
    DBMS_OUTPUT.PUT_LINE('  var s=''<line class="xcpu" x1="''+x0+''" x2="''+x1+''" y1="''+y.toFixed(1)+''" y2="''+y.toFixed(1)+''"/>'';');
    DBMS_OUTPUT.PUT_LINE('  if(pick)s+=''<text class="xcpt" x="''+xr.toFixed(1)+''" y="''+pick[0].toFixed(1)+''" text-anchor="end">''+esc(lb)+''</text>'';');
    DBMS_OUTPUT.PUT_LINE('  var box=[[x0,y-1,x1,y+1]];if(pick)box.push(pick[1]);');
    DBMS_OUTPUT.PUT_LINE('  return {s:s,box:box};');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('/* the header''s note when cpu_count is above the class chart''s y range');
    DBMS_OUTPUT.PUT_LINE('   (hidden when the line is drawn, without cpu data, or the chart is not shown) */');
    DBMS_OUTPUT.PUT_LINE('function cpuHead(){');
    DBMS_OUTPUT.PUT_LINE('  var el=SP&&SP.cpuEl,c=CH[0];if(!el)return;');
    DBMS_OUTPUT.PUT_LINE('  var on=!!(c&&c.cpu&&c.cpuUp&&shown(c.plot));el.hidden=!on;');
    DBMS_OUTPUT.PUT_LINE('  if(on)el.textContent=''cpu_count ''+c.cpu.n+(c.cpu.changed?'' (changed)'':'''')+'', above this scale'';');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('/* ---- 6. Activity, whole span (section#activity, first in Timeline / All');
    DBMS_OUTPUT.PUT_LINE('   sections, under the verdict in Summary, compact there): one');
    DBMS_OUTPUT.PUT_LINE('   chart factory, two instances over one time axis -- by wait class');
    DBMS_OUTPUT.PUT_LINE('   (AWR_DATA.ashx) and by wait event (AWR_DATA.ashe).  Linked: a zoom on');
    DBMS_OUTPUT.PUT_LINE('   either zooms both, the hover crosshair is mirrored, the pinned window');
    DBMS_OUTPUT.PUT_LINE('   (AWR_WG.pin) is the same stripe in both.  Hover, legend, brush zoom,');
    DBMS_OUTPUT.PUT_LINE('   Reset / double-click, window stripes, release markers in each.');
    DBMS_OUTPUT.PUT_LINE('   Series highlight: a legend entry hovered or keyboard-focused (or a');
    DBMS_OUTPUT.PUT_LINE('   sticky one) is drawn from zero with the y axis fitted to it, the other');
    DBMS_OUTPUT.PUT_LINE('   series faded on top; the series under the pointer in the plot is');
    DBMS_OUTPUT.PUT_LINE('   highlighted in place (no re-stacking, so it cannot slide away from the');
    DBMS_OUTPUT.PUT_LINE('   pointer).  Linked through ashe.ecls (each event''s wait class): a class');
    DBMS_OUTPUT.PUT_LINE('   highlights its events in the event chart, an event its class, lightly,');
    DBMS_OUTPUT.PUT_LINE('   in the class chart.  Sticky: a click on a band in the plot or');
    DBMS_OUTPUT.PUT_LINE('   Shift+click / Shift+Enter on a legend entry; the same again, a click');
    DBMS_OUTPUT.PUT_LINE('   off the stack or Esc clears it (the next Esc unpins the window). */');
    DBMS_OUTPUT.PUT_LINE('var AX=null,AE=null,CH=[],SP=null,DRAG=null,cvs=null;');
    DBMS_OUTPUT.PUT_LINE('/* Summary opens the charts compact (SP.cmp): the by-class chart only, a');
    DBMS_OUTPUT.PUT_LINE('   shorter plot with its own date labels; #ax-more shows the by-event chart.');
    DBMS_OUTPUT.PUT_LINE('   The reader''s choice is kept in localStorage awr-ax, written on a click. */');
    DBMS_OUTPUT.PUT_LINE('function cmp(){return !!(SP&&SP.cmp)&&doc.body.classList.contains(''vs'');}');
    DBMS_OUTPUT.PUT_LINE('function axMore(b){b.setAttribute(''aria-expanded'',String(!SP.cmp));b.textContent=SP.cmp?''Show by wait event'':''Hide by wait event'';}');
    DBMS_OUTPUT.PUT_LINE('/* the highlight: HS sticky, HT passing (legend hover / focus, or soft =');
    DBMS_OUTPUT.PUT_LINE('   the plot hover), each {c: chart, k: series}; HT wins while it lasts */');
    DBMS_OUTPUT.PUT_LINE('var HS=null,HT=null;');
    DBMS_OUTPUT.PUT_LINE('function hlSame(a,b){return a===b||!!(a&&b&&a.c===b.c&&a.k===b.k&&!!a.soft===!!b.soft);}');
    DBMS_OUTPUT.PUT_LINE('function hlSet(t){if(hlSame(HT,t))return;HT=t;hlApply();}');
    DBMS_OUTPUT.PUT_LINE('function hlStick(c,k){HS=(k<0||(HS&&HS.c===c&&HS.k===k))?null:{c:c,k:k};HT=null;hlApply();}');
    DBMS_OUTPUT.PUT_LINE('function hlEsc(){if(!HS&&!HT)return false;HS=null;HT=null;hlApply();return true;}');
    DBMS_OUTPUT.PUT_LINE('/* each chart''s c.hl = {set: {series: 1}, strong: re-based + fitted, fade:');
    DBMS_OUTPUT.PUT_LINE('   the others'' opacity, note}; redraw only the charts whose state changed */');
    DBMS_OUTPUT.PUT_LINE('function hlApply(){');
    DBMS_OUTPUT.PUT_LINE('  var E=HT||HS;');
    DBMS_OUTPUT.PUT_LINE('  CH.forEach(function(c){c.hl=null;});');
    DBMS_OUTPUT.PUT_LINE('  if(E&&E.c.vis[E.k]){');
    DBMS_OUTPUT.PUT_LINE('    var s=E.c,strong=!E.soft,nm=s.P.classes[E.k],one={},m=s.xmap&&s.xmap[E.k],o=s.peer;');
    DBMS_OUTPUT.PUT_LINE('    var tail=E===HS?'' \u00b7 Esc clears'':'''';');
    DBMS_OUTPUT.PUT_LINE('    one[E.k]=1;');
    DBMS_OUTPUT.PUT_LINE('    s.hl={set:one,strong:strong,fade:strong?0.12:0.3,note:strong?nm+'' drawn from zero, y axis fitted to it''+tail:''''};');
    DBMS_OUTPUT.PUT_LINE('    if(o&&m&&m.length){');
    DBMS_OUTPUT.PUT_LINE('      var set={};m.forEach(function(q){set[q]=1;});');
    DBMS_OUTPUT.PUT_LINE('      var on1=m.length===1&&o.P.classes[m[0]]===nm;');
    DBMS_OUTPUT.PUT_LINE('      o.hl=s===CH[0]?{set:set,strong:strong,fade:strong?0.12:0.3,note:strong?(on1?nm+'' drawn from zero, y axis fitted to it'':''The ''+nm+'' events drawn from zero, y axis fitted to them'')+tail:''''}');
    DBMS_OUTPUT.PUT_LINE('                    :{set:set,strong:false,fade:0.35,note:''''};');
    DBMS_OUTPUT.PUT_LINE('    }');
    DBMS_OUTPUT.PUT_LINE('  }');
    DBMS_OUTPUT.PUT_LINE('  CH.forEach(function(c){');
    DBMS_OUTPUT.PUT_LINE('    var h=c.hl,key=h?Object.keys(h.set).join('','')+''|''+h.strong+''|''+h.fade+''|''+h.note:'''';');
    DBMS_OUTPUT.PUT_LINE('    if(c.lg){c.lg.classList.toggle(''hlon'',!!h);$$(''.axc'',c.lg).forEach(function(b){b.classList.toggle(''hl'',!!(h&&h.set[+b.getAttribute(''data-c'')]));});}');
    DBMS_OUTPUT.PUT_LINE('    if(key!==c.hk){c.hk=key;draw(c,true);}');
    DBMS_OUTPUT.PUT_LINE('  });');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('/* a client point in chart c''s SVG units (its viewBox), and back, through');
    DBMS_OUTPUT.PUT_LINE('   the SVG''s screen CTM (review follow-up R3): narrower than 480 px the');
    DBMS_OUTPUT.PUT_LINE('   viewBox stays 480 wide, so the fixed-height SVG scales it down and');
    DBMS_OUTPUT.PUT_LINE('   centres it vertically (preserveAspectRatio): clientY times W / width');
    DBMS_OUTPUT.PUT_LINE('   alone missed that letterbox, and hover, click and the soft highlight');
    DBMS_OUTPUT.PUT_LINE('   picked the wrong band.  Without a CTM (not rendered) the plain scale. */');
    DBMS_OUTPUT.PUT_LINE('function ctm(c,inv){var m=null;try{m=c.svg.getScreenCTM();if(m&&inv)m=m.inverse();}catch(e){m=null;}return m&&isFinite(m.a)&&m.a?m:null;}');
    DBMS_OUTPUT.PUT_LINE('function toSvg(c,cx,cy){var m=ctm(c,true);if(m)return {x:m.a*cx+m.c*cy+m.e,y:m.b*cx+m.d*cy+m.f};');
    DBMS_OUTPUT.PUT_LINE('  var r=c.svg.getBoundingClientRect(),k=c.g.W/r.width;return {x:(cx-r.left)*k,y:(cy-r.top)*k};}');
    DBMS_OUTPUT.PUT_LINE('function toCli(c,x,y){var m=ctm(c,false);if(m)return {x:m.a*x+m.c*y+m.e,y:m.b*x+m.d*y+m.f};');
    DBMS_OUTPUT.PUT_LINE('  var r=c.svg.getBoundingClientRect(),k=r.width/c.g.W;return {x:r.left+x*k,y:r.top+y*k};}');
    DBMS_OUTPUT.PUT_LINE('/* the series whose DRAWN band holds (sx, v), sx in SVG units, v in the');
    DBMS_OUTPUT.PUT_LINE('   chart''s value units, or -1 (off the stack): the band paths join the');
    DBMS_OUTPUT.PUT_LINE('   points pts (colPts: [x, ref, ...]) with straight lines, so the stack at');
    DBMS_OUTPUT.PUT_LINE('   sx is the linear mix of the two points around it, in the drawn order');
    DBMS_OUTPUT.PUT_LINE('   ord (zoomed out, a point is its pixel column''s busiest bucket, not the');
    DBMS_OUTPUT.PUT_LINE('   bucket under sx: the tooltip reads that one).  vk(k, ref) = series k''s');
    DBMS_OUTPUT.PUT_LINE('   value.  Pure: AWR_TL.stackAt, unit-tested (review follow-up R3). */');
    DBMS_OUTPUT.PUT_LINE('function stackAt(pts,ord,vk,sx,v){');
    DBMS_OUTPUT.PUT_LINE('  var n=pts?pts.length:0;if(!n||sx<pts[0][0]||sx>pts[n-1][0]||v<0)return -1;');
    DBMS_OUTPUT.PUT_LINE('  var lo=0,hi=n-1;while(hi-lo>1){var md=(lo+hi)>>1;if(pts[md][0]<=sx)lo=md;else hi=md;}');
    DBMS_OUTPUT.PUT_LINE('  var a=pts[lo],b=pts[hi],f=b[0]>a[0]?(sx-a[0])/(b[0]-a[0]):0,acc=0;');
    DBMS_OUTPUT.PUT_LINE('  for(var q=0;q<ord.length;q++){var k=ord[q],u=(vk(k,a[1])||0)*(1-f)+(vk(k,b[1])||0)*f;if(u<=0)continue;acc+=u;if(v<=acc)return k;}');
    DBMS_OUTPUT.PUT_LINE('  return -1;');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('TL.stackAt=stackAt;');
    DBMS_OUTPUT.PUT_LINE('/* the series drawn under client point (x, y) on chart c, or -1: the point');
    DBMS_OUTPUT.PUT_LINE('   in SVG units (toSvg), then the band drawn there (stackAt; side by side');
    DBMS_OUTPUT.PUT_LINE('   the points of the panel under x) */');
    DBMS_OUTPUT.PUT_LINE('function seriesAt(c,x,y){');
    DBMS_OUTPUT.PUT_LINE('  if(!c.g||!c.g.ord)return -1;');
    DBMS_OUTPUT.PUT_LINE('  var p=toSvg(c,x,y),pts=c.g.pts;');
    DBMS_OUTPUT.PUT_LINE('  if(p.y<c.g.top||p.y>c.g.top+c.g.ph)return -1;');
    DBMS_OUTPUT.PUT_LINE('  if(c.g.mode===''win''){pts=null;c.g.pan.forEach(function(pn){if(p.x>=pn.x0&&p.x<pn.x0+pn.w)pts=pn.pts;});}');
    DBMS_OUTPUT.PUT_LINE('  else if(p.x<c.g.padL||p.x>c.g.W-c.g.padR)return -1;');
    DBMS_OUTPUT.PUT_LINE('  return stackAt(pts,c.g.ord,function(k,r){return rV(c,k,r);},p.x,(c.g.top+c.g.ph-p.y)/c.g.ph*c.g.ymax);');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('/* the event palette: 15 categorical hues, the first 13 (all a chart can');
    DBMS_OUTPUT.PUT_LINE('   use: 14 events, CPU among them) well apart, readable on both themes, no');
    DBMS_OUTPUT.PUT_LINE('   green (CPU keeps the wait-class CPU green, "Other events" a fixed grey) */');
    DBMS_OUTPUT.PUT_LINE('var EVP=[''#4E79A7'',''#F28E2B'',''#E15759'',''#76B7B2'',''#EDC948'',''#B07AA1'',''#FF9DA7'',''#9C755F'',''#A0CBE8'',''#D37295'',''#17BECF'',''#B6992D'',''#7F3C8D'',''#FFBE7D'',''#499894''],EVO=''#9AA3AD'';');
    DBMS_OUTPUT.PUT_LINE('function evColors(names){var j=0;return names.map(function(n){if(n===''CPU'')return wcol(''CPU'');if(n===''Other events'')return EVO;return EVP[(j++)%EVP.length];});}');
    DBMS_OUTPUT.PUT_LINE('/* a bucket''s length as text: 15-min, 1-hour, 2-hour, 0.75 h = 45-min */');
    DBMS_OUTPUT.PUT_LINE('function bLab(h){return h<1&&Math.abs(h*60-Math.round(h*60))<1e-6?Math.round(h*60)+''-min'':(Math.round(h*100)/100)+''-hour'';}');
    DBMS_OUTPUT.PUT_LINE('/* the 1-minute detail (ashx.fine / ashe.fine): when the view is FMAX or');
    DBMS_OUTPUT.PUT_LINE('   narrower and overlaps a compared window, the minutes inside the windows');
    DBMS_OUTPUT.PUT_LINE('   replace the coarse buckets they overlap; zoomed that far the brush may');
    DBMS_OUTPUT.PUT_LINE('   go down to FMIN.  A bucket is a ref: coarse i >= 0, 1-minute j = -1 - j. */');
    DBMS_OUTPUT.PUT_LINE('var FMAX=6*H1,FMIN=30*6e4;');
    DBMS_OUTPUT.PUT_LINE('function rS(r){return r>=0?SP.T[r]:SP.F.T[-1-r];}');
    DBMS_OUTPUT.PUT_LINE('function rE(r){return r>=0?SP.T1[r]:Math.min(SP.F.T[-1-r]+SP.F.bm,SP.full[1]);}');
    DBMS_OUTPUT.PUT_LINE('function rV(c,k,r){return r>=0?c.P.vals[k][r]:c.FV[k][-1-r];}');
    DBMS_OUTPUT.PUT_LINE('/* a fine series: integer samples a minute, -k = k zero minutes; AAS = n / div */');
    DBMS_OUTPUT.PUT_LINE('function unRle(a,n,div){if(!a||!a.length)return null;var o=[],i,z,x;for(i=0;i<a.length;i++){x=+a[i];if(x<0){for(z=0;z<-x;z++)o.push(0);}else o.push(x/div);}return o.length===n?o:null;}');
    DBMS_OUTPUT.PUT_LINE('function fineInit(f){');
    DBMS_OUTPUT.PUT_LINE('  if(!f||!f.segs||!f.segs.length||!(f.bm>0))return null;');
    DBMS_OUTPUT.PUT_LINE('  var bm=f.bm*6e4,T=[],S=[];');
    DBMS_OUTPUT.PUT_LINE('  f.segs.forEach(function(g){var a=SP.t0+g[0]*6e4;S.push([a,a+g[1]*bm,T.length]);for(var q=0;q<g[1];q++)T.push(a+q*bm);});');
    DBMS_OUTPUT.PUT_LINE('  return {T:T,S:S,bm:bm,div:6*f.bm,capped:!!f.capped};');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('function fineVals(P){');
    DBMS_OUTPUT.PUT_LINE('  var f=P.fine,F=SP.F;if(!F||!f||!f.vals||f.vals.length!==P.classes.length)return null;');
    DBMS_OUTPUT.PUT_LINE('  var o=f.vals.map(function(a){return unRle(a,F.T.length,F.div);});');
    DBMS_OUTPUT.PUT_LINE('  return o.some(function(a){return !a;})?null:o;');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('/* the time the segments cover in [a, b) */');
    DBMS_OUTPUT.PUT_LINE('function fineCov(a,b){var F=SP.F,v=0;if(!F)return 0;F.S.forEach(function(g){var x=Math.max(a,g[0]),y=Math.min(b,g[1]);if(y>x)v+=y-x;});return v;}');
    DBMS_OUTPUT.PUT_LINE('function fineOn(a,b){return !!SP.F&&b-a<=FMAX+1&&fineCov(a,b)>0;}');
    DBMS_OUTPUT.PUT_LINE('/* the buckets drawn for [d0, d1], in time order, a bucket or two past each');
    DBMS_OUTPUT.PUT_LINE('   edge so the lines run out of the plot */');
    DBMS_OUTPUT.PUT_LINE('function refs(d0,d1){');
    DBMS_OUTPUT.PUT_LINE('  var key=d0+''|''+d1;if(SP.rk===key)return SP.rv;');
    DBMS_OUTPUT.PUT_LINE('  var br=bRange(d0,d1),n=SP.T.length,i0=Math.max(0,br[0]-1),i1=Math.min(n-1,br[1]+1),out=[],i;');
    DBMS_OUTPUT.PUT_LINE('  if(!fineOn(d0,d1)){for(i=i0;i<=i1;i++)out.push(i);}');
    DBMS_OUTPUT.PUT_LINE('  else{');
    DBMS_OUTPUT.PUT_LINE('    var F=SP.F,fl=[],cl=[],pa=d0-2*SP.bh,pb=d1+2*SP.bh;');
    DBMS_OUTPUT.PUT_LINE('    F.S.forEach(function(g){');
    DBMS_OUTPUT.PUT_LINE('      if(g[1]<=pa||g[0]>=pb)return;');
    DBMS_OUTPUT.PUT_LINE('      var nb=Math.round((g[1]-g[0])/F.bm),ja=Math.max(0,Math.floor((pa-g[0])/F.bm)),jb=Math.min(nb-1,Math.ceil((pb-g[0])/F.bm));');
    DBMS_OUTPUT.PUT_LINE('      for(var j=ja;j<=jb;j++)fl.push(-1-(g[2]+j));');
    DBMS_OUTPUT.PUT_LINE('    });');
    DBMS_OUTPUT.PUT_LINE('    for(i=i0;i<=i1;i++){var a=SP.T[i],b=SP.T1[i];if(!F.S.some(function(g){return g[0]<b&&g[1]>a;}))cl.push(i);}');
    DBMS_OUTPUT.PUT_LINE('    var p=0,q=0;while(p<cl.length||q<fl.length){if(q>=fl.length||(p<cl.length&&rS(cl[p])<rS(fl[q])))out.push(cl[p++]);else out.push(fl[q++]);}');
    DBMS_OUTPUT.PUT_LINE('  }');
    DBMS_OUTPUT.PUT_LINE('  SP.rk=key;SP.rv=out;return out;');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('/* the ref under time t (fine inside a window when the view shows the detail) */');
    DBMS_OUTPUT.PUT_LINE('function refAt(t){');
    DBMS_OUTPUT.PUT_LINE('  var F=SP.F;');
    DBMS_OUTPUT.PUT_LINE('  if(F&&fineOn(SP.dom[0],SP.dom[1]))for(var q=0;q<F.S.length;q++){var g=F.S[q];if(t>=g[0]&&t<g[1])return -1-(g[2]+Math.floor((t-g[0])/F.bm));}');
    DBMS_OUTPUT.PUT_LINE('  var j=bucketAt(t);return j<0?null:j;');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('/* a band''s top edge: the fill colour, darker */');
    DBMS_OUTPUT.PUT_LINE('function shade(h){var m=/^#([0-9a-f]{6})$/i.exec(h);if(!m)return h;var n=parseInt(m[1],16);return ''rgb(''+[n>>16,(n>>8)&255,n&255].map(function(v){return Math.round(v*0.8);}).join('','')+'')'';}');
    DBMS_OUTPUT.PUT_LINE('/* the buckets in [a, b): first and last index, O(1) on the regular grid */');
    DBMS_OUTPUT.PUT_LINE('function bRange(a,b){var n=SP.T.length,i0=Math.max(0,Math.floor((a-SP.t0)/SP.bh)),i1=Math.min(n-1,Math.ceil((b-SP.t0)/SP.bh)-1);');
    DBMS_OUTPUT.PUT_LINE('  while(i0<n&&SP.T1[i0]<=a)i0++;while(i1>=0&&SP.T[i1]>=b)i1--;return [i0,i1];}');
    DBMS_OUTPUT.PUT_LINE('function tw(t){if(!cvs)cvs=doc.createElement(''canvas'').getContext(''2d'');cvs.font=''11px ui-sans-serif, -apple-system, "Segoe UI", Inter, Roboto, system-ui, sans-serif'';return cvs.measureText(t).width;}');
    DBMS_OUTPUT.PUT_LINE('function okPay(P,n){return !!(P&&P.classes&&P.classes.length&&P.vals&&P.vals.length===P.classes.length&&P.vals[0]&&P.vals[0].length===n);}');
    DBMS_OUTPUT.PUT_LINE('function spInit(){');
    DBMS_OUTPUT.PUT_LINE('  var D=window.AWR_DATA||{};AX=D.ashx||null;AE=D.ashe||null;');
    DBMS_OUTPUT.PUT_LINE('  var panel=doc.getElementById(''ashx'');if(!panel)return;');
    DBMS_OUTPUT.PUT_LINE('  panel.hidden=false;');
    DBMS_OUTPUT.PUT_LINE('  var n=AX&&AX.vals&&AX.vals[0]?AX.vals[0].length:0;');
    DBMS_OUTPUT.PUT_LINE('  if(!AX||!AX.t0||!okPay(AX,n)){var e=$(''#ax-empty'',panel);if(e)e.hidden=false;$$(''.axch,.axn2,.axk'',panel).forEach(function(x){x.hidden=true;});return;}');
    DBMS_OUTPUT.PUT_LINE('  var bh=AX.bh*H1,t0=PT(AX.t0),end=PT(AX.end),T=[],T1=[];');
    DBMS_OUTPUT.PUT_LINE('  for(var i=0;i<n;i++){T.push(t0+i*bh);T1.push(Math.min(t0+(i+1)*bh,end));}');
    DBMS_OUTPUT.PUT_LINE('  SP={T:T,T1:T1,t0:t0,bh:bh,full:[t0,end],dom:[t0,end],win:wins().map(function(w){return [PT(w.s),PT(w.e)];}),');
    DBMS_OUTPUT.PUT_LINE('      min:Math.max(4*bh,Math.min(6*H1,(end-t0)/4)),bhTxt:AX.bh===1?''hourly'':bLab(AX.bh)+'' averages'',');
    DBMS_OUTPUT.PUT_LINE('      reset:doc.getElementById(''ax-reset''),range:doc.getElementById(''ax-range''),sel:null,F:null,rk:null,rv:null,mode:''span'',wk:0,wf:0};');
    DBMS_OUTPUT.PUT_LINE('  SP.F=fineInit(AX.fine);');
    DBMS_OUTPUT.PUT_LINE('  CH=[];');
    DBMS_OUTPUT.PUT_LINE('  var cc=mkChart(doc.getElementById(''ax-cls''),AX,AX.classes.map(wcol),{flags:true,noun:''classes'',what:''wait class'',labels:true});');
    DBMS_OUTPUT.PUT_LINE('  /* plan 042: the Current cpu_count on the class chart, a header note when');
    DBMS_OUTPUT.PUT_LINE('     it is above the chart''s y range */');
    DBMS_OUTPUT.PUT_LINE('  if(cc){cc.cpu=TL.cpuInfo(AX.cpu);');
    DBMS_OUTPUT.PUT_LINE('    if(cc.cpu&&SP.range){SP.cpuEl=mk(''span'',''axcpu'');SP.cpuEl.hidden=true;SP.range.parentNode.insertBefore(SP.cpuEl,SP.range.nextSibling);');
    DBMS_OUTPUT.PUT_LINE('      SP.cpuEl.title=''The Current window\u2019s cpu_count (the CPU threads the instance may use) is above the chart\u2019s y range, which is not stretched to reach it.'';}}');
    DBMS_OUTPUT.PUT_LINE('  var ev=doc.getElementById(''ax-ev'');');
    DBMS_OUTPUT.PUT_LINE('  if(okPay(AE,n))mkChart(ev,AE,evColors(AE.classes),{noun:''events'',what:''wait event'',labels:true});');
    DBMS_OUTPUT.PUT_LINE('  else if(ev)ev.hidden=true;');
    DBMS_OUTPUT.PUT_LINE('  /* the detail only when every chart has it */');
    DBMS_OUTPUT.PUT_LINE('  CH.forEach(function(c){c.FV=fineVals(c.P);});');
    DBMS_OUTPUT.PUT_LINE('  if(CH.some(function(c){return !c.FV;}))SP.F=null;');
    DBMS_OUTPUT.PUT_LINE('  if(CH.length)CH[CH.length-1].xl=true;');
    DBMS_OUTPUT.PUT_LINE('  /* the link between the charts: ashe.ecls[e] = event e''s wait class');
    DBMS_OUTPUT.PUT_LINE('     (CPU -> CPU, Other events -> null) */');
    DBMS_OUTPUT.PUT_LINE('  if(CH.length===2&&AE&&AE.ecls&&AE.ecls.length===AE.classes.length){');
    DBMS_OUTPUT.PUT_LINE('    var ca=CH[0],ce=CH[1];ca.peer=ce;ce.peer=ca;');
    DBMS_OUTPUT.PUT_LINE('    ca.xmap=AX.classes.map(function(cn){var o=[];AE.ecls.forEach(function(x,e){if(x===cn)o.push(e);});return o;});');
    DBMS_OUTPUT.PUT_LINE('    ce.xmap=AE.ecls.map(function(x){var i=x==null?-1:AX.classes.indexOf(x);return i<0?[]:[i];});');
    DBMS_OUTPUT.PUT_LINE('  }');
    DBMS_OUTPUT.PUT_LINE('  /* the dashboard design shows one chart at a time with its own tabs');
    DBMS_OUTPUT.PUT_LINE('     (js_design.js activityTabs): no compact mode there */');
    DBMS_OUTPUT.PUT_LINE('  var sec=doc.getElementById(''activity''),mb=doc.getElementById(''ax-more''),sv=null,dash=window.AWR_DESIGN===''dashboard'';');
    DBMS_OUTPUT.PUT_LINE('  try{sv=localStorage.getItem(''awr-ax'');}catch(e){}');
    DBMS_OUTPUT.PUT_LINE('  SP.cmp=CH.length===2&&sv!==''full''&&!dash;');
    DBMS_OUTPUT.PUT_LINE('  if(sec)sec.classList.toggle(''ax-cmp'',SP.cmp);');
    DBMS_OUTPUT.PUT_LINE('  if(mb&&CH.length===2&&!dash){');
    DBMS_OUTPUT.PUT_LINE('    mb.hidden=false;axMore(mb);');
    DBMS_OUTPUT.PUT_LINE('    mb.addEventListener(''click'',function(){');
    DBMS_OUTPUT.PUT_LINE('      SP.cmp=!SP.cmp;if(sec)sec.classList.toggle(''ax-cmp'',SP.cmp);axMore(mb);');
    DBMS_OUTPUT.PUT_LINE('      try{localStorage.setItem(''awr-ax'',SP.cmp?''compact'':''full'');}catch(e){}');
    DBMS_OUTPUT.PUT_LINE('      drawAll(true);');
    DBMS_OUTPUT.PUT_LINE('    });');
    DBMS_OUTPUT.PUT_LINE('  }');
    DBMS_OUTPUT.PUT_LINE('  /* the layout switch (Windows side by side / Full span): shown when at');
    DBMS_OUTPUT.PUT_LINE('     least two windows get a panel AXMP px wide; the reader''s last click');
    DBMS_OUTPUT.PUT_LINE('     (localStorage awr-axlayout) wins, else AXDEF (54 = draw''s padL + padR) */');
    DBMS_OUTPUT.PUT_LINE('  var mg=$(''#activity .axlayout''),sm=null,pw0=CH.length?Math.max(480,CH[0].plot.clientWidth)-54:0;');
    DBMS_OUTPUT.PUT_LINE('  try{sm=localStorage.getItem(''awr-axlayout'');}catch(e){}');
    DBMS_OUTPUT.PUT_LINE('  if(mg&&SP.win.length>=2&&winFit(pw0)>=2){');
    DBMS_OUTPUT.PUT_LINE('    mg.hidden=false;');
    DBMS_OUTPUT.PUT_LINE('    SP.mode=(sm===''win''||sm===''span'')?sm:(AXDEF===''win''&&SP.win.length<=winFit(pw0)?''win'':''span'');');
    DBMS_OUTPUT.PUT_LINE('    $$(''[data-m]'',mg).forEach(function(b){');
    DBMS_OUTPUT.PUT_LINE('      b.setAttribute(''aria-pressed'',String(b.getAttribute(''data-m'')===SP.mode));');
    DBMS_OUTPUT.PUT_LINE('      b.addEventListener(''click'',function(){TL.axLayout(b.getAttribute(''data-m''),true);});');
    DBMS_OUTPUT.PUT_LINE('    });');
    DBMS_OUTPUT.PUT_LINE('  }');
    DBMS_OUTPUT.PUT_LINE('  if(SP.reset)SP.reset.addEventListener(''click'',spReset);');
    DBMS_OUTPUT.PUT_LINE('  doc.addEventListener(''mousemove'',function(e){');
    DBMS_OUTPUT.PUT_LINE('    var dg=DRAG;if(!dg)return;');
    DBMS_OUTPUT.PUT_LINE('    if(!dg.moved&&Math.abs(e.clientX-dg.x0)<5)return;');
    DBMS_OUTPUT.PUT_LINE('    dg.moved=true;tipOff();hideAll();');
    DBMS_OUTPUT.PUT_LINE('    if(SP.mode===''win'')return;');
    DBMS_OUTPUT.PUT_LINE('    var c=dg.c,mn=toCli(c,c.g.padL,0).x,mx=toCli(c,c.g.W-c.g.padR,0).x;');
    DBMS_OUTPUT.PUT_LINE('    dg.a=Math.max(mn,Math.min(dg.x0,e.clientX));dg.b=Math.min(mx,Math.max(dg.x0,e.clientX));');
    DBMS_OUTPUT.PUT_LINE('    /* the brush shows on both charts: same width, same x mapping; its top');
    DBMS_OUTPUT.PUT_LINE('       and height from the plot''s own edges (a letterbox included) */');
    DBMS_OUTPUT.PUT_LINE('    CH.forEach(function(o){if(!o.g)return;var ro=o.svg.getBoundingClientRect(),y0=toCli(o,0,o.g.top).y,y1=toCli(o,0,o.g.top+o.g.ph).y;');
    DBMS_OUTPUT.PUT_LINE('      o.br.hidden=false;o.br.style.left=(dg.a-ro.left)+''px'';o.br.style.width=Math.max(0,dg.b-dg.a)+''px'';');
    DBMS_OUTPUT.PUT_LINE('      o.br.style.top=(y0-ro.top)+''px'';o.br.style.height=Math.max(0,y1-y0)+''px'';});');
    DBMS_OUTPUT.PUT_LINE('  });');
    DBMS_OUTPUT.PUT_LINE('  doc.addEventListener(''mouseup'',function(){');
    DBMS_OUTPUT.PUT_LINE('    var dg=DRAG;if(!dg)return;DRAG=null;CH.forEach(function(o){o.br.hidden=true;});');
    DBMS_OUTPUT.PUT_LINE('    if(dg.moved){if(SP.mode!==''win''&&dg.b-dg.a>6)spZoom(tAt(dg.c,dg.a),tAt(dg.c,dg.b));return;}');
    DBMS_OUTPUT.PUT_LINE('    if(dg.w!=null){SP.sel={prev:PW,t:Date.now()};spSelect(dg.w);return;}');
    DBMS_OUTPUT.PUT_LINE('    /* a click on a band makes its highlight sticky (the same band again,');
    DBMS_OUTPUT.PUT_LINE('       or a click off the stack, clears it) */');
    DBMS_OUTPUT.PUT_LINE('    var k=seriesAt(dg.c,dg.x0,dg.y0);');
    DBMS_OUTPUT.PUT_LINE('    if(k>=0||HS){SP.hsel={prev:HS,t:Date.now()};hlStick(dg.c,k);}');
    DBMS_OUTPUT.PUT_LINE('  });');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('function mkChart(root,P,cols,opt){');
    DBMS_OUTPUT.PUT_LINE('  if(!root)return null;');
    DBMS_OUTPUT.PUT_LINE('  var c={root:root,P:P,cols:cols,svg:$(''.axsvg'',root),plot:$(''.axp'',root),br:$(''.axbr'',root),');
    DBMS_OUTPUT.PUT_LINE('         vis:P.classes.map(function(){return true;}),flags:!!opt.flags,noun:opt.noun,what:opt.what,xl:false,g:null,w:0,uid:root.id,');
    DBMS_OUTPUT.PUT_LINE('         lg:$(''.axlg'',root),hl:null,hk:'''',peer:null,xmap:null,lab:opt.labels!==false};');
    DBMS_OUTPUT.PUT_LINE('  var lg=c.lg;');
    DBMS_OUTPUT.PUT_LINE('  if(lg){lg.innerHTML=P.classes.map(function(nm,k){return ''<button type="button" class="axc" data-c="''+k+''" aria-pressed="true" title="''+esc(nm)+'': hover to highlight, click to show or hide, Shift+click to keep it highlighted"><i class="sw" style="--sw:''+cols[k]+''" aria-hidden="true"></i>''+esc(nm)+''</button>'';}).join('''');');
    DBMS_OUTPUT.PUT_LINE('    /* hover / keyboard focus highlights; a click hides / shows; Shift+click');
    DBMS_OUTPUT.PUT_LINE('       or Shift+Enter keeps the highlight */');
    DBMS_OUTPUT.PUT_LINE('    $$(''.axc'',lg).forEach(function(b){');
    DBMS_OUTPUT.PUT_LINE('      var k=+b.getAttribute(''data-c''),mine=function(){return HT&&HT.c===c&&HT.k===k;};');
    DBMS_OUTPUT.PUT_LINE('      b.addEventListener(''click'',function(e){');
    DBMS_OUTPUT.PUT_LINE('        if(e.shiftKey){e.preventDefault();hlStick(c,k);return;}');
    DBMS_OUTPUT.PUT_LINE('        c.vis[k]=!c.vis[k];b.setAttribute(''aria-pressed'',String(c.vis[k]));hlApply();draw(c,true);});');
    DBMS_OUTPUT.PUT_LINE('      b.addEventListener(''keydown'',function(e){if(e.key===''Enter''&&e.shiftKey){e.preventDefault();hlStick(c,k);}});');
    DBMS_OUTPUT.PUT_LINE('      b.addEventListener(''mouseenter'',function(){hlSet({c:c,k:k});});');
    DBMS_OUTPUT.PUT_LINE('      b.addEventListener(''mouseleave'',function(){if(mine())hlSet(null);});');
    DBMS_OUTPUT.PUT_LINE('      b.addEventListener(''focus'',function(){var fv=true;try{fv=b.matches('':focus-visible'');}catch(x){}if(fv)hlSet({c:c,k:k});});');
    DBMS_OUTPUT.PUT_LINE('      b.addEventListener(''blur'',function(){if(mine())hlSet(null);});');
    DBMS_OUTPUT.PUT_LINE('    });}');
    DBMS_OUTPUT.PUT_LINE('  var s=c.svg;');
    DBMS_OUTPUT.PUT_LINE('  s.addEventListener(''mousemove'',function(e){hover(c,e);});');
    DBMS_OUTPUT.PUT_LINE('  s.addEventListener(''mouseleave'',function(){if(!DRAG){tipOff();hideAll();if(HT&&HT.soft)hlSet(null);}});');
    DBMS_OUTPUT.PUT_LINE('  s.addEventListener(''mousedown'',function(e){');
    DBMS_OUTPUT.PUT_LINE('    if(e.button!==0||!c.g)return;e.preventDefault();');
    DBMS_OUTPUT.PUT_LINE('    /* the second press of a double-click resets the zoom (the chart is redrawn');
    DBMS_OUTPUT.PUT_LINE('       between the two presses, so a dblclick event may never fire) and undoes');
    DBMS_OUTPUT.PUT_LINE('       the pin the first press made on a window stripe */');
    DBMS_OUTPUT.PUT_LINE('    if(e.detail>=2){if(SP.sel&&Date.now()-SP.sel.t<700)W.pin(SP.sel.prev);SP.sel=null;');
    DBMS_OUTPUT.PUT_LINE('      if(SP.hsel&&Date.now()-SP.hsel.t<700){HS=SP.hsel.prev;HT=null;hlApply();}SP.hsel=null;');
    DBMS_OUTPUT.PUT_LINE('      DRAG=null;if(SP.mode!==''win'')spReset();return;}');
    DBMS_OUTPUT.PUT_LINE('    var wh=e.target.closest(''.xwh'');DRAG={c:c,x0:e.clientX,y0:e.clientY,moved:false,w:wh?+wh.getAttribute(''data-i''):null};');
    DBMS_OUTPUT.PUT_LINE('  });');
    DBMS_OUTPUT.PUT_LINE('  s.addEventListener(''dblclick'',function(){if(SP.mode!==''win'')spReset();});');
    DBMS_OUTPUT.PUT_LINE('  s.addEventListener(''keydown'',function(e){var wh=e.target.closest&&e.target.closest(''.xwh'');if(wh&&(e.key===''Enter''||e.key==='' '')){e.preventDefault();spSelect(+wh.getAttribute(''data-i''));}});');
    DBMS_OUTPUT.PUT_LINE('  CH.push(c);');
    DBMS_OUTPUT.PUT_LINE('  return c;');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('function drawAll(force){CH.forEach(function(c){draw(c,force);});spHead();}');
    DBMS_OUTPUT.PUT_LINE('/* redraw both Activity charts now (a design that shows / hides one calls it) */');
    DBMS_OUTPUT.PUT_LINE('TL.redraw=function(){drawAll(true);};');
    DBMS_OUTPUT.PUT_LINE('/* the Activity charts'' layout: ''win'' (windows side by side) or ''span''');
    DBMS_OUTPUT.PUT_LINE('   (full span); persist = the reader clicked (localStorage awr-axlayout) */');
    DBMS_OUTPUT.PUT_LINE('TL.axLayout=function(m,persist){');
    DBMS_OUTPUT.PUT_LINE('  if(!SP||(m!==''win''&&m!==''span''))return;');
    DBMS_OUTPUT.PUT_LINE('  SP.mode=m;');
    DBMS_OUTPUT.PUT_LINE('  $$(''#activity .axlayout [data-m]'').forEach(function(b){b.setAttribute(''aria-pressed'',String(b.getAttribute(''data-m'')===m));});');
    DBMS_OUTPUT.PUT_LINE('  if(persist){try{localStorage.setItem(''awr-axlayout'',m);}catch(e){}}');
    DBMS_OUTPUT.PUT_LINE('  hideAll();tipOff();drawAll(true);');
    DBMS_OUTPUT.PUT_LINE('};');
    DBMS_OUTPUT.PUT_LINE('function spHead(){');
    DBMS_OUTPUT.PUT_LINE('  if(!SP)return;cpuHead();var d0=SP.dom[0],d1=SP.dom[1],zoomed=d0>SP.full[0]||d1<SP.full[1];');
    DBMS_OUTPUT.PUT_LINE('  if(SP.mode===''win''){');
    DBMS_OUTPUT.PUT_LINE('    if(SP.reset)SP.reset.hidden=true;');
    DBMS_OUTPUT.PUT_LINE('    var n=SP.win.length,K=SP.wk||n,f=SP.wf||0;');
    DBMS_OUTPUT.PUT_LINE('    if(SP.range)SP.range.textContent=(K===n?n+'' compared windows side by side'':''The ''+K+'' most recent of ''+n+'' compared windows side by side (Full span shows all)'')');
    DBMS_OUTPUT.PUT_LINE('      +(f===K?'', 1-min detail'':f>0?'', 1-min detail in the ''+f+'' most recent, ''+SP.bhTxt+'' in the rest'':'', ''+SP.bhTxt);');
    DBMS_OUTPUT.PUT_LINE('    return;');
    DBMS_OUTPUT.PUT_LINE('  }');
    DBMS_OUTPUT.PUT_LINE('  if(SP.reset)SP.reset.hidden=!zoomed;');
    DBMS_OUTPUT.PUT_LINE('  var res=SP.bhTxt;');
    DBMS_OUTPUT.PUT_LINE('  if(fineOn(d0,d1))res=fineCov(d0,d1)>=d1-d0-1?''1-min detail'':''1-min detail in the compared windows, ''+SP.bhTxt+'' elsewhere'';');
    DBMS_OUTPUT.PUT_LINE('  if(SP.range)SP.range.textContent=zoomed?fAt(d0)+'' to ''+fAt(d1)+'', zoomed, ''+res:fDay(SP.full[0])+'' to ''+fDay(SP.full[1])+'', ''+SP.bhTxt;');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('/* the highlight state and the series drawing order of chart c (re-based:');
    DBMS_OUTPUT.PUT_LINE('   the highlighted series first) */');
    DBMS_OUTPUT.PUT_LINE('function hlOrd(c){');
    DBMS_OUTPUT.PUT_LINE('  var P=c.P,hl=c.hl,on=null,k,ord=[];');
    DBMS_OUTPUT.PUT_LINE('  if(hl){on=P.classes.map(function(x,q){return !!hl.set[q]&&c.vis[q];});if(!on.some(Boolean)){hl=null;on=null;}}');
    DBMS_OUTPUT.PUT_LINE('  var reb=!!(hl&&hl.strong);');
    DBMS_OUTPUT.PUT_LINE('  for(k=0;k<P.vals.length;k++)if(c.vis[k]&&(!reb||on[k]))ord.push(k);');
    DBMS_OUTPUT.PUT_LINE('  if(reb)for(k=0;k<P.vals.length;k++)if(c.vis[k]&&!on[k])ord.push(k);');
    DBMS_OUTPUT.PUT_LINE('  return {hl:hl,on:on,reb:reb,ord:ord};');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('/* the points drawn for refs R over [d0, d1] mapped by X (see draw) and the');
    DBMS_OUTPUT.PUT_LINE('   largest stacked total mx / highlighted total mh inside [d0, d1] */');
    DBMS_OUTPUT.PUT_LINE('function colPts(c,R,X,d0,d1,reb,on){');
    DBMS_OUTPUT.PUT_LINE('  var P=c.P,pts=[],cb=null,mx=0.05,mh=0,i,k,sm,sh,r;');
    DBMS_OUTPUT.PUT_LINE('  for(i=0;i<R.length;i++){r=R[i];sm=0;sh=0;for(k=0;k<P.vals.length;k++)if(c.vis[k]){var vk=rV(c,k,r)||0;sm+=vk;if(reb&&on[k])sh+=vk;}');
    DBMS_OUTPUT.PUT_LINE('    var ra=rS(r),rb=rE(r);if(rb>d0&&ra<d1){if(sm>mx)mx=sm;if(sh>mh)mh=sh;}');
    DBMS_OUTPUT.PUT_LINE('    var xm=X((ra+rb)/2),col=Math.floor(xm),g=pts[pts.length-1];');
    DBMS_OUTPUT.PUT_LINE('    if(g&&col===cb){if(reb?(sh>g[3]||(sh===g[3]&&sm>g[2])):sm>g[2]){g[0]=xm;g[1]=r;g[2]=sm;g[3]=sh;}}else{pts.push([xm,r,sm,sh]);cb=col;}}');
    DBMS_OUTPUT.PUT_LINE('  if(pts.length){var pf=pts[0],pl=pts[pts.length-1];');
    DBMS_OUTPUT.PUT_LINE('    if(rS(pf[1])>=d0)pts.unshift([X(rS(pf[1])),pf[1],pf[2],pf[3]]);');
    DBMS_OUTPUT.PUT_LINE('    if(rE(pl[1])<=d1)pts.push([X(rE(pl[1])),pl[1],pl[2],pl[3]]);}');
    DBMS_OUTPUT.PUT_LINE('  return {pts:pts,mx:mx,mh:mh};');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('/* the band paths of points pts (colPts) in series order ord, y mapped by Y:');
    DBMS_OUTPUT.PUT_LINE('   one fill per series, painted top of the stack first (the caller reverses');
    DBMS_OUTPUT.PUT_LINE('   fills / edges): each fills from the axis up to its own cumulative line');
    DBMS_OUTPUT.PUT_LINE('   and the series below paint over it (no seams); then each band''s top');
    DBMS_OUTPUT.PUT_LINE('   edge, a thin darker line.  A point in the middle of a flat run is left');
    DBMS_OUTPUT.PUT_LINE('   out of the path.  Highlighted: the other series paint the same way inside');
    DBMS_OUTPUT.PUT_LINE('   one faded group (the group''s opacity applies once, so their overlap does');
    DBMS_OUTPUT.PUT_LINE('   not darken), then each highlighted series as its own band (hf, between');
    DBMS_OUTPUT.PUT_LINE('   its lower and upper line) at full colour with a clear top edge (he). */');
    DBMS_OUTPUT.PUT_LINE('function bands(c,pts,ord,on,Y){');
    DBMS_OUTPUT.PUT_LINE('  var lo=pts.map(function(){return 0;}),np=pts.length,y0=Y(0).toFixed(1),fills=[],edges=[],hf=[],he=[];');
    DBMS_OUTPUT.PUT_LINE('  var pl2=function(ys,rev){var o='''',j,q;for(q=0;q<np;q++){j=rev?np-1-q:q;if(q>0&&q<np-1&&ys[j]===ys[rev?j+1:j-1]&&ys[j]===ys[rev?j-1:j+1])continue;o+=(o?''L'':'''')+pts[j][0].toFixed(1)+'' ''+ys[j];}return o;};');
    DBMS_OUTPUT.PUT_LINE('  ord.forEach(function(k){');
    DBMS_OUTPUT.PUT_LINE('    if(!np)return;');
    DBMS_OUTPUT.PUT_LINE('    var hi=lo.map(function(l,j){return l+(rV(c,k,pts[j][1])||0);}),ys=hi.map(function(h){return Y(h).toFixed(1);}),ln=pl2(ys,false);');
    DBMS_OUTPUT.PUT_LINE('    if(on&&on[k]){');
    DBMS_OUTPUT.PUT_LINE('      hf.push(''<path class="xa xah" fill="''+c.cols[k]+''" d="M''+ln+''L''+pl2(lo.map(function(h){return Y(h).toFixed(1);}),true)+''Z"/>'');');
    DBMS_OUTPUT.PUT_LINE('      he.push(''<path class="xe xeh" stroke="''+shade(c.cols[k])+''" d="M''+ln+''"/>'');');
    DBMS_OUTPUT.PUT_LINE('    }else{');
    DBMS_OUTPUT.PUT_LINE('      fills.push(''<path class="xa" fill="''+c.cols[k]+''" d="M''+pts[0][0].toFixed(1)+'' ''+y0+''L''+ln+''L''+pts[np-1][0].toFixed(1)+'' ''+y0+''Z"/>'');');
    DBMS_OUTPUT.PUT_LINE('      edges.push(''<path class="xe" stroke="''+shade(c.cols[k])+''" d="M''+ln+''"/>'');');
    DBMS_OUTPUT.PUT_LINE('    }');
    DBMS_OUTPUT.PUT_LINE('    lo=hi;');
    DBMS_OUTPUT.PUT_LINE('  });');
    DBMS_OUTPUT.PUT_LINE('  return {fills:fills,edges:edges,hf:hf,he:he};');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('/* direct labels (plan 036; fitted per band, owner decision 2026-11-20):');
    DBMS_OUTPUT.PUT_LINE('   each shown series is named once a chart, inside its own band, where the');
    DBMS_OUTPUT.PUT_LINE('   band is thickest over a stretch as wide as the label.  A stretch = a');
    DBMS_OUTPUT.PUT_LINE('   window of whole pixel columns as wide as the label, inside one group');
    DBMS_OUTPUT.PUT_LINE('   (one for Full span, one per panel side by side, so a label never');
    DBMS_OUTPUT.PUT_LINE('   crosses a panel edge); its thickness = the lowest point of the band''s');
    DBMS_OUTPUT.PUT_LINE('   lower edge minus the highest point of its upper edge over the window,');
    DBMS_OUTPUT.PUT_LINE('   i.e. the tallest clear box of that width.  A label needs LBH px; the');
    DBMS_OUTPUT.PUT_LINE('   series go thickest first, at most LMAX a chart, each to its thickest');
    DBMS_OUTPUT.PUT_LINE('   stretch clear of the labels placed so far and of the highlight note');
    DBMS_OUTPUT.PUT_LINE('   (equal thickness: the middle of the run).  A name is cut at LW px with');
    DBMS_OUTPUT.PUT_LINE('   "..."; when that fits nowhere, shorter cuts (LCUT px, at least 6');
    DBMS_OUTPUT.PUT_LINE('   characters) are tried.  With a strong highlight only the highlighted');
    DBMS_OUTPUT.PUT_LINE('   series.  Drawn inside the plot clip, above bands and stripes,');
    DBMS_OUTPUT.PUT_LINE('   pointer-events none. */');
    DBMS_OUTPUT.PUT_LINE('var LBH=10,LMAX=6,LW=160,LTH=12,LCUT=[120,90,64];');
    DBMS_OUTPUT.PUT_LINE('/* per whole pixel column i of [x0, x0 + n): the lowest (big false) or the');
    DBMS_OUTPUT.PUT_LINE('   highest (big true) y of the polyline xs / ys (x increasing) over the');
    DBMS_OUTPUT.PUT_LINE('   column; a column the line does not cover gets -1e9 / 1e9, so no stretch');
    DBMS_OUTPUT.PUT_LINE('   over it is thick enough */');
    DBMS_OUTPUT.PUT_LINE('function colExt(xs,ys,x0,n,big){');
    DBMS_OUTPUT.PUT_LINE('  var out=[],np=xs.length,j=0,k=0,i,q,e,l,vl,vr;');
    DBMS_OUTPUT.PUT_LINE('  var at=function(x){');
    DBMS_OUTPUT.PUT_LINE('    if(!np||x<xs[0]||x>xs[np-1])return NaN;');
    DBMS_OUTPUT.PUT_LINE('    if(np<2)return ys[0];');
    DBMS_OUTPUT.PUT_LINE('    while(j<np-2&&xs[j+1]<x)j++;');
    DBMS_OUTPUT.PUT_LINE('    var a=xs[j],b=xs[j+1];');
    DBMS_OUTPUT.PUT_LINE('    return b>a?ys[j]+(ys[j+1]-ys[j])*(x-a)/(b-a):(big?Math.max(ys[j],ys[j+1]):Math.min(ys[j],ys[j+1]));');
    DBMS_OUTPUT.PUT_LINE('  };');
    DBMS_OUTPUT.PUT_LINE('  for(i=0;i<n;i++){');
    DBMS_OUTPUT.PUT_LINE('    l=x0+i;vl=at(l);vr=at(l+1);');
    DBMS_OUTPUT.PUT_LINE('    if(isNaN(vl)||isNaN(vr)){out.push(big?1e9:-1e9);continue;}');
    DBMS_OUTPUT.PUT_LINE('    e=big?Math.max(vl,vr):Math.min(vl,vr);');
    DBMS_OUTPUT.PUT_LINE('    while(k<np&&xs[k]<=l)k++;');
    DBMS_OUTPUT.PUT_LINE('    for(q=k;q<np&&xs[q]<l+1;q++)e=big?Math.max(e,ys[q]):Math.min(e,ys[q]);');
    DBMS_OUTPUT.PUT_LINE('    out.push(e);');
    DBMS_OUTPUT.PUT_LINE('  }');
    DBMS_OUTPUT.PUT_LINE('  return out;');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('/* the lowest (big false) / highest (big true) of a[s .. s + m - 1] for');
    DBMS_OUTPUT.PUT_LINE('   s = 0 .. a.length - m (a deque of candidate indexes) */');
    DBMS_OUTPUT.PUT_LINE('function slideExt(a,m,big){');
    DBMS_OUTPUT.PUT_LINE('  var out=[],dq=[],h=0,i;');
    DBMS_OUTPUT.PUT_LINE('  for(i=0;i<a.length;i++){');
    DBMS_OUTPUT.PUT_LINE('    while(dq.length>h&&(big?a[dq[dq.length-1]]<=a[i]:a[dq[dq.length-1]]>=a[i]))dq.pop();');
    DBMS_OUTPUT.PUT_LINE('    dq.push(i);');
    DBMS_OUTPUT.PUT_LINE('    if(dq[h]<=i-m)h++;');
    DBMS_OUTPUT.PUT_LINE('    if(i>=m-1)out.push(a[dq[h]]);');
    DBMS_OUTPUT.PUT_LINE('  }');
    DBMS_OUTPUT.PUT_LINE('  return out;');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('/* the stretches of one series for a label w px wide, from its per-group');
    DBMS_OUTPUT.PUT_LINE('   column extremes ext: per group {g, m (columns), x0, lo / hi (the clear');
    DBMS_OUTPUT.PUT_LINE('   box''s bottom / top per start), tq (its thickness rounded down to');
    DBMS_OUTPUT.PUT_LINE('   0.5 px)}; best = the largest tq anywhere */');
    DBMS_OUTPUT.PUT_LINE('function stretches(groups,ext,w){');
    DBMS_OUTPUT.PUT_LINE('  var m=Math.ceil(w-1e-6),R=[],best=-Infinity;');
    DBMS_OUTPUT.PUT_LINE('  ext.forEach(function(E,gi){');
    DBMS_OUTPUT.PUT_LINE('    if(!E||m<1||m>E.n)return;');
    DBMS_OUTPUT.PUT_LINE('    var lo=slideExt(E.lo,m,false),hi=slideExt(E.hi,m,true),tq=[],s;');
    DBMS_OUTPUT.PUT_LINE('    for(s=0;s<lo.length;s++){tq.push(Math.floor((lo[s]-hi[s])*2)/2);if(tq[s]>best)best=tq[s];}');
    DBMS_OUTPUT.PUT_LINE('    R.push({g:gi,m:m,x0:groups[gi].x0,lo:lo,hi:hi,tq:tq});');
    DBMS_OUTPUT.PUT_LINE('  });');
    DBMS_OUTPUT.PUT_LINE('  return {best:best,R:R};');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('/* the starts of stretches S at least mn thick, best first: thicker, then');
    DBMS_OUTPUT.PUT_LINE('   nearer the middle of their run of equal thickness ({t, x / y: the clear');
    DBMS_OUTPUT.PUT_LINE('   box''s centre}) */');
    DBMS_OUTPUT.PUT_LINE('function spos(S,mn){');
    DBMS_OUTPUT.PUT_LINE('  var pos=[];');
    DBMS_OUTPUT.PUT_LINE('  S.R.forEach(function(r){');
    DBMS_OUTPUT.PUT_LINE('    var tq=r.tq,ns=tq.length,a,b,s;');
    DBMS_OUTPUT.PUT_LINE('    for(a=0;a<ns;a=b+1){');
    DBMS_OUTPUT.PUT_LINE('      for(b=a;b+1<ns&&tq[b+1]===tq[a];)b++;');
    DBMS_OUTPUT.PUT_LINE('      if(tq[a]>=mn)for(s=a;s<=b;s++)pos.push({t:tq[s],d:Math.abs(s-(a+b)/2),g:r.g,s:s,x:r.x0+s+r.m/2,y:(r.lo[s]+r.hi[s])/2});');
    DBMS_OUTPUT.PUT_LINE('    }');
    DBMS_OUTPUT.PUT_LINE('  });');
    DBMS_OUTPUT.PUT_LINE('  return pos.sort(function(p,q){return q.t-p.t||p.d-q.d||p.g-q.g||p.s-q.s;});');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('/* the label fitter (pure; AWR_TL.fitLabels for tools/js_unit_tests.js).');
    DBMS_OUTPUT.PUT_LINE('   groups [{xs, x0, x1}]: the points'' x (increasing) and the group''s plot');
    DBMS_OUTPUT.PUT_LINE('   range; cands [{k, alts: [{txt, w}] longest first, yl / yh: per group,');
    DBMS_OUTPUT.PUT_LINE('   the band''s lower / upper edge y at each point}] in stacking order;');
    DBMS_OUTPUT.PUT_LINE('   o {min: thickness, max: labels, th: text box height, y1: the axis (a');
    DBMS_OUTPUT.PUT_LINE('   label''s box stays above it), avoid: [[x0, y0, x1, y1]]}.');
    DBMS_OUTPUT.PUT_LINE('   Returns [{k, txt, x, y, w, t}], x / y = the label''s centre. */');
    DBMS_OUTPUT.PUT_LINE('function fitLabels(groups,cands,o){');
    DBMS_OUTPUT.PUT_LINE('  var out=[],boxes=(o.avoid||[]).slice(),th=o.th||12,L=[];');
    DBMS_OUTPUT.PUT_LINE('  cands.forEach(function(C,ci){');
    DBMS_OUTPUT.PUT_LINE('    var ext=groups.map(function(G,gi){var n=Math.floor(G.x1-G.x0+1e-6);return n>0?{n:n,lo:colExt(G.xs,C.yl[gi],G.x0,n,false),hi:colExt(G.xs,C.yh[gi],G.x0,n,true)}:null;}),ub=-Infinity;');
    DBMS_OUTPUT.PUT_LINE('    /* no single column thick enough: no stretch is (the common thin band) */');
    DBMS_OUTPUT.PUT_LINE('    ext.forEach(function(E){if(E)for(var i=0;i<E.n;i++)if(E.lo[i]-E.hi[i]>ub)ub=E.lo[i]-E.hi[i];});');
    DBMS_OUTPUT.PUT_LINE('    if(ub<o.min)return;');
    DBMS_OUTPUT.PUT_LINE('    for(var a=0;a<C.alts.length;a++){var S=stretches(groups,ext,C.alts[a].w);if(S.best>=o.min){L.push({C:C,ci:ci,ext:ext,a:a,S:S});break;}}');
    DBMS_OUTPUT.PUT_LINE('  });');
    DBMS_OUTPUT.PUT_LINE('  L.sort(function(p,q){return q.S.best-p.S.best||p.ci-q.ci;});');
    DBMS_OUTPUT.PUT_LINE('  L.forEach(function(it){');
    DBMS_OUTPUT.PUT_LINE('    if(out.length>=o.max)return;');
    DBMS_OUTPUT.PUT_LINE('    for(var a=it.a;a<it.C.alts.length;a++){');
    DBMS_OUTPUT.PUT_LINE('      var w=it.C.alts[a].w,P=spos(a===it.a?it.S:stretches(groups,it.ext,w),o.min);');
    DBMS_OUTPUT.PUT_LINE('      for(var i=0;i<P.length;i++){');
    DBMS_OUTPUT.PUT_LINE('        var p=P[i],y=o.y1!=null?Math.min(p.y,o.y1-th/2):p.y,box=[p.x-w/2,y-th/2,p.x+w/2,y+th/2];');
    DBMS_OUTPUT.PUT_LINE('        if(boxes.some(function(b){return box[0]<b[2]+2&&box[2]>b[0]-2&&box[1]<b[3]+2&&box[3]>b[1]-2;}))continue;');
    DBMS_OUTPUT.PUT_LINE('        boxes.push(box);out.push({k:it.C.k,txt:it.C.alts[a].txt,x:p.x,y:y,w:w,t:p.t});return;');
    DBMS_OUTPUT.PUT_LINE('      }');
    DBMS_OUTPUT.PUT_LINE('    }');
    DBMS_OUTPUT.PUT_LINE('  });');
    DBMS_OUTPUT.PUT_LINE('  return out;');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('TL.fitLabels=fitLabels;');
    DBMS_OUTPUT.PUT_LINE('/* a series name''s label texts, longest first ({txt, w}: cut at LW, then');
    DBMS_OUTPUT.PUT_LINE('   at each LCUT width while at least 6 characters stay; cached per name) */');
    DBMS_OUTPUT.PUT_LINE('var LC=Object.create(null);');
    DBMS_OUTPUT.PUT_LINE('function lcuts(nm){');
    DBMS_OUTPUT.PUT_LINE('  if(LC[nm])return LC[nm];');
    DBMS_OUTPUT.PUT_LINE('  var out=[];');
    DBMS_OUTPUT.PUT_LINE('  [LW].concat(LCUT).forEach(function(mw,q){');
    DBMS_OUTPUT.PUT_LINE('    var t=nm,w;');
    DBMS_OUTPUT.PUT_LINE('    if(tw(t)+6>mw){while(t.length>(q?6:4)&&tw(t+''...'')+6>mw)t=t.slice(0,-1);t=t.replace(/\s+$/,'''')+''...'';}');
    DBMS_OUTPUT.PUT_LINE('    w=tw(t)+6;');
    DBMS_OUTPUT.PUT_LINE('    if((!out.length||out[out.length-1].txt!==t)&&(!q||w<=mw))out.push({txt:t,w:w});');
    DBMS_OUTPUT.PUT_LINE('  });');
    DBMS_OUTPUT.PUT_LINE('  return (LC[nm]=out);');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('/* the texts alts of series k (lcuts) without a cut ("...") whose stem');
    DBMS_OUTPUT.PUT_LINE('   also starts another series'' name in names (the chart''s series): such');
    DBMS_OUTPUT.PUT_LINE('   a label is ambiguous ("log file s..." reads as log file sync as well as');
    DBMS_OUTPUT.PUT_LINE('   log file switch); pure, AWR_TL.labelAlts */');
    DBMS_OUTPUT.PUT_LINE('function labelAlts(alts,names,k){');
    DBMS_OUTPUT.PUT_LINE('  return alts.filter(function(a){');
    DBMS_OUTPUT.PUT_LINE('    if(a.txt===names[k]||a.txt.slice(-3)!==''...'')return true;');
    DBMS_OUTPUT.PUT_LINE('    var p=a.txt.slice(0,-3);');
    DBMS_OUTPUT.PUT_LINE('    return !names.some(function(x,q){return q!==k&&x.indexOf(p)===0;});');
    DBMS_OUTPUT.PUT_LINE('  });');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('TL.labelAlts=labelAlts;');
    DBMS_OUTPUT.PUT_LINE('/* the highlight note''s box for dlab (the note is 600 weight and Geist in the');
    DBMS_OUTPUT.PUT_LINE('   quiet / dashboard designs, tw() measures the 400 system stack: 1.2x) */');
    DBMS_OUTPUT.PUT_LINE('function noteBox(hl,padL,top){return hl&&hl.note?[padL+6,top+3,padL+6+tw(hl.note)*1.2,top+16]:null;}');
    DBMS_OUTPUT.PUT_LINE('/* the labels of chart c: groups [{pts, x0, x1}] (colPts points), series');
    DBMS_OUTPUT.PUT_LINE('   order ord stacked from zero exactly as bands() does, y by Y, nb = the');
    DBMS_OUTPUT.PUT_LINE('   highlight note''s box (or null), xb = more boxes to keep clear (plan 042:');
    DBMS_OUTPUT.PUT_LINE('   the cpu_count line and its label), or null */');
    DBMS_OUTPUT.PUT_LINE('function dlab(c,groups,ord,on,Y,reb,nb,xb){');
    DBMS_OUTPUT.PUT_LINE('  if(!c.lab)return '''';');
    DBMS_OUTPUT.PUT_LINE('  var G=groups.filter(function(g){return g.pts.length>=2;}),lo=G.map(function(g){return g.pts.map(function(){return 0;});}),cands=[];');
    DBMS_OUTPUT.PUT_LINE('  ord.forEach(function(k){');
    DBMS_OUTPUT.PUT_LINE('    var yl=[],yh=[];');
    DBMS_OUTPUT.PUT_LINE('    G.forEach(function(g,gi){var hi=lo[gi].map(function(l,j){return l+(rV(c,k,g.pts[j][1])||0);});yl.push(lo[gi].map(Y));yh.push(hi.map(Y));lo[gi]=hi;});');
    DBMS_OUTPUT.PUT_LINE('    if(!reb||(on&&on[k]))cands.push({k:k,alts:labelAlts(lcuts(c.P.classes[k]),c.P.classes,k),yl:yl,yh:yh});');
    DBMS_OUTPUT.PUT_LINE('  });');
    DBMS_OUTPUT.PUT_LINE('  return fitLabels(G.map(function(g){return {xs:g.pts.map(function(p){return p[0];}),x0:g.x0,x1:g.x1};}),cands,{min:LBH,max:LMAX,th:LTH,y1:Y(0),avoid:(nb?[nb]:[]).concat(xb||[])})');
    DBMS_OUTPUT.PUT_LINE('    .map(function(L){return ''<text class="xdl" x="''+L.x.toFixed(1)+''" y="''+(L.y+4).toFixed(1)+''" text-anchor="middle">''+esc(L.txt)+''</text>'';}).join('''');');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('/* the release markers of list [{x: px, m: marker}]: a line through the plot');
    DBMS_OUTPUT.PUT_LINE('   on every chart shown, the flags (two tiers) on the chart with c.flags.');
    DBMS_OUTPUT.PUT_LINE('   Markers less than 1 px apart (side by side: every marker of one gap)');
    DBMS_OUTPUT.PUT_LINE('   form a group: as many as fit get a flag of their own, the last flag');
    DBMS_OUTPUT.PUT_LINE('   shown names the rest ("Release 4.2 +2", its tooltip lists them); a');
    DBMS_OUTPUT.PUT_LINE('   group with no room left for a flag keeps its line, whose tooltip names');
    DBMS_OUTPUT.PUT_LINE('   every marker of the group */');
    DBMS_OUTPUT.PUT_LINE('function flagSvg(c,list,top,ph,Wd,padL,padR){');
    DBMS_OUTPUT.PUT_LINE('  var s='''',tiers=[[],[]],G=[];');
    DBMS_OUTPUT.PUT_LINE('  list.filter(function(it){return it.x>=padL&&it.x<=Wd-padR;}).sort(function(a,b){return a.x-b.x;}).forEach(function(it){');
    DBMS_OUTPUT.PUT_LINE('    var g=G[G.length-1];if(g&&it.x-g.x<1)g.ms.push(it.m);else G.push({x:it.x,ms:[it.m]});');
    DBMS_OUTPUT.PUT_LINE('  });');
    DBMS_OUTPUT.PUT_LINE('  var tt=function(ms){return ms.map(function(m){return m.l+'', ''+m.t;}).join(''\n'');};');
    DBMS_OUTPUT.PUT_LINE('  var line=function(x,ms){return ''<line class="cfl" x1="''+x.toFixed(1)+''" x2="''+x.toFixed(1)+''" y1="''+top+''" y2="''+(top+ph)+''"><title>''+esc(tt(ms))+''</title></line>'';};');
    DBMS_OUTPUT.PUT_LINE('  G.forEach(function(g){');
    DBMS_OUTPUT.PUT_LINE('    var x=g.x,ms=g.ms,n=ms.length,j,i;');
    DBMS_OUTPUT.PUT_LINE('    if(!c.flags){s+=line(x,ms);return;}');
    DBMS_OUTPUT.PUT_LINE('    /* j flags: the first j - 1 markers alone, the j-th with the rest */');
    DBMS_OUTPUT.PUT_LINE('    for(j=n;j>=1;j--){');
    DBMS_OUTPUT.PUT_LINE('      var tr=tiers.map(function(t){return t.slice();}),out='''',f='''';');
    DBMS_OUTPUT.PUT_LINE('      for(i=0;i<j&&f!=null;i++){');
    DBMS_OUTPUT.PUT_LINE('        var more=i===j-1?ms.slice(j):[],sx=more.length?'' +''+more.length:'''';');
    DBMS_OUTPUT.PUT_LINE('        f=flag1(tr,x,[ms[i].l+sx,ms[i].s+sx],tt([ms[i]].concat(more)),top,ph,Wd,padR);');
    DBMS_OUTPUT.PUT_LINE('        if(f!=null)out+=f;');
    DBMS_OUTPUT.PUT_LINE('      }');
    DBMS_OUTPUT.PUT_LINE('      if(f!=null){tiers=tr;s+=out;return;}');
    DBMS_OUTPUT.PUT_LINE('    }');
    DBMS_OUTPUT.PUT_LINE('    s+=line(x,ms);');
    DBMS_OUTPUT.PUT_LINE('  });');
    DBMS_OUTPUT.PUT_LINE('  return s;');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('/* where a flag at x goes: the first label (widths ws, in order: the long');
    DBMS_OUTPUT.PUT_LINE('   label, then the short one) that fits on a free tier, left-anchored at x,');
    DBMS_OUTPUT.PUT_LINE('   or flipped to end at x when that would pass the right edge hi -- and');
    DBMS_OUTPUT.PUT_LINE('   only while the flag then stays right of the left edge lo (review');
    DBMS_OUTPUT.PUT_LINE('   follow-up R3: a long label flipped left near the left edge sat mostly');
    DBMS_OUTPUT.PUT_LINE('   outside the SVG, and the short one was never tried).  {i: label index,');
    DBMS_OUTPUT.PUT_LINE('   L: tier, x0: left edge, end: flipped} with tiers taking its extent, or');
    DBMS_OUTPUT.PUT_LINE('   null: the caller keeps the line and its tooltip.  Pure: AWR_TL.flagPos,');
    DBMS_OUTPUT.PUT_LINE('   unit-tested. */');
    DBMS_OUTPUT.PUT_LINE('function flagPos(tiers,x,ws,lo,hi){');
    DBMS_OUTPUT.PUT_LINE('  for(var i=0;i<ws.length;i++){');
    DBMS_OUTPUT.PUT_LINE('    var w=ws[i],x0=x+w>hi?x-w:x;');
    DBMS_OUTPUT.PUT_LINE('    if(x0<lo)continue;');
    DBMS_OUTPUT.PUT_LINE('    for(var L=0;L<tiers.length;L++){');
    DBMS_OUTPUT.PUT_LINE('      if(tiers[L].some(function(q){return x0<q[1]+6&&x0+w>q[0]-6;}))continue;');
    DBMS_OUTPUT.PUT_LINE('      tiers[L].push([x0,x0+w]);return {i:i,L:L,x0:x0,end:x0!==x};');
    DBMS_OUTPUT.PUT_LINE('    }');
    DBMS_OUTPUT.PUT_LINE('  }');
    DBMS_OUTPUT.PUT_LINE('  return null;');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('TL.flagPos=flagPos;');
    DBMS_OUTPUT.PUT_LINE('/* one flag at x for the first of the labels labs that fits (flagPos; the');
    DBMS_OUTPUT.PUT_LINE('   SVG''s left edge, 0, to the plot''s right edge), else null */');
    DBMS_OUTPUT.PUT_LINE('function flag1(tiers,x,labs,title,top,ph,Wd,padR){');
    DBMS_OUTPUT.PUT_LINE('  var ws=labs.map(function(lb){return tw(lb)+12;}),f=flagPos(tiers,x,ws,0,Wd-padR);if(!f)return null;');
    DBMS_OUTPUT.PUT_LINE('  var lb=labs[f.i],w=ws[f.i],x0=f.x0,end=f.end,y=2+f.L*19;');
    DBMS_OUTPUT.PUT_LINE('  return ''<line class="cfl" x1="''+x.toFixed(1)+''" x2="''+x.toFixed(1)+''" y1="''+(y+16)+''" y2="''+(top+ph)+''"/><line class="cf" x1="''+x.toFixed(1)+''" x2="''+x.toFixed(1)+''" y1="''+y+''" y2="''+(y+16)+''"/>''');
    DBMS_OUTPUT.PUT_LINE('    +''<rect class="cfh" x="''+(end?x0:x+1).toFixed(1)+''" y="''+y+''" width="''+(w-1)+''" height="16" rx="2"/>''');
    DBMS_OUTPUT.PUT_LINE('    +''<text class="cft" x="''+(end?x-6:x+6).toFixed(1)+''" y="''+(y+12)+''" text-anchor="''+(end?''end'':''start'')+''"><title>''+esc(title)+''</title>''+esc(lb)+''</text>'';');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('/* replace chart c''s SVG; a focused window stripe / cap keeps the focus');
    DBMS_OUTPUT.PUT_LINE('   (Enter on it pins the window, which redraws both charts) */');
    DBMS_OUTPUT.PUT_LINE('function setSvg(c,s){');
    DBMS_OUTPUT.PUT_LINE('  var a=doc.activeElement,fi=a&&a!==c.svg&&c.svg.contains(a)&&a.getAttribute&&a.getAttribute(''class'')===''xwh''?a.getAttribute(''data-i''):null;');
    DBMS_OUTPUT.PUT_LINE('  c.svg.innerHTML=s;');
    DBMS_OUTPUT.PUT_LINE('  if(fi!=null){var e=$(''.xwh[data-i="''+fi+''"]'',c.svg);if(e)try{e.focus({preventScroll:true});}catch(x){e.focus();}}');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('/* ---- "Windows side by side" (SP.mode ''win''): each compared window as its');
    DBMS_OUTPUT.PUT_LINE('   own panel on one shared y axis, oldest left, Current last.  A panel is');
    DBMS_OUTPUT.PUT_LINE('   drawn minute by minute when every minute of its window is in the');
    DBMS_OUTPUT.PUT_LINE('   1-minute detail (SP.F), else from the coarse buckets overlapping it.');
    DBMS_OUTPUT.PUT_LINE('   Panels are at least AXMP px wide, AXGAP px apart: when not all windows');
    DBMS_OUTPUT.PUT_LINE('   fit, the most recent that fit (the Current always).  No zoom here; a');
    DBMS_OUTPUT.PUT_LINE('   click on a panel''s top edge pins its window.  AXDEF = the mode for a');
    DBMS_OUTPUT.PUT_LINE('   reader who never clicked the switch (''win'': side by side when every');
    DBMS_OUTPUT.PUT_LINE('   window fits, else full span). */');
    DBMS_OUTPUT.PUT_LINE('var AXMP=24,AXGAP=6,AXDEF=''span'';');
    DBMS_OUTPUT.PUT_LINE('function winFit(pw){return Math.max(1,Math.floor((pw+AXGAP)/(AXMP+AXGAP)));}');
    DBMS_OUTPUT.PUT_LINE('/* the refs of window i: its 1-minute buckets when the detail covers it all,');
    DBMS_OUTPUT.PUT_LINE('   else the coarse buckets overlapping it */');
    DBMS_OUTPUT.PUT_LINE('function wSlice(i){');
    DBMS_OUTPUT.PUT_LINE('  var a=SP.win[i][0],b=SP.win[i][1],F=SP.F,out=[],q,g,j,j0,j1;');
    DBMS_OUTPUT.PUT_LINE('  if(F&&fineCov(a,b)>=b-a-1){');
    DBMS_OUTPUT.PUT_LINE('    for(q=0;q<F.S.length;q++){g=F.S[q];if(g[1]<=a||g[0]>=b)continue;');
    DBMS_OUTPUT.PUT_LINE('      j0=Math.max(0,Math.floor((a-g[0])/F.bm));j1=Math.min(Math.round((g[1]-g[0])/F.bm),Math.ceil((b-g[0])/F.bm))-1;');
    DBMS_OUTPUT.PUT_LINE('      for(j=j0;j<=j1;j++)out.push(-1-(g[2]+j));}');
    DBMS_OUTPUT.PUT_LINE('    return {r:out,fine:true};');
    DBMS_OUTPUT.PUT_LINE('  }');
    DBMS_OUTPUT.PUT_LINE('  var br=bRange(a,b);for(j=br[0];j<=br[1];j++)out.push(j);');
    DBMS_OUTPUT.PUT_LINE('  return {r:out,fine:false};');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('/* the panel under client x on chart c: {q: panel index, t: time} or null */');
    DBMS_OUTPUT.PUT_LINE('function panAt(c,cx){');
    DBMS_OUTPUT.PUT_LINE('  var g=c.g;if(!g||g.mode!==''win'')return null;');
    DBMS_OUTPUT.PUT_LINE('  var x=toSvg(c,cx,0).x;');
    DBMS_OUTPUT.PUT_LINE('  for(var q=0;q<g.pan.length;q++){var p=g.pan[q];if(x>=p.x0&&x<p.x0+p.w)return {q:q,t:p.a+(x-p.x0)/p.w*(p.b-p.a)};}');
    DBMS_OUTPUT.PUT_LINE('  return null;');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('/* the ref drawn at time t in panel q (1-minute or coarse, as the panel) */');
    DBMS_OUTPUT.PUT_LINE('function wRefAt(c,q,t){');
    DBMS_OUTPUT.PUT_LINE('  var p=c.g.pan[q];if(!p)return null;');
    DBMS_OUTPUT.PUT_LINE('  if(p.fine){var F=SP.F;for(var k=0;k<F.S.length;k++){var g=F.S[k];if(t>=g[0]&&t<g[1])return -1-(g[2]+Math.floor((t-g[0])/F.bm));}return null;}');
    DBMS_OUTPUT.PUT_LINE('  var j=bucketAt(t);return j<0?null:j;');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('/* chart c side by side (draw passes its size; flags / labels follow');
    DBMS_OUTPUT.PUT_LINE('   c.flags / c.xl as in draw) */');
    DBMS_OUTPUT.PUT_LINE('function drawWin(c,o){');
    DBMS_OUTPUT.PUT_LINE('  var Wd=o.Wd,top=o.top,ph=o.ph,padL=o.padL,padR=o.padR,pw=o.pw;');
    DBMS_OUTPUT.PUT_LINE('  var n=SP.win.length,K=Math.min(n,winFit(pw)),w=(pw-AXGAP*(K-1))/K,ws=wins(),cur=ws.length-1;');
    DBMS_OUTPUT.PUT_LINE('  var h=hlOrd(c),hl=h.hl,on=h.on,reb=h.reb,ord=h.ord,pan=[],mx=0.05,mh=0,nf=0,q;');
    DBMS_OUTPUT.PUT_LINE('  for(q=0;q<K;q++){');
    DBMS_OUTPUT.PUT_LINE('    var i=n-K+q,a=SP.win[i][0],b=SP.win[i][1],x0=padL+q*(w+AXGAP),sl=wSlice(i);');
    DBMS_OUTPUT.PUT_LINE('    var X=(function(x0,a,b){return function(t){return x0+w*Math.min(1,Math.max(0,(t-a)/(b-a)));};})(x0,a,b);');
    DBMS_OUTPUT.PUT_LINE('    var cp=colPts(c,sl.r,X,a,b,reb,on);');
    DBMS_OUTPUT.PUT_LINE('    if(cp.mx>mx)mx=cp.mx;if(cp.mh>mh)mh=cp.mh;if(sl.fine)nf++;');
    DBMS_OUTPUT.PUT_LINE('    pan.push({i:i,x0:x0,w:w,a:a,b:b,X:X,fine:sl.fine,pts:cp.pts});');
    DBMS_OUTPUT.PUT_LINE('  }');
    DBMS_OUTPUT.PUT_LINE('  SP.wk=K;SP.wf=nf;');
    DBMS_OUTPUT.PUT_LINE('  /* y scale, clip paths, gridlines, "AAS", open the clipped group: as draw */');
    DBMS_OUTPUT.PUT_LINE('  var yb=reb&&mh>0?Math.max(mh,0.05):mx,step=niceStep(yb,3),ymax=Math.ceil(yb/step-1e-9)*step;');
    DBMS_OUTPUT.PUT_LINE('  var Y=function(v){return top+ph-ph*v/ymax;},clip=''axclip-''+c.uid;');
    DBMS_OUTPUT.PUT_LINE('  var s=''<defs><clipPath id="''+clip+''"><rect x="''+padL+''" y="''+(top-6)+''" width="''+pw+''" height="''+(ph+6)+''"/></clipPath>''');
    DBMS_OUTPUT.PUT_LINE('    +(reb?''<clipPath id="''+clip+''f"><rect x="''+padL+''" y="''+top+''" width="''+pw+''" height="''+ph+''"/></clipPath>'':'''')+''</defs>'';');
    DBMS_OUTPUT.PUT_LINE('  for(var v=0;v<=ymax+1e-9;v+=step){var dec=step<1?(step<0.1?2:1):0;');
    DBMS_OUTPUT.PUT_LINE('    s+=''<line class="gl" x1="''+padL+''" x2="''+(Wd-padR)+''" y1="''+Y(v).toFixed(1)+''" y2="''+Y(v).toFixed(1)+''"/><text class="at" x="''+(padL-6)+''" y="''+(Y(v)+4).toFixed(1)+''" text-anchor="end">''+v.toFixed(dec)+''</text>'';}');
    DBMS_OUTPUT.PUT_LINE('  s+=''<text class="at" x="''+(padL-6)+''" y="''+(top-10)+''" text-anchor="end">AAS</text><g clip-path="url(#''+clip+'')">'';');
    DBMS_OUTPUT.PUT_LINE('  /* panel backgrounds under the bands; classes as the stripes'' */');
    DBMS_OUTPUT.PUT_LINE('  var hit=[];');
    DBMS_OUTPUT.PUT_LINE('  pan.forEach(function(p){var wi=ws[p.i],cls=(p.i===cur?'' cur'':'''')+(wi.o===PW?'' on'':'''')+(wi.v===''N''?'' sk'':'''');');
    DBMS_OUTPUT.PUT_LINE('    s+=''<rect class="xw xpn''+cls+''" x="''+p.x0.toFixed(1)+''" y="''+top+''" width="''+p.w.toFixed(1)+''" height="''+ph+''"/>'';');
    DBMS_OUTPUT.PUT_LINE('    hit.push([p.i,p.x0,p.w,cls]);});');
    DBMS_OUTPUT.PUT_LINE('  /* the bands, panel by panel (each panel''s fills top of the stack first, as draw) */');
    DBMS_OUTPUT.PUT_LINE('  var F=[],E=[],HF=[],HE=[];');
    DBMS_OUTPUT.PUT_LINE('  pan.forEach(function(p){var B=bands(c,p.pts,ord,on,Y);F=F.concat(B.fills.reverse());E=E.concat(B.edges.reverse());HF=HF.concat(B.hf);HE=HE.concat(B.he);});');
    DBMS_OUTPUT.PUT_LINE('  if(!hl)s+=F.join('''')+E.join('''');');
    DBMS_OUTPUT.PUT_LINE('  else s+=(reb?''<g clip-path="url(#''+clip+''f)">'':'''')+''<g class="xfd" opacity="''+(reb&&ymax<mx?Math.min(hl.fade,0.07):hl.fade)+''">''+F.join('''')+''</g>''+HF.join('''')+HE.join('''')+(reb?''</g>'':'''');');
    DBMS_OUTPUT.PUT_LINE('  /* the hidden bucket band: as draw; the caps */');
    DBMS_OUTPUT.PUT_LINE('  s+=''<rect class="xbk" x="0" y="''+top+''" width="0" height="''+ph+''" visibility="hidden"/>'';');
    DBMS_OUTPUT.PUT_LINE('  hit.forEach(function(r){s+=''<rect class="xwc''+r[3]+''" x="''+r[1].toFixed(1)+''" y="''+(top-5)+''" width="''+r[2].toFixed(1)+''" height="4" rx="1"/>'';});');
    DBMS_OUTPUT.PUT_LINE('  /* the cpu_count line (plan 042, the class chart only), then the direct');
    DBMS_OUTPUT.PUT_LINE('     labels, each inside its panel (dlab) */');
    DBMS_OUTPUT.PUT_LINE('  var cq=cpuMark(c,Y,ymax,padL,Wd-padR,top,ph,noteBox(hl,padL,top));if(cq)s+=cq.s;');
    DBMS_OUTPUT.PUT_LINE('  s+=dlab(c,pan.map(function(p){return {pts:p.pts,x0:p.x0,x1:p.x0+p.w};}),ord,on,Y,reb,noteBox(hl,padL,top),cq&&cq.box);');
    DBMS_OUTPUT.PUT_LINE('  /* close the group and the x axis line: as draw */');
    DBMS_OUTPUT.PUT_LINE('  s+=''</g><line class="ax" x1="''+padL+''" x2="''+(Wd-padR)+''" y1="''+(top+ph)+''" y2="''+(top+ph)+''"/>'';');
    DBMS_OUTPUT.PUT_LINE('  /* window labels under the lower chart: every st-th panel counted from the Current one */');
    DBMS_OUTPUT.PUT_LINE('  if(o.xl){var lw=0;pan.forEach(function(p){lw=Math.max(lw,tw(ws[p.i].d));});var st=Math.max(1,Math.ceil((lw+8)/(w+AXGAP)));');
    DBMS_OUTPUT.PUT_LINE('    pan.forEach(function(p,q){if((K-1-q)%st)return;var wi=ws[p.i];');
    DBMS_OUTPUT.PUT_LINE('      s+=''<text class="at xpl''+(p.i===cur?'' cur'':'''')+(wi.v===''N''?'' sk'':'''')+''" x="''+(p.x0+p.w/2).toFixed(1)+''" y="''+(top+ph+18)+''" text-anchor="middle">''+esc(wi.d)+''</text>'';});}');
    DBMS_OUTPUT.PUT_LINE('  /* release markers: in the gap before the window they precede */');
    DBMS_OUTPUT.PUT_LINE('  var list=[];o.mks.forEach(function(m){var ib=idxOf(m.o);pan.forEach(function(p){if(p.i===ib)list.push({x:Math.max(padL,p.x0-AXGAP/2),m:m});});});');
    DBMS_OUTPUT.PUT_LINE('  s+=flagSvg(c,list,top,ph,Wd,padL,padR);');
    DBMS_OUTPUT.PUT_LINE('  /* highlight note and crosshair: as draw */');
    DBMS_OUTPUT.PUT_LINE('  if(hl&&hl.note)s+=''<text class="xhn" x="''+(padL+6)+''" y="''+(top+13)+''">''+esc(hl.note)+''</text>'';');
    DBMS_OUTPUT.PUT_LINE('  s+=''<line class="xch" x1="0" x2="0" y1="''+top+''" y2="''+(top+ph)+''" visibility="hidden"/>'';');
    DBMS_OUTPUT.PUT_LINE('  /* hit areas: the caps only (a band in the plot keeps its highlight on a click) */');
    DBMS_OUTPUT.PUT_LINE('  hit.forEach(function(r){var wi=ws[r[0]];');
    DBMS_OUTPUT.PUT_LINE('    s+=''<rect class="xwh" data-i="''+r[0]+''" data-w="''+wi.o+''" x="''+r[1].toFixed(1)+''" y="''+(top-6)+''" width="''+r[2].toFixed(1)+''" height="10" tabindex="0" role="button" aria-label="''');
    DBMS_OUTPUT.PUT_LINE('      +esc((wi.o===0?''Current window, '':offTxt(wi)+'' window, '')+wi.t+(wi.o===0?'''':''. Pin it''))+''"/>'';});');
    DBMS_OUTPUT.PUT_LINE('  setSvg(c,s);');
    DBMS_OUTPUT.PUT_LINE('  c.g={mode:''win'',pan:pan,W:Wd,padL:padL,padR:padR,top:top,ph:ph,pw:pw,d0:SP.dom[0],d1:SP.dom[1],ymax:ymax,ord:ord,hk:c.hk,cm:o.cm};');
    DBMS_OUTPUT.PUT_LINE('  if(c===CH[0])cpuHead();');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('function draw(c,force){');
    DBMS_OUTPUT.PUT_LINE('  if(!c||!SP||!shown(c.plot))return;');
    DBMS_OUTPUT.PUT_LINE('  /* the release flags go on the first chart shown, the x labels on the');
    DBMS_OUTPUT.PUT_LINE('     last one (both on one chart when a design shows a single chart) */');
    DBMS_OUTPUT.PUT_LINE('  var vis=CH.filter(function(x){return shown(x.plot);}),lay;c.flags=vis[0]===c;c.xl=vis[vis.length-1]===c;lay=(c.flags?1:0)+(c.xl?2:0);');
    DBMS_OUTPUT.PUT_LINE('  var Wd=Math.max(480,c.plot.clientWidth),d0=SP.dom[0],d1=SP.dom[1];');
    DBMS_OUTPUT.PUT_LINE('  if(!force&&c.w===Wd&&c.lay===lay&&c.g&&c.pw===PW&&c.g.d0===d0&&c.g.d1===d1&&c.g.hk===c.hk&&c.g.cm===cmp()&&(c.g.mode||''span'')===SP.mode)return;c.w=Wd;c.pw=PW;c.lay=lay;');
    DBMS_OUTPUT.PUT_LINE('  var mks=W.markers?W.markers():[],P=c.P;');
    DBMS_OUTPUT.PUT_LINE('  var cm=cmp(),padL=40,padR=14,pw=Wd-padL-padR,n=SP.win.length;');
    DBMS_OUTPUT.PUT_LINE('  /* the flag band only while a marker is in view: Full span = every marker');
    DBMS_OUTPUT.PUT_LINE('     (W.markers() all lie inside the span; kept while zoomed, so a brush');
    DBMS_OUTPUT.PUT_LINE('     never moves the charts), side by side = a marker in the gap before a');
    DBMS_OUTPUT.PUT_LINE('     panel shown (the most recent winFit(pw) windows) */');
    DBMS_OUTPUT.PUT_LINE('  var mkv=SP.mode===''win''?mks.filter(function(m){var ib=idxOf(m.o);return ib>=0&&ib>=n-Math.min(n,winFit(pw));}):mks;');
    DBMS_OUTPUT.PUT_LINE('  var top=c.flags&&mkv.length?46:22,ph=cm?96:150,bot=c.xl?26:8,H=top+ph+bot;');
    DBMS_OUTPUT.PUT_LINE('  c.svg.setAttribute(''viewBox'',''0 0 ''+Wd+'' ''+H);c.svg.setAttribute(''height'',H);');
    DBMS_OUTPUT.PUT_LINE('  var X=function(t){return padL+pw*(t-d0)/(d1-d0);};');
    DBMS_OUTPUT.PUT_LINE('  if(SP.mode===''win''){drawWin(c,{Wd:Wd,top:top,ph:ph,padL:padL,padR:padR,pw:pw,xl:c.xl,cm:cm,mks:mks});return;}');
    DBMS_OUTPUT.PUT_LINE('  /* stacked areas: one point per bucket at its midpoint, straight lines');
    DBMS_OUTPUT.PUT_LINE('     between them.  While a bucket is at least a pixel wide every bucket is');
    DBMS_OUTPUT.PUT_LINE('     a point; zoomed out further, one point per pixel column at the');
    DBMS_OUTPUT.PUT_LINE('     column''s busiest bucket (largest stacked total), so a one-bucket spike');
    DBMS_OUTPUT.PUT_LINE('     still shows; the tooltip always reads the bucket under the cursor.');
    DBMS_OUTPUT.PUT_LINE('     The first / last bucket of the data runs flat out to its edge. */');
    DBMS_OUTPUT.PUT_LINE('  /* the highlight (hlApply): on[k] = series k highlighted and shown; re-based');
    DBMS_OUTPUT.PUT_LINE('     (strong) = the highlighted series stacked first, from zero, the y axis');
    DBMS_OUTPUT.PUT_LINE('     fitted to them and each pixel column keeping THEIR busiest bucket */');
    DBMS_OUTPUT.PUT_LINE('  var h=hlOrd(c),hl=h.hl,on=h.on,reb=h.reb,ord=h.ord;');
    DBMS_OUTPUT.PUT_LINE('  var cp=colPts(c,refs(d0,d1),X,d0,d1,reb,on),pts=cp.pts,mx=cp.mx,mh=cp.mh;');
    DBMS_OUTPUT.PUT_LINE('  var yb=reb&&mh>0?Math.max(mh,0.05):mx,step=niceStep(yb,3),ymax=Math.ceil(yb/step-1e-9)*step;');
    DBMS_OUTPUT.PUT_LINE('  var Y=function(v){return top+ph-ph*v/ymax;},clip=''axclip-''+c.uid;');
    DBMS_OUTPUT.PUT_LINE('  var s=''<defs><clipPath id="''+clip+''"><rect x="''+padL+''" y="''+(top-6)+''" width="''+pw+''" height="''+(ph+6)+''"/></clipPath>''');
    DBMS_OUTPUT.PUT_LINE('    +(reb?''<clipPath id="''+clip+''f"><rect x="''+padL+''" y="''+top+''" width="''+pw+''" height="''+ph+''"/></clipPath>'':'''')+''</defs>'';');
    DBMS_OUTPUT.PUT_LINE('  for(var v=0;v<=ymax+1e-9;v+=step){var dec=step<1?(step<0.1?2:1):0;');
    DBMS_OUTPUT.PUT_LINE('    s+=''<line class="gl" x1="''+padL+''" x2="''+(Wd-padR)+''" y1="''+Y(v).toFixed(1)+''" y2="''+Y(v).toFixed(1)+''"/><text class="at" x="''+(padL-6)+''" y="''+(Y(v)+4).toFixed(1)+''" text-anchor="end">''+v.toFixed(dec)+''</text>'';}');
    DBMS_OUTPUT.PUT_LINE('  s+=''<text class="at" x="''+(padL-6)+''" y="''+(top-10)+''" text-anchor="end">AAS</text><g clip-path="url(#''+clip+'')">'';');
    DBMS_OUTPUT.PUT_LINE('  var B=bands(c,pts,ord,on,Y),fills=B.fills,edges=B.edges,hf=B.hf,he=B.he;');
    DBMS_OUTPUT.PUT_LINE('  if(!hl)s+=fills.reverse().join('''')+edges.reverse().join('''');');
    DBMS_OUTPUT.PUT_LINE('  /* fitted below the stack''s top, the faded stack would fill the plot: fainter then */');
    DBMS_OUTPUT.PUT_LINE('  else s+=(reb?''<g clip-path="url(#''+clip+''f)">'':'''')+''<g class="xfd" opacity="''+(reb&&ymax<mx?Math.min(hl.fade,0.07):hl.fade)+''">''+fills.reverse().join('''')+''</g>''+hf.join('''')+he.join('''')+(reb?''</g>'':'''');');
    DBMS_OUTPUT.PUT_LINE('  s+=''<rect class="xbk" x="0" y="''+top+''" width="0" height="''+ph+''" visibility="hidden"/>'';');
    DBMS_OUTPUT.PUT_LINE('  var ws=wins(),hit=[],cur=ws.length-1;');
    DBMS_OUTPUT.PUT_LINE('  SP.win.forEach(function(r,i){');
    DBMS_OUTPUT.PUT_LINE('    var xa=X(r[0]),xb=X(r[1]);if(xb<padL-2||xa>Wd-padR+2)return;');
    DBMS_OUTPUT.PUT_LINE('    var w=Math.max(i===cur?4:3,xb-xa),x=(xa+xb)/2-w/2,cls=(i===cur?'' cur'':'''')+(ws[i].o===PW?'' on'':'''')+(ws[i].v===''N''?'' sk'':'''')+(w>40?'' wd'':'''');');
    DBMS_OUTPUT.PUT_LINE('    s+=''<rect class="xw''+cls+''" x="''+x.toFixed(1)+''" y="''+top+''" width="''+w.toFixed(1)+''" height="''+ph+''"/><rect class="xwc''+cls+''" x="''+x.toFixed(1)+''" y="''+(top-5)+''" width="''+w.toFixed(1)+''" height="4" rx="1"/>'';');
    DBMS_OUTPUT.PUT_LINE('    hit.push([i,x,w]);');
    DBMS_OUTPUT.PUT_LINE('  });');
    DBMS_OUTPUT.PUT_LINE('  /* the cpu_count line (plan 042, the class chart only), then the bands');
    DBMS_OUTPUT.PUT_LINE('     named on the chart (dlab), above the stripes */');
    DBMS_OUTPUT.PUT_LINE('  var cq=cpuMark(c,Y,ymax,padL,Wd-padR,top,ph,noteBox(hl,padL,top));if(cq)s+=cq.s;');
    DBMS_OUTPUT.PUT_LINE('  s+=dlab(c,[{pts:pts,x0:padL,x1:Wd-padR}],ord,on,Y,reb,noteBox(hl,padL,top),cq&&cq.box);');
    DBMS_OUTPUT.PUT_LINE('  s+=''</g><line class="ax" x1="''+padL+''" x2="''+(Wd-padR)+''" y1="''+(top+ph)+''" y2="''+(top+ph)+''"/>'';');
    DBMS_OUTPUT.PUT_LINE('  /* x ticks: the smallest interval that leaves about 88 px per label, counted from');
    DBMS_OUTPUT.PUT_LINE('     midnight of the Current window''s day (weekly ticks land on its weekday);');
    DBMS_OUTPUT.PUT_LINE('     labels on the lower chart only -- one shared axis */');
    DBMS_OUTPUT.PUT_LINE('  var IVS=[5/60,10/60,0.25,0.5,1,2,3,6,12,24,48,168,336,672].map(function(h){return h*H1;}),iv=IVS[IVS.length-1];');
    DBMS_OUTPUT.PUT_LINE('  for(var q=0;q<IVS.length;q++){if(pw*IVS[q]/(d1-d0)>=88){iv=IVS[q];break;}}');
    DBMS_OUTPUT.PUT_LINE('  var org=Math.floor(SP.win[cur][0]/864e5)*864e5;');
    DBMS_OUTPUT.PUT_LINE('  for(var tt=org+Math.ceil((d0-org)/iv)*iv;tt<=d1;tt+=iv){');
    DBMS_OUTPUT.PUT_LINE('    var xt=X(tt);if(xt<padL+12||xt>Wd-padR-12)continue;');
    DBMS_OUTPUT.PUT_LINE('    s+=''<line class="ax" x1="''+xt.toFixed(1)+''" x2="''+xt.toFixed(1)+''" y1="''+(top+ph)+''" y2="''+(top+ph+4)+''"/>'';');
    DBMS_OUTPUT.PUT_LINE('    if(c.xl)s+=''<text class="at" x="''+xt.toFixed(1)+''" y="''+(top+ph+18)+''" text-anchor="middle">''+((iv>=24*H1||new Date(tt).getUTCHours()===0)?fDay(tt):fHM(tt))+''</text>'';');
    DBMS_OUTPUT.PUT_LINE('  }');
    DBMS_OUTPUT.PUT_LINE('  /* release markers: a line through the plot on both charts; the flags (two');
    DBMS_OUTPUT.PUT_LINE('     tiers) on the upper one */');
    DBMS_OUTPUT.PUT_LINE('  s+=flagSvg(c,mks.map(function(m){return {x:X(PT(m.at)),m:m};}),top,ph,Wd,padL,padR);');
    DBMS_OUTPUT.PUT_LINE('  if(hl&&hl.note)s+=''<text class="xhn" x="''+(padL+6)+''" y="''+(top+13)+''">''+esc(hl.note)+''</text>'';');
    DBMS_OUTPUT.PUT_LINE('  s+=''<line class="xch" x1="0" x2="0" y1="''+top+''" y2="''+(top+ph)+''" visibility="hidden"/>'';');
    DBMS_OUTPUT.PUT_LINE('  /* a stripe''s hit area: the whole stripe while it is narrow; zoomed into');
    DBMS_OUTPUT.PUT_LINE('     a window (a wide stripe) only its cap, so the plot under it hovers');
    DBMS_OUTPUT.PUT_LINE('     bucket by bucket and a drag there zooms */');
    DBMS_OUTPUT.PUT_LINE('  hit.forEach(function(q){');
    DBMS_OUTPUT.PUT_LINE('    var i=q[0],w=ws[i],hw=Math.max(12,q[2]),hx=q[1]+q[2]/2-hw/2,hh=q[2]>24?10:ph+6;');
    DBMS_OUTPUT.PUT_LINE('    s+=''<rect class="xwh" data-i="''+i+''" data-w="''+w.o+''" x="''+hx.toFixed(1)+''" y="''+(top-6)+''" width="''+hw.toFixed(1)+''" height="''+hh+''" tabindex="0" role="button" aria-label="''');
    DBMS_OUTPUT.PUT_LINE('      +esc((w.o===0?''Current window, '':offTxt(w)+'' window, '')+w.t+(w.o===0?'''':''. Pin it''))+''"/>'';');
    DBMS_OUTPUT.PUT_LINE('  });');
    DBMS_OUTPUT.PUT_LINE('  setSvg(c,s);');
    DBMS_OUTPUT.PUT_LINE('  c.g={mode:''span'',X:X,W:Wd,padL:padL,padR:padR,top:top,ph:ph,pw:pw,d0:d0,d1:d1,ymax:ymax,ord:ord,pts:pts,hk:c.hk,cm:cm};');
    DBMS_OUTPUT.PUT_LINE('  if(c===CH[0])cpuHead();');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('function tAt(c,cx){var x=toSvg(c,cx,0).x;return c.g.d0+(x-c.g.padL)/c.g.pw*(c.g.d1-c.g.d0);}');
    DBMS_OUTPUT.PUT_LINE('function bucketAt(t){var j=Math.floor((t-SP.t0)/SP.bh);return j>=0&&j<SP.T.length&&t<SP.T1[j]?j:-1;}');
    DBMS_OUTPUT.PUT_LINE('function hideCross(c){var hb=$(''.xbk'',c.svg),ch=$(''.xch'',c.svg);if(hb){hb.setAttribute(''visibility'',''hidden'');ch.setAttribute(''visibility'',''hidden'');}}');
    DBMS_OUTPUT.PUT_LINE('function hideAll(){CH.forEach(hideCross);}');
    DBMS_OUTPUT.PUT_LINE('/* the crosshair + bucket band at time t (bucket ref r) on chart c (side by');
    DBMS_OUTPUT.PUT_LINE('   side: in panel q) */');
    DBMS_OUTPUT.PUT_LINE('function cross(c,t,r,q){');
    DBMS_OUTPUT.PUT_LINE('  var hb=$(''.xbk'',c.svg),ch=$(''.xch'',c.svg);if(!c.g||!hb)return;');
    DBMS_OUTPUT.PUT_LINE('  var X=c.g.X,lo=c.g.padL,hi=c.g.W-c.g.padR;');
    DBMS_OUTPUT.PUT_LINE('  if(c.g.mode===''win''){var p=c.g.pan&&c.g.pan[q];if(!p){hideCross(c);return;}X=p.X;lo=p.x0;hi=p.x0+p.w;}');
    DBMS_OUTPUT.PUT_LINE('  var xa=Math.max(lo,X(rS(r))),xb=Math.min(hi,X(rE(r))),x=X(t);');
    DBMS_OUTPUT.PUT_LINE('  hb.setAttribute(''x'',xa.toFixed(1));hb.setAttribute(''width'',Math.max(1,xb-xa).toFixed(1));hb.setAttribute(''visibility'',''visible'');');
    DBMS_OUTPUT.PUT_LINE('  ch.setAttribute(''x1'',x.toFixed(1));ch.setAttribute(''x2'',x.toFixed(1));ch.setAttribute(''visibility'',''visible'');');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('/* the tooltip of ref r (a bucket or a minute) on chart c */');
    DBMS_OUTPUT.PUT_LINE('function ptTip(c,r,e){var P=c.P;');
    DBMS_OUTPUT.PUT_LINE('  tipOn(''<b>''+fAt(rS(r))+''\u2013''+fHM(rE(r))+''</b><br><span class="tm">''+(r<0?''1-min'':bLab((rE(r)-rS(r))/H1))+'' average, by ''+c.what+''</span>''');
    DBMS_OUTPUT.PUT_LINE('    +ashRows(P.classes,c.cols,function(q){return rV(c,q,r);},c.vis,c.noun,c.hl&&c.hl.set),e);');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('function hover(c,e){');
    DBMS_OUTPUT.PUT_LINE('  if(!c.g||DRAG&&DRAG.moved)return;');
    DBMS_OUTPUT.PUT_LINE('  var wh=e.target.closest&&e.target.closest(''.xwh''),P=c.P;');
    DBMS_OUTPUT.PUT_LINE('  if(wh){');
    DBMS_OUTPUT.PUT_LINE('    var i=+wh.getAttribute(''data-i''),w=wins()[i];hideAll();');
    DBMS_OUTPUT.PUT_LINE('    if(HT&&HT.soft)hlSet(null);');
    DBMS_OUTPUT.PUT_LINE('    tipOn(''<b>''+esc(w.t)+''</b><br><span class="tm">''+(w.o===0?''Current window'':offTxt(w)+'' window'')+(w.v===''N''?'', skipped'':'''')+'', by ''+c.what+''</span>''');
    DBMS_OUTPUT.PUT_LINE('      +(P.win?ashRows(P.classes,c.cols,function(k){return P.win[k][i];},c.vis,c.noun,c.hl&&c.hl.set):'''')+pkTip(w.o)+(w.o===0?'''':''<span class="tm">Click to pin this window</span>''),e);');
    DBMS_OUTPUT.PUT_LINE('    return;');
    DBMS_OUTPUT.PUT_LINE('  }');
    DBMS_OUTPUT.PUT_LINE('  if(c.g.mode===''win''){');
    DBMS_OUTPUT.PUT_LINE('    var pq=panAt(c,e.clientX),pr=pq?wRefAt(c,pq.q,pq.t):null;');
    DBMS_OUTPUT.PUT_LINE('    if(pr==null){hideAll();tipOff();if(HT&&HT.soft)hlSet(null);return;}');
    DBMS_OUTPUT.PUT_LINE('    if(!HS&&!DRAG){var pk=seriesAt(c,e.clientX,e.clientY);hlSet(pk<0?null:{c:c,k:pk,soft:true});}');
    DBMS_OUTPUT.PUT_LINE('    CH.forEach(function(o){cross(o,pq.t,pr,pq.q);});');
    DBMS_OUTPUT.PUT_LINE('    ptTip(c,pr,e);return;');
    DBMS_OUTPUT.PUT_LINE('  }');
    DBMS_OUTPUT.PUT_LINE('  var t=tAt(c,e.clientX),r=refAt(t);');
    DBMS_OUTPUT.PUT_LINE('  if(r==null||t<c.g.d0||t>c.g.d1){hideAll();tipOff();if(HT&&HT.soft)hlSet(null);return;}');
    DBMS_OUTPUT.PUT_LINE('  /* the band under the pointer highlights in place (not while one is sticky) */');
    DBMS_OUTPUT.PUT_LINE('  if(!HS&&!DRAG){var hk=seriesAt(c,e.clientX,e.clientY);hlSet(hk<0?null:{c:c,k:hk,soft:true});}');
    DBMS_OUTPUT.PUT_LINE('  CH.forEach(function(o){cross(o,t,r);});');
    DBMS_OUTPUT.PUT_LINE('  ptTip(c,r,e);');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('/* a window stripe: pin it (Current unpins); in the Timeline view the grid');
    DBMS_OUTPUT.PUT_LINE('   column flashes and comes into view */');
    DBMS_OUTPUT.PUT_LINE('function spSelect(i){');
    DBMS_OUTPUT.PUT_LINE('  var w=wins()[i];if(!w)return;');
    DBMS_OUTPUT.PUT_LINE('  if(w.o===0){if(PW!==null)W.pin(null);}else W.pin(w.o);');
    DBMS_OUTPUT.PUT_LINE('  flashCol(w.o);');
    DBMS_OUTPUT.PUT_LINE('  var tl=doc.getElementById(''tl'');if(!tl||!shown(tl))return;');
    DBMS_OUTPUT.PUT_LINE('  var r=tl.getBoundingClientRect();if(r.top>innerHeight-220)window.scrollBy({top:r.top-innerHeight+320,behavior:reduced()?''auto'':''smooth''});');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('function spZoom(a,b){');
    DBMS_OUTPUT.PUT_LINE('  a=Math.max(SP.full[0],a);b=Math.min(SP.full[1],b);');
    DBMS_OUTPUT.PUT_LINE('  var mn=SP.F&&fineCov(a,b)>0?Math.min(SP.min,FMIN):SP.min;');
    DBMS_OUTPUT.PUT_LINE('  if(b-a<mn){var m=(a+b)/2;a=Math.max(SP.full[0],m-mn/2);b=Math.min(SP.full[1],a+mn);a=Math.max(SP.full[0],b-mn);}');
    DBMS_OUTPUT.PUT_LINE('  SP.dom=[a,b];drawAll(true);');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('function spReset(){if(!SP)return;SP.dom=SP.full.slice();drawAll(true);}');
    DBMS_OUTPUT.PUT_LINE('/* ---- 7. the grid''s scroll: the sticky ruler follows the body, lane captions stay in view */');
    DBMS_OUTPUT.PUT_LINE('function sync(){var b=doc.getElementById(''tl-body''),i=doc.getElementById(''tl-in''),r=$(''#tl > .ruler'');if(!b||!i)return;if(r)r.scrollLeft=b.scrollLeft;i.style.setProperty(''--sl'',b.scrollLeft+''px'');i.style.setProperty(''--vw'',b.clientWidth+''px'');}');
    DBMS_OUTPUT.PUT_LINE('function startAtCurrent(){var b=doc.getElementById(''tl-body'');if(b&&b.scrollWidth>b.clientWidth+2&&!b.scrollLeft)b.scrollLeft=b.scrollWidth;sync();}');
    DBMS_OUTPUT.PUT_LINE('/* ---- boot */');
    DBMS_OUTPUT.PUT_LINE('doc.addEventListener(''DOMContentLoaded'',function(){');
    DBMS_OUTPUT.PUT_LINE('  tip=doc.getElementById(''tip'');if(!tip){tip=mk(''div'','''',doc.body);tip.id=''tip'';tip.setAttribute(''role'',''tooltip'');tip.hidden=true;}');
    DBMS_OUTPUT.PUT_LINE('  $$(''.sw[data-wc]'').forEach(function(s){s.style.setProperty(''--sw'',wcol(s.getAttribute(''data-wc'')));});');
    DBMS_OUTPUT.PUT_LINE('  AX=(window.AWR_DATA||{}).ashx||null;');
    DBMS_OUTPUT.PUT_LINE('  lanes();');
    DBMS_OUTPUT.PUT_LINE('  tools();');
    DBMS_OUTPUT.PUT_LINE('  activity();');
    DBMS_OUTPUT.PUT_LINE('  pkCard();');
    DBMS_OUTPUT.PUT_LINE('  cpuCard();');
    DBMS_OUTPUT.PUT_LINE('  spInit();');
    DBMS_OUTPUT.PUT_LINE('  var b=doc.getElementById(''tl-body'');if(b)b.addEventListener(''scroll'',sync,{passive:true});');
    DBMS_OUTPUT.PUT_LINE('  var tl=doc.getElementById(''tl'');if(tl&&W.render)W.render(tl);');
    DBMS_OUTPUT.PUT_LINE('  setTimeout(function(){drawAll(true);startAtCurrent();},60);');
    DBMS_OUTPUT.PUT_LINE('  var rt=null;window.addEventListener(''resize'',function(){if(rt)clearTimeout(rt);rt=setTimeout(function(){drawAll();sync();},120);});');
    DBMS_OUTPUT.PUT_LINE('});');
    DBMS_OUTPUT.PUT_LINE('})();');
    DBMS_OUTPUT.PUT_LINE('</script>');
END;
/
