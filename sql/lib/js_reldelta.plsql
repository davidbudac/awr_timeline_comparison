--
-- sql/lib/js_reldelta.plsql
--
-- The client script of section 28_release_delta (Before and after a release).
-- @@-included by sql/28_release_delta.sql, after its markup and payload.
--
-- No literal tilde below (SET DEFINE tilde).  GENERATED: the body below
-- (BEGIN .. END) is written by tools/js2plsql.sh from the readable source
-- sql/lib/src/js_reldelta.js -- edit that file and regenerate.
--
BEGIN
    DBMS_OUTPUT.PUT_LINE('<script>');
    DBMS_OUTPUT.PUT_LINE('/* js_reldelta: client half of section 28_release_delta (Before and after a');
    DBMS_OUTPUT.PUT_LINE('   release).  Reads window.AWR_DATA.reldelta (per-window values of every');
    DBMS_OUTPUT.PUT_LINE('   canonical LOAD / METRIC row and the wait classes), window.AWR_WIN (the');
    DBMS_OUTPUT.PUT_LINE('   compared windows, oldest first) and window.AWR_MARKERS (release');
    DBMS_OUTPUT.PUT_LINE('   markers); splits the VALID windows at a marker or a window boundary');
    DBMS_OUTPUT.PUT_LINE('   (before = ends at or before the instant, after = starts at or after it,');
    DBMS_OUTPUT.PUT_LINE('   a window containing it straddles) and draws one lollipop row per metric:');
    DBMS_OUTPUT.PUT_LINE('   the change of the after mean against the before mean, in percent on a');
    DBMS_OUTPUT.PUT_LINE('   symmetric axis, over the before windows'' own variation (mean +- 2 sd,');
    DBMS_OUTPUT.PUT_LINE('   sd floored at 2% of the mean).  HTML / CSS only (positions in percent),');
    DBMS_OUTPUT.PUT_LINE('   so it needs no width to draw and works with the CDN blocked.  Runs at');
    DBMS_OUTPUT.PUT_LINE('   parse time (the payload, AWR_WIN and AWR_MARKERS exist already). */');
    DBMS_OUTPUT.PUT_LINE('(function(){');
    DBMS_OUTPUT.PUT_LINE('var doc=document,R=window.AWR_DATA&&window.AWR_DATA.reldelta,sec=doc.getElementById("release-delta");');
    DBMS_OUTPUT.PUT_LINE('if(!R||!sec)return;');
    DBMS_OUTPUT.PUT_LINE('var app=sec.querySelector(".rd-app"),WIN=window.AWR_WIN;');
    DBMS_OUTPUT.PUT_LINE('if(!app||!WIN||!WIN.w||WIN.w.length<2)return;');
    DBMS_OUTPUT.PUT_LINE('var W=WIN.w,N=W.length,M=R.m||[];');
    DBMS_OUTPUT.PUT_LINE('var X=String.fromCharCode(215),UP=String.fromCharCode(9650),DN=String.fromCharCode(9660),MI=String.fromCharCode(8722),PM=String.fromCharCode(177);');
    DBMS_OUTPUT.PUT_LINE('var MON=["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"],DOW=["Sun","Mon","Tue","Wed","Thu","Fri","Sat"];');
    DBMS_OUTPUT.PUT_LINE('function $(s,r){return (r||app).querySelector(s);}');
    DBMS_OUTPUT.PUT_LINE('function mk(t,c,p){var e=doc.createElement(t);if(c)e.className=c;if(p)p.appendChild(e);return e;}');
    DBMS_OUTPUT.PUT_LINE('function esc(s){return String(s).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;");}');
    DBMS_OUTPUT.PUT_LINE('function dt(t){var d=new Date(String(t).replace(" ","T"));return isNaN(d.getTime())?null:d;}');
    DBMS_OUTPUT.PUT_LINE('function dayTxt(t){var d=dt(t);return d?DOW[d.getDay()]+" "+d.getDate()+" "+MON[d.getMonth()]:String(t);}');
    DBMS_OUTPUT.PUT_LINE('function dtTxt(t){var d=dt(t);if(!d)return String(t);var h=d.getHours(),m=d.getMinutes();return dayTxt(t)+" "+(h<10?"0":"")+h+":"+(m<10?"0":"")+m;}');
    DBMS_OUTPUT.PUT_LINE('function lc(s){return s.length>1&&s.charAt(1)===s.charAt(1).toLowerCase()?s.charAt(0).toLowerCase()+s.slice(1):s;}');
    DBMS_OUTPUT.PUT_LINE('/* numbers: about 4 significant digits, k / M / G past 1e4 (fmt_num''s rule) */');
    DBMS_OUTPUT.PUT_LINE('function fnum(v){if(v==null||isNaN(v))return "&mdash;";');
    DBMS_OUTPUT.PUT_LINE('  if(v===0)return "0";var a=Math.abs(v),s=v<0?"-":"",u="";');
    DBMS_OUTPUT.PUT_LINE('  if(a>=1e9){a/=1e9;u=" G";}else if(a>=1e6){a/=1e6;u=" M";}else if(a>=1e4){a/=1e3;u=" k";}');
    DBMS_OUTPUT.PUT_LINE('  var t=a>=1000?String(Math.round(a)):a>=100?a.toFixed(1):a>=10?a.toFixed(2):a>=1?a.toFixed(3):a.toPrecision(3);');
    DBMS_OUTPUT.PUT_LINE('  if(t.indexOf(".")>=0&&a<1)t=t.replace(/0+$/,"").replace(/\.$/,"");');
    DBMS_OUTPUT.PUT_LINE('  return s+t+u;}');
    DBMS_OUTPUT.PUT_LINE('function fv(v,u){if(v==null||isNaN(v))return "&mdash;";');
    DBMS_OUTPUT.PUT_LINE('  if(u==="B/s"){var a=Math.abs(v);if(a>=1e9)return fnum(v/1e9)+" GB/s";if(a>=1e6)return fnum(v/1e6)+" MB/s";if(a>=1e3)return fnum(v/1e3)+" kB/s";return fnum(v)+" B/s";}');
    DBMS_OUTPUT.PUT_LINE('  return fnum(v)+(!u?"":u.charAt(0)==="/"?u:" "+u);}');
    DBMS_OUTPUT.PUT_LINE('function pct(p){var a=Math.abs(p),t=a<10?a.toFixed(1):String(Math.round(a));return (p>0?"+":p<0?MI:"")+t+"%";}');
    DBMS_OUTPUT.PUT_LINE('/* the change label: x n when after / before >= 2 (delta_span''s rule), else a signed percent */');
    DBMS_OUTPUT.PUT_LINE('function chgTxt(r){if(r.zero)return "from 0";var q=r.ma/r.mb;if(r.mb>0&&q>=2)return X+(q<10?q.toFixed(1):String(Math.round(q)));return pct(r.chg);}');
    DBMS_OUTPUT.PUT_LINE('function mean(a){var s=0;a.forEach(function(v){s+=v;});return s/a.length;}');
    DBMS_OUTPUT.PUT_LINE('function sdev(a,m){if(a.length<2)return 0;var s=0;a.forEach(function(v){s+=(v-m)*(v-m);});return Math.sqrt(s/(a.length-1));}');
    DBMS_OUTPUT.PUT_LINE('/* ---- the split: valid windows before / after an instant (strings compare as ''YYYY-MM-DD HH:MI'') */');
    DBMS_OUTPUT.PUT_LINE('function split(t){var b=[],a=[],s=[],k=0;');
    DBMS_OUTPUT.PUT_LINE('  W.forEach(function(w){if(w.v!=="Y"){k++;return;}if(w.e<=t)b.push(w);else if(w.s>=t)a.push(w);else s.push(w);});');
    DBMS_OUTPUT.PUT_LINE('  return {t:t,b:b,a:a,s:s,k:k};}');
    DBMS_OUTPUT.PUT_LINE('function whyNot(sp){if(sp.b.length<2)return "only "+(sp.b.length?"one valid window":"no valid window")+" before it (needs 2)";');
    DBMS_OUTPUT.PUT_LINE('  if(!sp.a.length)return sp.s.length?"it falls inside the "+(sp.s[sp.s.length-1].o===0?"Current window":"last window")+", no complete window after it":"no valid window after it";');
    DBMS_OUTPUT.PUT_LINE('  return "";}');
    DBMS_OUTPUT.PUT_LINE('var MKS=[],OUT=[];');
    DBMS_OUTPUT.PUT_LINE('(window.AWR_MARKERS||[]).forEach(function(m){var t=String(m.t||""),l=String(m.label||"");if(!t)return;');
    DBMS_OUTPUT.PUT_LINE('  var o={t:t,l:l};if(t<W[0].s||t>=W[N-1].e){OUT.push(o);return;}o.sp=split(t);o.why=whyNot(o.sp);MKS.push(o);});');
    DBMS_OUTPUT.PUT_LINE('MKS.sort(function(x,y){return x.t<y.t?1:x.t>y.t?-1:0;});');
    DBMS_OUTPUT.PUT_LINE('/* ---- per-metric statistics for one split */');
    DBMS_OUTPUT.PUT_LINE('function stats(sp){var rows=[],na=[],wt=0;');
    DBMS_OUTPUT.PUT_LINE('  M.forEach(function(m){var B=[],A=[];');
    DBMS_OUTPUT.PUT_LINE('    sp.b.forEach(function(w){var v=m.v[w.o];if(v!=null)B.push(v);});');
    DBMS_OUTPUT.PUT_LINE('    sp.a.forEach(function(w){var v=m.v[w.o];if(v!=null)A.push({o:w.o,v:v});});');
    DBMS_OUTPUT.PUT_LINE('    if(B.length<2||!A.length){na.push(m);return;}');
    DBMS_OUTPUT.PUT_LINE('    var mb=mean(B),sd=sdev(B,mb),ma=mean(A.map(function(x){return x.v;})),den=Math.max(sd,0.02*Math.abs(mb));');
    DBMS_OUTPUT.PUT_LINE('    var r={m:m,nb:B.length,na:A.length,mb:mb,sd:sd,ma:ma,av:A,zero:false};');
    DBMS_OUTPUT.PUT_LINE('    if(mb===0){r.chg=ma===0?0:null;r.zero=ma!==0;r.band=0;r.z=ma===0?0:(den>0?(ma-mb)/den:Infinity);}');
    DBMS_OUTPUT.PUT_LINE('    else{r.chg=(ma-mb)/Math.abs(mb)*100;r.band=200*den/Math.abs(mb);r.z=(ma-mb)/den;}');
    DBMS_OUTPUT.PUT_LINE('    r.out=Math.abs(r.z)>2;if(m.d==="W")wt+=ma;rows.push(r);});');
    DBMS_OUTPUT.PUT_LINE('  rows.forEach(function(r){var m=r.m,mat=r.chg==null||Math.abs(r.chg)>=(m.mp==null?10:m.mp);');
    DBMS_OUTPUT.PUT_LINE('    if(mat&&m.ma!=null){if(m.d==="W"){if(wt>0&&r.ma/wt<m.ma)mat=false;}else if(Math.max(Math.abs(r.ma),Math.abs(r.mb))<m.ma)mat=false;}');
    DBMS_OUTPUT.PUT_LINE('    r.mat=mat;var up=r.ma>r.mb;');
    DBMS_OUTPUT.PUT_LINE('    r.st=!r.out?"inside":!mat?"small":m.dir==="UP"?(up?"worse":"better"):m.dir==="DOWN"?(up?"better":"worse"):"changed";');
    DBMS_OUTPUT.PUT_LINE('    r.flag=r.st==="worse"||r.st==="better"||r.st==="changed";});');
    DBMS_OUTPUT.PUT_LINE('  rows.sort(function(x,y){if(x.flag!==y.flag)return x.flag?-1:1;var d=Math.abs(y.z)-Math.abs(x.z);return d||(x.m.l<y.m.l?-1:1);});');
    DBMS_OUTPUT.PUT_LINE('  return {rows:rows,na:na};}');
    DBMS_OUTPUT.PUT_LINE('/* ---- the chart: one row per metric, percent positions on a symmetric axis */');
    DBMS_OUTPUT.PUT_LINE('var STEPS=[10,20,25,50,100,150,200,300,400];');
    DBMS_OUTPUT.PUT_LINE('function scaleOf(rows){var mx=0;rows.forEach(function(r){var c=r.chg==null?400:Math.abs(r.chg);mx=Math.max(mx,Math.min(400,c),Math.min(400,r.band));');
    DBMS_OUTPUT.PUT_LINE('    r.av.forEach(function(a){if(r.mb)mx=Math.max(mx,Math.min(400,Math.abs((a.v-r.mb)/r.mb*100)));});});');
    DBMS_OUTPUT.PUT_LINE('  for(var i=0;i<STEPS.length;i++)if(STEPS[i]>=mx*1.08)return STEPS[i];return 400;}');
    DBMS_OUTPUT.PUT_LINE('function xp(p,L){p=Math.max(-L,Math.min(L,p));return (p+L)/(2*L)*100;}');
    DBMS_OUTPUT.PUT_LINE('function f2(v){return (Math.round(v*100)/100)+"%";}');
    DBMS_OUTPUT.PUT_LINE('var WORD={worse:"worse",better:"better",changed:"changed",small:"small move",inside:"inside"};');
    DBMS_OUTPUT.PUT_LINE('function glyph(r){return r.ma>r.mb?UP:r.ma<r.mb?DN:"";}');
    DBMS_OUTPUT.PUT_LINE('function tipHtml(r,L){var m=r.m,u=m.u,s=m.s;');
    DBMS_OUTPUT.PUT_LINE('  var h=''<b>''+esc(m.l)+''</b><br>before: ''+fv(r.mb*s,u)+'' ''+PM+'' ''+fv(r.sd*s,u)+'' (''+r.nb+'' window''+(r.nb>1?''s'':'''')+'')<br>after: ''+fv(r.ma*s,u)+'' (''+r.na+'' window''+(r.na>1?''s'':'''')+'')'';');
    DBMS_OUTPUT.PUT_LINE('  h+=''<br>change: ''+(r.zero?''from 0'':pct(r.chg)+(chgTxt(r)!==pct(r.chg)?'' (''+chgTxt(r)+'')'':''''));');
    DBMS_OUTPUT.PUT_LINE('  if(!r.zero&&r.mb)h+=''<br><span class="tm">usual variation before: ''+PM+(r.band<10?r.band.toFixed(1):Math.round(r.band))+''%</span>'';');
    DBMS_OUTPUT.PUT_LINE('  if(r.chg==null||Math.abs(r.chg)>L)h+=''<br><span class="tm">off the scale (beyond ''+PM+L+''%)</span>'';');
    DBMS_OUTPUT.PUT_LINE('  h+=''<br>''+(r.flag?''<b>''+glyph(r)+'' ''+WORD[r.st]+''</b>: outside its usual variation'':r.st==="small"?''outside its usual variation, but by less than its ''+(m.mp==null?10:m.mp)+''% materiality floor'':''inside its usual variation'');');
    DBMS_OUTPUT.PUT_LINE('  if(r.na>1)h+=''<br><span class="tm">each window after: ''+r.av.map(function(a){return fv(a.v*s,u);}).join('', '')+''</span>'';');
    DBMS_OUTPUT.PUT_LINE('  return h;}');
    DBMS_OUTPUT.PUT_LINE('var tip=null;');
    DBMS_OUTPUT.PUT_LINE('function tipOn(html,e){tip=tip||doc.getElementById("tip");if(!tip){tip=mk("div","",doc.body);tip.id="tip";tip.setAttribute("role","tooltip");}');
    DBMS_OUTPUT.PUT_LINE('  tip.innerHTML=html;tip.hidden=false;var x=e.clientX+14,y=e.clientY+16,w=tip.offsetWidth,h=tip.offsetHeight;');
    DBMS_OUTPUT.PUT_LINE('  if(x+w>innerWidth-8)x=e.clientX-w-12;if(y+h>innerHeight-8)y=e.clientY-h-12;tip.style.left=Math.max(8,x)+"px";tip.style.top=Math.max(8,y)+"px";}');
    DBMS_OUTPUT.PUT_LINE('function tipOff(){if(tip)tip.hidden=true;}');
    DBMS_OUTPUT.PUT_LINE('function axisRow(box,L,head,clipped){var r=mk("div","rd-r rd-ax",box);r.setAttribute("aria-hidden","true");');
    DBMS_OUTPUT.PUT_LINE('  mk("span","rd-lab",r).textContent=head;var sc=mk("span","rd-sc",mk("span","rd-st",r)),i;');
    DBMS_OUTPUT.PUT_LINE('  for(i=-2;i<=2;i++){var p=L*i/2,e=mk("em",i?"":"z",sc);e.style.left=xp(p,L)+"%";');
    DBMS_OUTPUT.PUT_LINE('    e.textContent=(i===2&&L===400&&clipped)?"> "+X+"5":i===0?"0":pct(p).replace(".0%","%");}');
    DBMS_OUTPUT.PUT_LINE('  mk("span","rd-w",r).textContent="status";}');
    DBMS_OUTPUT.PUT_LINE('function row(box,r,L){var m=r.m,e=mk("div","rd-r s-"+r.st+(r.flag?" fl":""),box),lab=mk("span","rd-lab",e),t=doc.getElementById(m.id);');
    DBMS_OUTPUT.PUT_LINE('  e.setAttribute("role","listitem");');
    DBMS_OUTPUT.PUT_LINE('  if(t){var a=mk("a","",lab);a.className="ent";a.href="#"+m.id;a.setAttribute("data-ent","metric");a.textContent=m.l;}else lab.textContent=m.l;');
    DBMS_OUTPUT.PUT_LINE('  lab.title=m.n;');
    DBMS_OUTPUT.PUT_LINE('  var st=mk("span","rd-st",e),sc=mk("span","rd-sc",st),i;st.setAttribute("role","img");');
    DBMS_OUTPUT.PUT_LINE('  var lbl=chgTxt(r),cl=r.chg==null||Math.abs(r.chg)>L,c=r.chg==null?(r.ma>r.mb?L:-L):r.chg,x=xp(c,L),x0=xp(0,L);');
    DBMS_OUTPUT.PUT_LINE('  st.setAttribute("aria-label",m.l+": "+lbl+" after the split, usual variation "+PM+(r.zero?"0":Math.round(r.band))+"%, "+(r.flag?WORD[r.st]:r.st==="small"?"outside but small":"inside its usual variation"));');
    DBMS_OUTPUT.PUT_LINE('  for(i=-2;i<=2;i++)mk("i","rd-g"+(i?"":" z"),sc).style.left=xp(L*i/2,L)+"%";');
    DBMS_OUTPUT.PUT_LINE('  if(r.band>0){var bl=xp(-r.band,L),b=mk("i","rd-band",sc);b.style.left=bl+"%";b.style.width=(xp(r.band,L)-bl)+"%";}');
    DBMS_OUTPUT.PUT_LINE('  var sm=mk("i","rd-stem",sc);sm.style.left=Math.min(x,x0)+"%";sm.style.width=Math.abs(x-x0)+"%";');
    DBMS_OUTPUT.PUT_LINE('  var tx=[];if(r.na>1&&r.mb)r.av.forEach(function(a){var q=xp((a.v-r.mb)/Math.abs(r.mb)*100,L);tx.push(q);mk("i","rd-tk",sc).style.left=q+"%";});');
    DBMS_OUTPUT.PUT_LINE('  mk("i","rd-dot"+(r.na>1?"":" hol")+(cl?" clip"+(c<0?" neg":""):""),sc).style.left=x+"%";');
    DBMS_OUTPUT.PUT_LINE('  var vx=c>=0?Math.max.apply(null,[x,xp(r.band,L)].concat(tx)):Math.min.apply(null,[x,xp(-r.band,L)].concat(tx)),v=mk("b","rd-val"+(c<0?" neg":""),sc);');
    DBMS_OUTPUT.PUT_LINE('  v.style.left=vx+"%";v.textContent=(r.out?glyph(r)+" ":"")+lbl;');
    DBMS_OUTPUT.PUT_LINE('  mk("span","rd-w",e).textContent=(r.flag?glyph(r)+" ":"")+WORD[r.st];');
    DBMS_OUTPUT.PUT_LINE('  st.addEventListener("mousemove",function(ev){tipOn(tipHtml(r,L),ev);});st.addEventListener("mouseleave",tipOff);}');
    DBMS_OUTPUT.PUT_LINE('function chart(box,rows,head){box.innerHTML="";if(!rows.length)return;var L=scaleOf(rows),clipped=false;');
    DBMS_OUTPUT.PUT_LINE('  rows.forEach(function(r){if(r.chg==null||Math.abs(r.chg)>L)clipped=true;});');
    DBMS_OUTPUT.PUT_LINE('  axisRow(box,L,head,clipped);rows.forEach(function(r){row(box,r,L);});}');
    DBMS_OUTPUT.PUT_LINE('/* ---- the numbers of the split (a real table; the chrome sorts it) */');
    DBMS_OUTPUT.PUT_LINE('function table(S){var tb=$(".rd-tbl tbody");if(!tb)return;var h=[];');
    DBMS_OUTPUT.PUT_LINE('  S.rows.concat(S.na.map(function(m){return {m:m,nil:true};})).forEach(function(r){var m=r.m,u=m.u,s=m.s,');
    DBMS_OUTPUT.PUT_LINE('    lk=doc.getElementById(m.id)?''<a href="#''+m.id+''" data-ent="metric">''+esc(m.l)+''</a>'':esc(m.l);');
    DBMS_OUTPUT.PUT_LINE('    if(r.nil){h.push(''<tr><td>''+lk+''</td><td class="num">&mdash;</td><td class="num">&mdash;</td><td class="num">&mdash;</td><td class="num">&mdash;</td><td class="num">&mdash;</td><td class="num">&mdash;</td><td class="num">&mdash;</td><td>not enough windows</td></tr>'');return;}');
    DBMS_OUTPUT.PUT_LINE('    h.push(''<tr class="rd-''+r.st+''"><td>''+lk+''</td><td class="num">''+fv(r.mb*s,u)+''</td><td class="num">''+fv(r.sd*s,u)+''</td><td class="num">''+r.nb');
    DBMS_OUTPUT.PUT_LINE('      +''</td><td class="num">''+fv(r.ma*s,u)+''</td><td class="num">''+r.na+''</td><td class="num">''+(r.zero?''from 0'':pct(r.chg))');
    DBMS_OUTPUT.PUT_LINE('      +''</td><td class="num">''+(r.zero||!r.mb?''&mdash;'':PM+f2(Math.round(r.band*10)/10))+''</td><td>''+(r.flag?glyph(r)+'' '':'''')+WORD[r.st]+''</td></tr>'');});');
    DBMS_OUTPUT.PUT_LINE('  tb.innerHTML=h.join("");');
    DBMS_OUTPUT.PUT_LINE('  /* entity links: the chrome styles a.ent; set the class as a property (lint 21 keeps the literal in ent()) */');
    DBMS_OUTPUT.PUT_LINE('  Array.prototype.forEach.call(tb.querySelectorAll("a[data-ent]"),function(a){a.className="ent";});}');
    DBMS_OUTPUT.PUT_LINE('/* ---- render one split, or the invitation */');
    DBMS_OUTPUT.PUT_LINE('var CUR=null;');
    DBMS_OUTPUT.PUT_LINE('function nameOf(o){return o.mk?o.mk.l+" ("+dayTxt(o.mk.t)+")":"the boundary at "+dtTxt(o.t);}');
    DBMS_OUTPUT.PUT_LINE('/* a window''s start: the day, plus the time when the cadence is under a day */');
    DBMS_OUTPUT.PUT_LINE('var SUB=dt(W[1].s)&&dt(W[0].s)&&(dt(W[1].s)-dt(W[0].s))<864e5;');
    DBMS_OUTPUT.PUT_LINE('function wTxt(w){return SUB?dtTxt(w.s):dayTxt(w.s);}');
    DBMS_OUTPUT.PUT_LINE('function rangeTxt(ws){if(!ws.length)return "none";if(ws.length===1)return ws[0].o===0?"1 (Current)":"1 ("+wTxt(ws[0])+")";');
    DBMS_OUTPUT.PUT_LINE('  return ws.length+" ("+wTxt(ws[0])+" &ndash; "+(ws[ws.length-1].o===0?"Current":wTxt(ws[ws.length-1]))+")";}');
    DBMS_OUTPUT.PUT_LINE('function render(o){CUR=o;var body=$(".rd-body"),why=$(".rd-why"),side=$(".rd-side");');
    DBMS_OUTPUT.PUT_LINE('  Array.prototype.forEach.call(app.querySelectorAll(".rd-mb"),function(b){b.setAttribute("aria-pressed",o&&o.mk&&b._mk===o.mk?"true":"false");});');
    DBMS_OUTPUT.PUT_LINE('  if(!o){body.hidden=true;side.innerHTML="";why.hidden=false;');
    DBMS_OUTPUT.PUT_LINE('    why.innerHTML=(MKS.length?"No release marker falls on a usable boundary of the compared windows (see above).":OUT.length?"No release marker falls inside the compared span (see above).":"No release markers in this run.")');
    DBMS_OUTPUT.PUT_LINE('      +" Set them when you run the report, for example <code>MARKERS=''2026-09-08 22:00|Release 4.2''</code> (or <code>marker_file</code>), or pick a window boundary above: the view then compares the windows before it with the windows after it.";');
    DBMS_OUTPUT.PUT_LINE('    return null;}');
    DBMS_OUTPUT.PUT_LINE('  why.hidden=true;body.hidden=false;var sp=o.sp,S=stats(sp);');
    DBMS_OUTPUT.PUT_LINE('  side.innerHTML="<b>Before:</b> "+rangeTxt(sp.b)+" valid windows &middot; <b>after:</b> "+rangeTxt(sp.a)');
    DBMS_OUTPUT.PUT_LINE('    +(sp.s.length?" &middot; <b>straddles</b> (in neither): "+sp.s.map(wTxt).join(", "):"")');
    DBMS_OUTPUT.PUT_LINE('    +(sp.k?" &middot; "+sp.k+" skipped window"+(sp.k>1?"s":""):"");');
    DBMS_OUTPUT.PUT_LINE('  var fl=S.rows.filter(function(r){return r.flag;}),main=S.rows.slice(0,Math.min(24,Math.max(12,fl.length))),rest=S.rows.slice(main.length);');
    DBMS_OUTPUT.PUT_LINE('  chart($(".rd-chart"),main,"change of the after mean vs before");');
    DBMS_OUTPUT.PUT_LINE('  var more=$(".rd-more"),nin=rest.filter(function(r){return r.st==="inside";}).length;');
    DBMS_OUTPUT.PUT_LINE('  more.hidden=!rest.length&&!S.na.length;chart($(".rd-chart2"),rest,"change vs before");');
    DBMS_OUTPUT.PUT_LINE('  var sm=more.querySelector("summary");');
    DBMS_OUTPUT.PUT_LINE('  sm.innerHTML=!rest.length?S.na.length+" without enough windows":nin===rest.length?"+ "+rest.length+" within usual variation":"+ "+rest.length+" more ("+nin+" within usual variation)";');
    DBMS_OUTPUT.PUT_LINE('  var nap=more.querySelector(".rd-na");if(nap)nap.remove();');
    DBMS_OUTPUT.PUT_LINE('  if(S.na.length){nap=mk("p","rd-na note",more);nap.textContent="Not enough windows on one side (2 before, 1 after needed): "+S.na.map(function(m){return m.l;}).join(", ")+".";}');
    DBMS_OUTPUT.PUT_LINE('  table(S);');
    DBMS_OUTPUT.PUT_LINE('  /* Reads as */');
    DBMS_OUTPUT.PUT_LINE('  var n=S.rows.length,nsm=S.rows.filter(function(r){return r.st==="small";}).length,lst=fl.slice(0,3).map(function(r){return esc(lc(r.m.l))+" "+chgTxt(r);}).join(", ");');
    DBMS_OUTPUT.PUT_LINE('  var one=sp.a.length===1?" Only one window after it"+(sp.a[0].o===0?" (Current)":"")+": a single window, not yet a trend.":"";');
    DBMS_OUTPUT.PUT_LINE('  var head="After "+esc(nameOf(o)),txt;');
    DBMS_OUTPUT.PUT_LINE('  if(fl.length)txt=head+": "+fl.length+" of "+n+" metrics moved outside their usual variation &mdash; "+lst+(fl.length>3?" and "+(fl.length-3)+" more":"")');
    DBMS_OUTPUT.PUT_LINE('    +"; "+(n-fl.length-nsm)+" stayed inside"+(nsm?", "+nsm+" moved outside it by too little to matter":"")+"."+one;');
    DBMS_OUTPUT.PUT_LINE('  else txt=head+": none of the "+n+" metrics moved outside its usual variation"+(nsm?" by enough to matter ("+nsm+" moved slightly outside it)":"")+"."+one;');
    DBMS_OUTPUT.PUT_LINE('  $(".rd-reads").innerHTML="<b>Reads as:</b> "+txt;');
    DBMS_OUTPUT.PUT_LINE('  return {fl:fl,n:n,lst:lst,head:head};}');
    DBMS_OUTPUT.PUT_LINE('/* ---- the picker: one button per usable marker (newest first) + any window boundary */');
    DBMS_OUTPUT.PUT_LINE('var mks=$(".rd-mks"),sel=$(".rd-sel"),i;');
    DBMS_OUTPUT.PUT_LINE('MKS.forEach(function(m){if(m.why)return;var b=mk("button","rd-mb",mks);b.type="button";b._mk=m;');
    DBMS_OUTPUT.PUT_LINE('  b.innerHTML=esc(m.l)+"<small>"+dayTxt(m.t)+"</small>";b.title=m.l+" at "+m.t+": "+m.sp.b.length+" valid windows before, "+m.sp.a.length+" after";');
    DBMS_OUTPUT.PUT_LINE('  b.addEventListener("click",function(){sel.value="";render({mk:m,t:m.t,sp:m.sp});});});');
    DBMS_OUTPUT.PUT_LINE('if(!mks.children.length)mk("span","rd-none",mks).textContent=MKS.length||OUT.length?"no usable release marker":"no release markers";');
    DBMS_OUTPUT.PUT_LINE('var o0=mk("option","",sel);o0.value="";o0.textContent="choose a boundary";');
    DBMS_OUTPUT.PUT_LINE('for(i=N-1;i>=1;i--){var sp=split(W[i].s),op=mk("option","",sel),wn=whyNot(sp);op.value=String(i);');
    DBMS_OUTPUT.PUT_LINE('  op.textContent="before "+W[i].t+(W[i].o===0?" (Current)":"")+(wn?" - "+wn:"");if(wn)op.disabled=true;}');
    DBMS_OUTPUT.PUT_LINE('sel.addEventListener("change",function(){if(sel.value===""){render(null);return;}var k=+sel.value;render({t:W[k].s,sp:split(W[k].s)});});');
    DBMS_OUTPUT.PUT_LINE('/* markers that cannot split: listed under the picker with the reason */');
    DBMS_OUTPUT.PUT_LINE('var skip=MKS.filter(function(m){return m.why;}).map(function(m){return "<b>"+esc(m.l)+"</b> ("+dtTxt(m.t)+"): "+esc(m.why);})');
    DBMS_OUTPUT.PUT_LINE('  .concat(OUT.map(function(m){return "<b>"+esc(m.l)+"</b> ("+dtTxt(m.t)+"): outside the compared span";}));');
    DBMS_OUTPUT.PUT_LINE('if(skip.length){var sk=mk("p","rd-skip",null);sk.innerHTML="Not usable: "+skip.join("; ")+".";$(".rd-pick").insertAdjacentElement("afterend",sk);}');
    DBMS_OUTPUT.PUT_LINE('var nojs=sec.querySelector(".rd-nojs");if(nojs)nojs.hidden=true;');
    DBMS_OUTPUT.PUT_LINE('app.hidden=false;');
    DBMS_OUTPUT.PUT_LINE('var first=null;MKS.forEach(function(m){if(!first&&!m.why)first=m;});');
    DBMS_OUTPUT.PUT_LINE('var res=render(first?{mk:first,t:first.t,sp:first.sp}:null);');
    DBMS_OUTPUT.PUT_LINE('/* the evidence-library row: the default split''s answer */');
    DBMS_OUTPUT.PUT_LINE('if(window.AWR_ls){');
    DBMS_OUTPUT.PUT_LINE('  if(res)window.AWR_ls("release-delta",res.head+": "+(res.fl.length?res.fl.length+" of "+res.n+" metrics outside their usual variation &mdash; "+res.lst:"every metric inside its usual variation"));');
    DBMS_OUTPUT.PUT_LINE('  else window.AWR_ls("release-delta",(MKS.length||OUT.length?"no release marker on a usable boundary":"no release markers")+"; pick a window boundary to split "+R.nv+" valid windows");}');
    DBMS_OUTPUT.PUT_LINE('})();');
    DBMS_OUTPUT.PUT_LINE('</script>');
END;
/
