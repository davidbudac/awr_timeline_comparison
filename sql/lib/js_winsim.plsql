--
-- sql/lib/js_winsim.plsql
--
-- The client script of section 26_window_similarity (Window similarity):
-- reads window.AWR_DATA.winsim and draws the similarity matrix (inline SVG
-- up to 60 windows, a canvas past that), the per-window distance bars and
-- the what-if (chips, suggestions, re-scored buckets).  Its bucket() is a
-- TWIN of policy_bucket() in sql/lib/metric_policy.plsql -- keep the two in
-- lockstep; the script checks itself against the PL/SQL buckets on load
-- (window.AWR_WINSIM.check, console.error on a mismatch).
-- @@-included by sql/26_window_similarity.sql, after its markup and payload.
--
-- No literal tilde below (SET DEFINE tilde).  GENERATED: the body below
-- (BEGIN .. END) is written by tools/js2plsql.sh from the readable source
-- sql/lib/src/js_winsim.js -- edit that file and regenerate.
--
BEGIN
    DBMS_OUTPUT.PUT_LINE('<script>');
    DBMS_OUTPUT.PUT_LINE('/* js_winsim: client half of sql/26_window_similarity.sql (Window similarity).');
    DBMS_OUTPUT.PUT_LINE('   Reads AWR_DATA.winsim (built by the section, oldest window first like');
    DBMS_OUTPUT.PUT_LINE('   AWR_WIN) and draws Part 1 (the similarity matrix + each window''s');
    DBMS_OUTPUT.PUT_LINE('   distance from the prior windows) and Part 2 (the what-if: drop prior');
    DBMS_OUTPUT.PUT_LINE('   windows, re-score every metric).');
    DBMS_OUTPUT.PUT_LINE('   bucket() below is a TWIN of policy_bucket() in sql/lib/metric_policy.plsql');
    DBMS_OUTPUT.PUT_LINE('   (z over max(sample sd, 2% of |mean|), n < 3 insufficient history, |z| > 3');
    DBMS_OUTPUT.PUT_LINE('   large / > 2 moderate, materiality by min_pct / min_abs / share, then the');
    DBMS_OUTPUT.PUT_LINE('   direction).  The two MUST stay in lockstep: with nothing dropped every');
    DBMS_OUTPUT.PUT_LINE('   metric''s bucket is compared with the PL/SQL one ("pb"), and with each');
    DBMS_OUTPUT.PUT_LINE('   suggestion''s windows dropped with "sb"[s]; a mismatch goes to console.error');
    DBMS_OUTPUT.PUT_LINE('   and window.AWR_WINSIM.check.  Inline SVG / canvas, colours from CSS. */');
    DBMS_OUTPUT.PUT_LINE('(function(){');
    DBMS_OUTPUT.PUT_LINE('''use strict'';');
    DBMS_OUTPUT.PUT_LINE('var doc=document,D=window.AWR_DATA&&window.AWR_DATA.winsim,AW=window.AWR_WIN;');
    DBMS_OUTPUT.PUT_LINE('if(!D||!AW||!AW.w||!D.w||D.w.length!==AW.w.length)return;');
    DBMS_OUTPUT.PUT_LINE('var NW=D.w.length,CI=NW-1,M=D.m,SVGNS=''http://www.w3.org/2000/svg'';');
    DBMS_OUTPUT.PUT_LINE('var TRI=String.fromCharCode(9650),TIMES=String.fromCharCode(215),MINUS=String.fromCharCode(8722);');
    DBMS_OUTPUT.PUT_LINE('var drop={},app,mx,chips,res,btnReset,act,tip,lastW=-1;');
    DBMS_OUTPUT.PUT_LINE('function esc(s){return String(s==null?'''':s).replace(/&/g,''&amp;'').replace(/</g,''&lt;'').replace(/>/g,''&gt;'').replace(/"/g,''&quot;'');}');
    DBMS_OUTPUT.PUT_LINE('function off(i){return CI-i;}');
    DBMS_OUTPUT.PUT_LINE('function lab(i){return i===CI?''Current'':AW.w[i].l.replace(/^-/,MINUS);}');
    DBMS_OUTPUT.PUT_LINE('function f1(v){return v==null?''-'':(Math.round(v*10)/10).toFixed(1);}');
    DBMS_OUTPUT.PUT_LINE('function f2(v){return v==null?''-'':v.toFixed(2);}');
    DBMS_OUTPUT.PUT_LINE('function zt(z){return z==null?''&ndash;'':(z<0?''&minus;'':''+'')+Math.abs(z).toFixed(1);}');
    DBMS_OUTPUT.PUT_LINE('/* ---- 1. the scoring twin */');
    DBMS_OUTPUT.PUT_LINE('function stats(m,dr){');
    DBMS_OUTPUT.PUT_LINE('  var a=[],i,s=0,q=0,n,mu,sd;');
    DBMS_OUTPUT.PUT_LINE('  for(i=0;i<CI;i++){if(dr[off(i)]||AW.w[i].v!==''Y'')continue;if(m.v[i]==null)continue;a.push(m.v[i]);}');
    DBMS_OUTPUT.PUT_LINE('  n=a.length;if(n===0)return {n:0,mu:null,sd:null};');
    DBMS_OUTPUT.PUT_LINE('  for(i=0;i<n;i++)s+=a[i];mu=s/n;');
    DBMS_OUTPUT.PUT_LINE('  for(i=0;i<n;i++)q+=(a[i]-mu)*(a[i]-mu);');
    DBMS_OUTPUT.PUT_LINE('  sd=n>1?Math.sqrt(q/(n-1)):0;');
    DBMS_OUTPUT.PUT_LINE('  return {n:n,mu:mu,sd:sd};');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('function bucket(m,cur,mu,sd,n){');
    DBMS_OUTPUT.PUT_LINE('  if(cur==null)return ''n/a'';');
    DBMS_OUTPUT.PUT_LINE('  if(!(n>=3))return ''insufficient history'';');
    DBMS_OUTPUT.PUT_LINE('  if(mu==null||sd==null)return ''flat baseline'';');
    DBMS_OUTPUT.PUT_LINE('  var den=Math.max(sd,0.02*Math.abs(mu));');
    DBMS_OUTPUT.PUT_LINE('  if(den===0)return ''flat baseline'';');
    DBMS_OUTPUT.PUT_LINE('  var z=(cur-mu)/den;');
    DBMS_OUTPUT.PUT_LINE('  if(Math.abs(z)<=2)return ''typical'';');
    DBMS_OUTPUT.PUT_LINE('  var pct=mu===0?null:(cur-mu)/Math.abs(mu)*100;');
    DBMS_OUTPUT.PUT_LINE('  if(pct!=null&&Math.abs(pct)<(m.p==null?10:m.p))return ''typical'';');
    DBMS_OUTPUT.PUT_LINE('  if(m.a!=null){');
    DBMS_OUTPUT.PUT_LINE('    if(m.d===''WAIT''){if(m.sh!=null&&m.sh<m.a)return ''typical'';}');
    DBMS_OUTPUT.PUT_LINE('    else if(Math.max(Math.abs(cur),Math.abs(mu))<m.a)return ''typical'';');
    DBMS_OUTPUT.PUT_LINE('  }else if(m.d===''WAIT''&&m.sh!=null&&m.sh<0.02)return ''typical'';');
    DBMS_OUTPUT.PUT_LINE('  if(m.dir===''INFO'')return ''noted'';');
    DBMS_OUTPUT.PUT_LINE('  if((m.dir===''UP''&&cur<mu)||(m.dir===''DOWN''&&cur>mu))return ''improved'';');
    DBMS_OUTPUT.PUT_LINE('  return Math.abs(z)>3?''large'':''moderate'';');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('function rescore(dr){');
    DBMS_OUTPUT.PUT_LINE('  return M.map(function(m){');
    DBMS_OUTPUT.PUT_LINE('    var cur=m.v[CI],s=stats(m,dr),z=null;');
    DBMS_OUTPUT.PUT_LINE('    if(cur!=null&&s.mu!=null&&s.sd!=null){var den=Math.max(s.sd,0.02*Math.abs(s.mu));if(den>0)z=(cur-s.mu)/den;}');
    DBMS_OUTPUT.PUT_LINE('    return {b:bucket(m,cur,s.mu,s.sd,s.n),z:z,n:s.n};');
    DBMS_OUTPUT.PUT_LINE('  });');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('function flag(b){return b===''large''||b===''moderate'';}');
    DBMS_OUTPUT.PUT_LINE('/* finding cards: one per card group with a canonical large / moderate');
    DBMS_OUTPUT.PUT_LINE('   member (card_group() in sql/lib/finding_cards.plsql, emitted as m.g) */');
    DBMS_OUTPUT.PUT_LINE('function cards(r){');
    DBMS_OUTPUT.PUT_LINE('  var g={},o={cards:0,large:0,moderate:0,ml:0,mm:0};');
    DBMS_OUTPUT.PUT_LINE('  M.forEach(function(m,i){if(m.k!==''Y''||!flag(r[i].b))return;');
    DBMS_OUTPUT.PUT_LINE('    if(r[i].b===''large''){o.ml++;g[m.g]=''large'';}else{o.mm++;if(!g[m.g])g[m.g]=''moderate'';}});');
    DBMS_OUTPUT.PUT_LINE('  Object.keys(g).forEach(function(k){o.cards++;o[g[k]]++;});');
    DBMS_OUTPUT.PUT_LINE('  return o;');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('var R0=rescore({}),C0=cards(R0),CHK=[],SUG=D.sug||[];');
    DBMS_OUTPUT.PUT_LINE('M.forEach(function(m,i){if(R0[i].b!==m.pb)CHK.push({metric:m.d+'':''+m.n,js:R0[i].b,plsql:m.pb});});');
    DBMS_OUTPUT.PUT_LINE('if(C0.cards!==D.cb)CHK.push({metric:''finding cards'',js:C0.cards,plsql:D.cb});');
    DBMS_OUTPUT.PUT_LINE('SUG.forEach(function(sg,s){var dr={};sg.drop.forEach(function(o){dr[o]=1;});var RS=rescore(dr),CS=cards(RS),ch=0;');
    DBMS_OUTPUT.PUT_LINE('  M.forEach(function(m,i){if(RS[i].b!==R0[i].b)ch++;if(RS[i].b!==m.sb[s])CHK.push({metric:m.d+'':''+m.n,js:RS[i].b,plsql:m.sb[s],dropped:sg.drop.join('','')});});');
    DBMS_OUTPUT.PUT_LINE('  if(ch!==sg.chg||CS.cards!==sg.ca)CHK.push({metric:''suggestion ''+sg.drop.join('',''),js:ch+'' changed, ''+CS.cards+'' cards'',plsql:sg.chg+'' changed, ''+sg.ca+'' cards''});});');
    DBMS_OUTPUT.PUT_LINE('window.AWR_WINSIM={check:CHK,rescore:function(offs){var d={};(offs||[]).forEach(function(o){d[o]=1;});var r=rescore(d);return {buckets:r.map(function(x){return x.b;}),cards:cards(r)};}};');
    DBMS_OUTPUT.PUT_LINE('if(CHK.length&&window.console)console.error(''winsim: the client twin of policy_bucket() disagrees with PL/SQL on ''+CHK.length+'' metric(s)'',CHK);');
    DBMS_OUTPUT.PUT_LINE('/* ---- 2. tooltip (own element, the look of #tip) */');
    DBMS_OUTPUT.PUT_LINE('function tipOn(h,e){if(!tip){tip=doc.createElement(''div'');tip.className=''winsim-tip'';tip.setAttribute(''role'',''tooltip'');doc.body.appendChild(tip);}');
    DBMS_OUTPUT.PUT_LINE('  tip.innerHTML=h;tip.hidden=false;var x=e.clientX+14,y=e.clientY+16,w=tip.offsetWidth,hh=tip.offsetHeight;');
    DBMS_OUTPUT.PUT_LINE('  if(x+w>innerWidth-8)x=e.clientX-w-12;if(y+hh>innerHeight-8)y=e.clientY-hh-12;tip.style.left=Math.max(8,x)+''px'';tip.style.top=Math.max(8,y)+''px'';}');
    DBMS_OUTPUT.PUT_LINE('function tipOff(){if(tip)tip.hidden=true;}');
    DBMS_OUTPUT.PUT_LINE('/* ---- 3. Part 1: the matrix and the distance bars */');
    DBMS_OUTPUT.PUT_LINE('function dist(i,j){if(i===j)return 0;var a=Math.max(i,j),b=Math.min(i,j),r=D.dm[a];return r?r[b]:null;}');
    DBMS_OUTPUT.PUT_LINE('function scaled(m,i){var v=m.v[i];return v==null||!m.vec||!m.sp?null:(v-m.md)/m.sp;}');
    DBMS_OUTPUT.PUT_LINE('function diffTop(i,j){');
    DBMS_OUTPUT.PUT_LINE('  var a=[];M.forEach(function(m){if(!m.vec)return;var x=scaled(m,i),y=scaled(m,j);if(x==null||y==null)return;');
    DBMS_OUTPUT.PUT_LINE('    a.push({l:m.l,c:Math.min(Math.abs(x-y),D.cap),s:x-y});});');
    DBMS_OUTPUT.PUT_LINE('  a.sort(function(p,q){return q.c-p.c;});return a.slice(0,3);');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('function word(d){return d==null?'''':d<=D.medd?''alike'':d<=D.thr?''somewhat different'':''very different'';}');
    DBMS_OUTPUT.PUT_LINE('var DMAX=1;');
    DBMS_OUTPUT.PUT_LINE('(function(){for(var i=0;i<NW;i++)for(var j=0;j<i;j++){var d=dist(i,j);if(d!=null&&d>DMAX)DMAX=d;}})();');
    DBMS_OUTPUT.PUT_LINE('function pct(d){return Math.round(Math.min(1,d/DMAX)*16)/16;}');
    DBMS_OUTPUT.PUT_LINE('function mixCss(p){return ''color-mix(in srgb,var(--mean) ''+Math.round(14+p*76)+''%,var(--panel))'';}');
    DBMS_OUTPUT.PUT_LINE('function el(n,a,p){var e=doc.createElementNS(SVGNS,n);for(var k in a)e.setAttribute(k,a[k]);if(p)p.appendChild(e);return e;}');
    DBMS_OUTPUT.PUT_LINE('function tx(p,x,y,t,cls,anc){var e=el(''text'',{x:x,y:y,''class'':cls||'''',''text-anchor'':anc||''start''},p);e.textContent=t;return e;}');
    DBMS_OUTPUT.PUT_LINE('var G=null;   /* geometry of the last draw */');
    DBMS_OUTPUT.PUT_LINE('function draw(){');
    DBMS_OUTPUT.PUT_LINE('  if(!mx)return;var avail=mx.clientWidth;if(!avail)return;');
    DBMS_OUTPUT.PUT_LINE('  lastW=avail;mx.textContent='''';');
    DBMS_OUTPUT.PUT_LINE('  var LW=46,TH=30,c=Math.max(NW>60?2:6,Math.min(26,Math.floor((avail-LW-6)/NW))),S=NW*c;');
    DBMS_OUTPUT.PUT_LINE('  var canvas=NW>60,BH=96,stp=Math.max(1,Math.ceil(30/c));');
    DBMS_OUTPUT.PUT_LINE('  G={LW:LW,TH:TH,c:c};');
    DBMS_OUTPUT.PUT_LINE('  var showLab=function(i){return i===CI||(CI-i)%stp===0;};');
    DBMS_OUTPUT.PUT_LINE('  var dimOf=function(i){return i<CI&&drop[off(i)];};');
    DBMS_OUTPUT.PUT_LINE('  /* the matrix */');
    DBMS_OUTPUT.PUT_LINE('  var box=doc.createElement(''div'');box.className=''winsim-mxb'';mx.appendChild(box);');
    DBMS_OUTPUT.PUT_LINE('  var svg=el(''svg'',{width:LW+S+4,height:TH+S+4,''class'':''winsim-svg'',role:''img'',');
    DBMS_OUTPUT.PUT_LINE('    ''aria-label'':''Similarity matrix of the ''+NW+'' compared windows, oldest first, the Current window last: darker cells are windows further apart.''},null);');
    DBMS_OUTPUT.PUT_LINE('  box.appendChild(svg);');
    DBMS_OUTPUT.PUT_LINE('  for(var i=0;i<NW;i++){if(!showLab(i))continue;');
    DBMS_OUTPUT.PUT_LINE('    var cls=''winsim-ax''+(i===CI?'' cur'':'''')+(D.w[i].odd?'' odd'':'''')+(dimOf(i)?'' dr'':'''');');
    DBMS_OUTPUT.PUT_LINE('    tx(svg,LW+i*c+c/2,TH-6,i===CI?''Cur'':lab(i),cls,''middle'');');
    DBMS_OUTPUT.PUT_LINE('    tx(svg,LW-5,TH+i*c+c/2+3.5,(D.w[i].odd?TRI+'' '':'''')+(i===CI?''Cur'':lab(i)),cls,''end'');}');
    DBMS_OUTPUT.PUT_LINE('  if(canvas){');
    DBMS_OUTPUT.PUT_LINE('    var cv=doc.createElement(''canvas''),dpr=window.devicePixelRatio||1;cv.width=Math.ceil(S*dpr);cv.height=Math.ceil(S*dpr);');
    DBMS_OUTPUT.PUT_LINE('    cv.style.width=S+''px'';cv.style.height=S+''px'';cv.className=''winsim-cv'';cv.style.left=LW+''px'';cv.style.top=TH+''px'';');
    DBMS_OUTPUT.PUT_LINE('    box.appendChild(cv);var g=cv.getContext(''2d'');g.scale(dpr,dpr);');
    DBMS_OUTPUT.PUT_LINE('    var pal={},probe=doc.createElement(''i'');probe.className=''winsim-probe'';mx.appendChild(probe);');
    DBMS_OUTPUT.PUT_LINE('    var col=function(css){if(pal[css])return pal[css];probe.style.color=css;return (pal[css]=getComputedStyle(probe).color);};');
    DBMS_OUTPUT.PUT_LINE('    for(i=0;i<NW;i++)for(var j=0;j<NW;j++){var d=dist(i,j),f;');
    DBMS_OUTPUT.PUT_LINE('      if(D.w[i].v!==''Y''||D.w[j].v!==''Y'')continue;else if(i===j)f=col(''var(--line)'');else f=col(d==null?''var(--track)'':mixCss(pct(d)));');
    DBMS_OUTPUT.PUT_LINE('      g.fillStyle=f;g.fillRect(j*c,i*c,c,c);}');
    DBMS_OUTPUT.PUT_LINE('    probe.remove();');
    DBMS_OUTPUT.PUT_LINE('  }else{');
    DBMS_OUTPUT.PUT_LINE('    for(i=0;i<NW;i++)for(j=0;j<NW;j++){var dd=dist(i,j),sk=D.w[i].v!==''Y''||D.w[j].v!==''Y'';');
    DBMS_OUTPUT.PUT_LINE('      el(''rect'',{x:LW+j*c+0.5,y:TH+i*c+0.5,width:Math.max(1,c-1),height:Math.max(1,c-1),rx:c>10?2:0,');
    DBMS_OUTPUT.PUT_LINE('        ''class'':''winsim-c''+(sk?'' sk'':i===j?'' dg'':'''')+((dimOf(i)||dimOf(j))&&!sk?'' dr'':''''),');
    DBMS_OUTPUT.PUT_LINE('        style:sk||i===j||dd==null?'''':''fill:''+mixCss(pct(dd))},svg);}');
    DBMS_OUTPUT.PUT_LINE('  }');
    DBMS_OUTPUT.PUT_LINE('  /* the Current row and column, the odd windows'' columns */');
    DBMS_OUTPUT.PUT_LINE('  el(''rect'',{x:LW+CI*c,y:TH,width:c,height:S,''class'':''winsim-curb''},svg);');
    DBMS_OUTPUT.PUT_LINE('  el(''rect'',{x:LW,y:TH+CI*c,width:S,height:c,''class'':''winsim-curb''},svg);');
    DBMS_OUTPUT.PUT_LINE('  for(i=0;i<CI;i++)if(D.w[i].odd)el(''rect'',{x:LW+i*c,y:TH,width:c,height:S,''class'':''winsim-oddb''},svg);');
    DBMS_OUTPUT.PUT_LINE('  if(canvas){svg.style.position=''relative'';box.style.height=(TH+S+4)+''px'';}');
    DBMS_OUTPUT.PUT_LINE('  svg.addEventListener(''mousemove'',function(e){');
    DBMS_OUTPUT.PUT_LINE('    var r=svg.getBoundingClientRect(),x=e.clientX-r.left-LW,y=e.clientY-r.top-TH,jj=Math.floor(x/c),ii=Math.floor(y/c);');
    DBMS_OUTPUT.PUT_LINE('    if(x<0||y<0||ii>=NW||jj>=NW){tipOff();return;}tipOn(cellTip(ii,jj),e);});');
    DBMS_OUTPUT.PUT_LINE('  svg.addEventListener(''mouseleave'',tipOff);');
    DBMS_OUTPUT.PUT_LINE('  /* the distance bars, same columns */');
    DBMS_OUTPUT.PUT_LINE('  var vmax=Math.max(D.thr||0,D.cv||0);D.w.forEach(function(w){if(w.dd!=null&&w.dd>vmax)vmax=w.dd;});vmax=vmax*1.12||1;');
    DBMS_OUTPUT.PUT_LINE('  var bs=el(''svg'',{width:LW+S+64,height:BH+34,''class'':''winsim-svg winsim-bars'',role:''img'',');
    DBMS_OUTPUT.PUT_LINE('    ''aria-label'':''Each window\''s distance from the prior windows, oldest first; bars above the dashed threshold are odd ones out.''},null);');
    DBMS_OUTPUT.PUT_LINE('  mx.appendChild(bs);');
    DBMS_OUTPUT.PUT_LINE('  var y=function(v){return 8+BH-(v/vmax)*BH;};');
    DBMS_OUTPUT.PUT_LINE('  el(''line'',{x1:LW,x2:LW+S,y1:y(0),y2:y(0),''class'':''winsim-base''},bs);');
    DBMS_OUTPUT.PUT_LINE('  tx(bs,LW-5,y(0)+3.5,''0'',''winsim-ax'',''end'');tx(bs,LW-5,y(vmax/1.12)+3.5,f1(vmax/1.12),''winsim-ax'',''end'');');
    DBMS_OUTPUT.PUT_LINE('  for(i=0;i<NW;i++){var w=D.w[i],x0=LW+i*c+(c>4?1:0),bw=Math.max(1,c-(c>4?2:0));');
    DBMS_OUTPUT.PUT_LINE('    if(w.v!==''Y''){if(c>=6)tx(bs,LW+i*c+c/2,y(0)-3,TIMES,''winsim-skx'',''middle'');continue;}');
    DBMS_OUTPUT.PUT_LINE('    if(w.dd==null)continue;');
    DBMS_OUTPUT.PUT_LINE('    el(''rect'',{x:x0,y:y(w.dd),width:bw,height:Math.max(1,y(0)-y(w.dd)),''class'':''winsim-bar''+(i===CI?'' cur'':w.odd?'' odd'':'''')+(dimOf(i)?'' dr'':'''')},bs);');
    DBMS_OUTPUT.PUT_LINE('    if(w.odd&&c>=8)tx(bs,LW+i*c+c/2,y(w.dd)-3,TRI,''winsim-oddg'',''middle'');}');
    DBMS_OUTPUT.PUT_LINE('  if(D.thr!=null){el(''line'',{x1:LW,x2:LW+S,y1:y(D.thr),y2:y(D.thr),''class'':''winsim-thr''},bs);');
    DBMS_OUTPUT.PUT_LINE('    tx(bs,LW+S+4,y(D.thr)-2,''odd past'',''winsim-thrl'',''start'');tx(bs,LW+S+4,y(D.thr)+9,f1(D.thr),''winsim-thrl'',''start'');}');
    DBMS_OUTPUT.PUT_LINE('  for(i=0;i<NW;i++)if(showLab(i))tx(bs,LW+i*c+c/2,BH+26,i===CI?''Cur'':lab(i),''winsim-ax''+(i===CI?'' cur'':'''')+(D.w[i].odd?'' odd'':''''),''middle'');');
    DBMS_OUTPUT.PUT_LINE('  bs.addEventListener(''mousemove'',function(e){var r=bs.getBoundingClientRect(),ii=Math.floor((e.clientX-r.left-LW)/c);');
    DBMS_OUTPUT.PUT_LINE('    if(ii<0||ii>=NW){tipOff();return;}tipOn(barTip(ii),e);});');
    DBMS_OUTPUT.PUT_LINE('  bs.addEventListener(''mouseleave'',tipOff);');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('function cellTip(i,j){');
    DBMS_OUTPUT.PUT_LINE('  var a=AW.w[i],b=AW.w[j],h=''<b>''+esc(lab(i))+'' vs ''+esc(lab(j))+''</b><br><span class="tm">''+esc(a.t)+''<br>''+esc(b.t)+''</span><br>'';');
    DBMS_OUTPUT.PUT_LINE('  if(D.w[i].v!==''Y''||D.w[j].v!==''Y'')return h+''<span class="tm">skipped window, not compared</span>'';');
    DBMS_OUTPUT.PUT_LINE('  if(i===j)return h+''<span class="tm">the same window</span>'';');
    DBMS_OUTPUT.PUT_LINE('  var d=dist(i,j);if(d==null)return h+''<span class="tm">no metric in common</span>'';');
    DBMS_OUTPUT.PUT_LINE('  h+=''distance <b>''+f2(d)+''</b> robust spreads, ''+word(d);');
    DBMS_OUTPUT.PUT_LINE('  var t=diffTop(i,j);if(t.length){h+=''<br><span class="tm">Differs most in:</span>'';');
    DBMS_OUTPUT.PUT_LINE('    t.forEach(function(x){h+=''<div class="tr2"><span>''+esc(x.l)+''</span><b>''+esc(lab(i))+'' ''+(x.s<0?''lower'':''higher'')+''</b></div>'';});}');
    DBMS_OUTPUT.PUT_LINE('  return h;');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('function barTip(i){');
    DBMS_OUTPUT.PUT_LINE('  var w=D.w[i],a=AW.w[i],h=''<b>''+esc(lab(i))+''</b><br><span class="tm">''+esc(a.t)+''</span><br>'';');
    DBMS_OUTPUT.PUT_LINE('  if(w.v!==''Y'')return h+''<span class="tm">skipped window, not scored</span>'';');
    DBMS_OUTPUT.PUT_LINE('  if(w.dd==null)return h+''<span class="tm">no distance</span>'';');
    DBMS_OUTPUT.PUT_LINE('  h+=(i===CI?''distance from the prior windows '':''distance from the other priors '')+''<b>''+f2(w.dd)+''</b>'';');
    DBMS_OUTPUT.PUT_LINE('  h+=''<br><span class="tm">''+(i===CI?''the window being judged, never flagged'':w.odd===2?TRI+'' in a group unlike the rest (threshold ''+f2(D.thr)+'')'':w.odd?TRI+'' odd one out (threshold ''+f2(D.thr)+'')'':''alike (threshold ''+f2(D.thr)+'')'')+''</span>'';');
    DBMS_OUTPUT.PUT_LINE('  if(w.top&&w.top.length){h+=''<br><span class="tm">Differs most in:</span>'';');
    DBMS_OUTPUT.PUT_LINE('    w.top.forEach(function(t){h+=''<div class="tr2"><span>''+esc(M[t[0]].l)+''</span><b>''+(t[2]<0?''lower'':''higher'')+''</b></div>'';});}');
    DBMS_OUTPUT.PUT_LINE('  if(i<CI&&drop[off(i)])h+=''<br><span class="tm">dropped in the what-if</span>'';');
    DBMS_OUTPUT.PUT_LINE('  return h;');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('function legend(){');
    DBMS_OUTPUT.PUT_LINE('  var lg=app.querySelector(''.winsim-lg'');if(!lg)return;');
    DBMS_OUTPUT.PUT_LINE('  lg.innerHTML=''<span class="winsim-gr"><em>alike</em><i style="background:linear-gradient(to right,''+mixCss(0)+'',''+mixCss(1)+'')"></i><em>''+f1(DMAX)+'' different</em></span>''');
    DBMS_OUTPUT.PUT_LINE('    +''<span><i class="winsim-sw cur"></i>Current</span><span><i class="winsim-sw odd"></i>&#9650; odd one out or group</span><span><i class="winsim-sw sk"></i>skipped (blank)</span>'';');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('/* ---- 4. Part 2: the what-if */');
    DBMS_OUTPUT.PUT_LINE('function bk(b){var c=b===''large''?''large'':b===''moderate''?''moderate'':b===''improved''?''improved'':b===''noted''?''noted'':b===''typical''?''typical'':''skip'';');
    DBMS_OUTPUT.PUT_LINE('  return ''<span class="winsim-b b-''+c+''"><i aria-hidden="true"></i>''+esc(b)+''</span>'';}');
    DBMS_OUTPUT.PUT_LINE('function cnt(c){return ''<b>''+c.cards+''</b> finding''+(c.cards===1?'''':''s'')+(c.cards?'' (''+[c.large?c.large+'' large'':'''',c.moderate?c.moderate+'' moderate'':''''].filter(Boolean).join('' &middot; '')+'')'':'''');}');
    DBMS_OUTPUT.PUT_LINE('function dropped(){return Object.keys(drop).filter(function(k){return drop[k];}).map(Number).sort(function(a,b){return b-a;});}');
    DBMS_OUTPUT.PUT_LINE('function nameOf(o){var i=CI-o;return AW.w[i]?lab(i):String(o);}');
    DBMS_OUTPUT.PUT_LINE('function renderChips(){');
    DBMS_OUTPUT.PUT_LINE('  chips.textContent='''';');
    DBMS_OUTPUT.PUT_LINE('  for(var i=0;i<CI;i++){(function(i){var w=AW.w[i],o=off(i),b=doc.createElement(''button'');b.type=''button'';');
    DBMS_OUTPUT.PUT_LINE('    b.className=''winsim-chip''+(D.w[i].odd?'' odd'':'''')+(D.w[i].odd===2?'' grp'':'''')+(w.v!==''Y''?'' sk'':'''');');
    DBMS_OUTPUT.PUT_LINE('    b.innerHTML=''<b>''+(D.w[i].odd?''&#9650; '':'''')+esc(lab(i))+''</b><small>''+esc(w.d)+''</small>'';');
    DBMS_OUTPUT.PUT_LINE('    if(w.v!==''Y''){b.disabled=true;b.title=w.t+'': skipped window, never in the baseline'';b.setAttribute(''aria-pressed'',''false'');}');
    DBMS_OUTPUT.PUT_LINE('    else{b.setAttribute(''aria-pressed'',drop[o]?''false'':''true'');');
    DBMS_OUTPUT.PUT_LINE('      b.title=w.t+(drop[o]?'': dropped. Click to put it back.'':'': in the baseline. Click to drop it.'')+(D.w[i].odd===2?'' (in a group unlike the rest)'':D.w[i].odd?'' (odd one out)'':'''');');
    DBMS_OUTPUT.PUT_LINE('      b.addEventListener(''click'',function(){drop[o]=!drop[o];update();var n=chips.querySelectorAll(''.winsim-chip'')[i];if(n)n.focus();});}');
    DBMS_OUTPUT.PUT_LINE('    chips.appendChild(b);})(i);}');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('function update(){');
    DBMS_OUTPUT.PUT_LINE('  renderChips();');
    DBMS_OUTPUT.PUT_LINE('  var dl=dropped(),r=dl.length?rescore(drop):R0,c=dl.length?cards(r):C0,h='''';');
    DBMS_OUTPUT.PUT_LINE('  btnReset.disabled=!dl.length;');
    DBMS_OUTPUT.PUT_LINE('  var nb=0;for(var i=0;i<CI;i++)if(AW.w[i].v===''Y''&&!drop[off(i)])nb++;');
    DBMS_OUTPUT.PUT_LINE('  if(!dl.length){h=''<p class="winsim-sum">Nothing dropped: ''+cnt(C0)+'' as reported, against ''+nb+'' prior window''+(nb===1?'''':''s'')');
    DBMS_OUTPUT.PUT_LINE('    +'' (''+C0.ml+'' large and ''+C0.mm+'' moderate metric''+(C0.ml+C0.mm===1?'''':''s'')+'').</p>'';}');
    DBMS_OUTPUT.PUT_LINE('  else{');
    DBMS_OUTPUT.PUT_LINE('    h=''<p class="winsim-sum">Without ''+dl.map(nameOf).join('', '')+'' (''+nb+'' prior window''+(nb===1?'''':''s'')+'' left): ''+cnt(c)');
    DBMS_OUTPUT.PUT_LINE('      +'', as reported ''+cnt(C0)+''. Metrics moved: ''+(c.ml+c.mm)+'', as reported ''+(C0.ml+C0.mm)+''.</p>'';');
    DBMS_OUTPUT.PUT_LINE('    var ch=[];M.forEach(function(m,i){if(r[i].b!==R0[i].b)ch.push(i);});');
    DBMS_OUTPUT.PUT_LINE('    var rk=function(i){var a=flag(R0[i].b)?1:0,b=flag(r[i].b)?1:0;return (M[i].k===''Y''?0:4)+(a!==b?0:2);};');
    DBMS_OUTPUT.PUT_LINE('    ch.sort(function(a,b){return rk(a)-rk(b)||Math.abs(r[b].z||0)-Math.abs(r[a].z||0);});');
    DBMS_OUTPUT.PUT_LINE('    if(!ch.length)h+=''<p class="winsim-sum">No metric changes bucket.</p>'';');
    DBMS_OUTPUT.PUT_LINE('    else{');
    DBMS_OUTPUT.PUT_LINE('      h+=''<div class="winsim-tw"><table class="winsim-ct" data-nosort data-notools data-nocount><thead><tr><th>Metric</th><th>Bucket, as reported &rarr; now</th>''');
    DBMS_OUTPUT.PUT_LINE('        +''<th class="num">z, as reported &rarr; now</th><th class="num">n</th></tr></thead><tbody>'';');
    DBMS_OUTPUT.PUT_LINE('      ch.slice(0,40).forEach(function(i){var m=M[i];');
    DBMS_OUTPUT.PUT_LINE('        h+=''<tr''+(m.k!==''Y''?'' class="twin"'':'''')+''><td>''+m.lk+(m.k!==''Y''?'' <span class="chip" title="same quantity as a counted row; not counted again">twin</span>'':'''')+''</td>''');
    DBMS_OUTPUT.PUT_LINE('          +''<td>''+bk(R0[i].b)+'' &rarr; ''+bk(r[i].b)+''</td><td class="num">''+zt(R0[i].z)+'' &rarr; ''+zt(r[i].z)+''</td><td class="num">''+R0[i].n+'' &rarr; ''+r[i].n+''</td></tr>'';});');
    DBMS_OUTPUT.PUT_LINE('      h+=''</tbody></table></div>'';');
    DBMS_OUTPUT.PUT_LINE('      if(ch.length>40)h+=''<p class="winsim-cap">+ ''+(ch.length-40)+'' more metrics change bucket.</p>'';');
    DBMS_OUTPUT.PUT_LINE('    }');
    DBMS_OUTPUT.PUT_LINE('  }');
    DBMS_OUTPUT.PUT_LINE('  res.innerHTML=h;');
    DBMS_OUTPUT.PUT_LINE('  if(lastW>0)draw();');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('/* ---- 5. wiring */');
    DBMS_OUTPUT.PUT_LINE('function init(){');
    DBMS_OUTPUT.PUT_LINE('  app=doc.getElementById(''winsim-app'');mx=doc.getElementById(''winsim-mx'');chips=doc.getElementById(''winsim-chips'');');
    DBMS_OUTPUT.PUT_LINE('  res=doc.getElementById(''winsim-res'');btnReset=doc.getElementById(''winsim-reset'');act=app&&app.querySelector(''.winsim-act'');');
    DBMS_OUTPUT.PUT_LINE('  if(!app||!mx||!chips||!res)return;');
    DBMS_OUTPUT.PUT_LINE('  var sec=doc.getElementById(''win-sim'');if(sec)sec.setAttribute(''data-winsim-check'',CHK.length?CHK.length+'' mismatch'':''ok'');');
    DBMS_OUTPUT.PUT_LINE('  app.hidden=false;var nj=sec&&sec.querySelector(''.winsim-nojs'');if(nj)nj.hidden=true;');
    DBMS_OUTPUT.PUT_LINE('  legend();');
    DBMS_OUTPUT.PUT_LINE('  btnReset.addEventListener(''click'',function(){drop={};update();});');
    DBMS_OUTPUT.PUT_LINE('  SUG.forEach(function(sg){var b=doc.createElement(''button''),nm=sg.drop.map(function(o){return esc(nameOf(o));});');
    DBMS_OUTPUT.PUT_LINE('    b.type=''button'';b.className=''winsim-btn winsim-sug'';');
    DBMS_OUTPUT.PUT_LINE('    b.innerHTML=''Try without ''+(sg.k===''grp''?''the group '':'''')+(nm.length>5?nm[0]+'', &hellip; ''+nm[nm.length-1]+'' (''+nm.length+'' windows)'':nm.join('', ''));');
    DBMS_OUTPUT.PUT_LINE('    b.addEventListener(''click'',function(){drop={};sg.drop.forEach(function(o){drop[o]=true;});update();});');
    DBMS_OUTPUT.PUT_LINE('    if(act)act.insertBefore(b,btnReset);});');
    DBMS_OUTPUT.PUT_LINE('  update();draw();');
    DBMS_OUTPUT.PUT_LINE('  var redraw=function(){if(mx.clientWidth&&mx.clientWidth!==lastW)draw();};');
    DBMS_OUTPUT.PUT_LINE('  if(window.ResizeObserver)new ResizeObserver(redraw).observe(mx);');
    DBMS_OUTPUT.PUT_LINE('  window.addEventListener(''resize'',redraw);');
    DBMS_OUTPUT.PUT_LINE('  doc.addEventListener(''awr:view'',function(){setTimeout(function(){lastW=-1;redraw();},30);});');
    DBMS_OUTPUT.PUT_LINE('  doc.addEventListener(''awr:theme'',function(){if(NW>60){lastW=-1;redraw();}});');
    DBMS_OUTPUT.PUT_LINE('  doc.addEventListener(''scroll'',tipOff,{passive:true});');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('if(doc.readyState===''loading'')doc.addEventListener(''DOMContentLoaded'',init);else init();');
    DBMS_OUTPUT.PUT_LINE('})();');
    DBMS_OUTPUT.PUT_LINE('</script>');
END;
/
