--
-- sql/lib/js_design.plsql
--
-- The client half of the quiet and dashboard designs (window.AWR_DESIGN,
-- set by sql/lib/design_tail.sql just before this script).  Registered
-- after every other script, so its DOMContentLoaded handler runs last:
-- the chrome, the window component and the Timeline have built their DOM,
-- and this only moves and restyles it (ids, links and numbers survive).
-- Both designs: the Activity help paragraph behind a "How to read"
-- button, the per-table CSV / Markdown copy buttons in one menu.
-- Dashboard: the "Jump to" palette (Ctrl+K) instead of the rail, the
-- Activity charts one at a time (or both), KPI cards under the verdict,
-- the finding cards folded into one expandable table with "What changed
-- around it" beside it, Normal / Improved as tabs (body.d-dash).
-- Uses window.AWR_goTo / AWR_setView / AWR_fitTables (00), AWR_WG
-- (js_wingrid), AWR_TL.redraw (js_timeline), AWR_microStrip.
--
-- No literal tilde below (SET DEFINE tilde).  GENERATED: the body below
-- (BEGIN .. END) is written by tools/js2plsql.sh from the readable source
-- sql/lib/src/js_design.js -- edit the .js, then run tools/js2plsql.sh
-- (lint check 24 fails on a stale body).  This header is kept as is.
--
BEGIN
    DBMS_OUTPUT.PUT_LINE('<script>');
    DBMS_OUTPUT.PUT_LINE('(function(){');
    DBMS_OUTPUT.PUT_LINE('/* sql/lib/src/js_design.js -- the quiet / dashboard design script');
    DBMS_OUTPUT.PUT_LINE('   (window.AWR_DESIGN, set by sql/lib/design_tail.sql).  Runs from the');
    DBMS_OUTPUT.PUT_LINE('   last DOMContentLoaded handler of the page, after the chrome (00), the');
    DBMS_OUTPUT.PUT_LINE('   window component and the Timeline have built their DOM; it only moves');
    DBMS_OUTPUT.PUT_LINE('   and restyles what they built, so every id, link and number survives.');
    DBMS_OUTPUT.PUT_LINE('   JS off: none of this runs and the design is the skin alone. */');
    DBMS_OUTPUT.PUT_LINE('var doc=document,D=window.AWR_DESIGN||"quiet";');
    DBMS_OUTPUT.PUT_LINE('function $(s,r){return (r||doc).querySelector(s);}');
    DBMS_OUTPUT.PUT_LINE('function $$(s,r){return Array.prototype.slice.call((r||doc).querySelectorAll(s));}');
    DBMS_OUTPUT.PUT_LINE('function mk(t,c,p){var e=doc.createElement(t);if(c)e.className=c;if(p)p.appendChild(e);return e;}');
    DBMS_OUTPUT.PUT_LINE('function txt(el){return el?(el.textContent||"").replace(/\s+/g," ").trim():"";}');
    DBMS_OUTPUT.PUT_LINE('function esc(s){return String(s==null?"":s).replace(/[&<>"]/g,function(c){return {"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;"}[c];});}');
    DBMS_OUTPUT.PUT_LINE('function num(s){if(s==null||s==="")return null;var v=+s;return isNaN(v)?null:v;}');
    DBMS_OUTPUT.PUT_LINE('function cl(el){return el?el.cloneNode(true):null;}');
    DBMS_OUTPUT.PUT_LINE('function own(el){var c=el.cloneNode(true);$$(".chip,.xlink,.xlinks,.copy-btn",c).forEach(function(x){x.parentNode.removeChild(x);});return txt(c);}');
    DBMS_OUTPUT.PUT_LINE('var MID=" \u00B7 ";');
    DBMS_OUTPUT.PUT_LINE('/* ---- 1. both designs: the Activity help paragraph behind "How to read" */');
    DBMS_OUTPUT.PUT_LINE('function howToRead(){');
    DBMS_OUTPUT.PUT_LINE('  var ax=$("#ashx"),p=ax&&$(".axn2",ax),h=ax&&$(".axh",ax);if(!p||!h)return;');
    DBMS_OUTPUT.PUT_LINE('  if(!p.id)p.id="ax-how";');
    DBMS_OUTPUT.PUT_LINE('  var b=mk("button","axhow");b.type="button";b.setAttribute("aria-expanded","false");b.setAttribute("aria-controls",p.id);');
    DBMS_OUTPUT.PUT_LINE('  b.innerHTML=''<i aria-hidden="true">?</i>How to read'';');
    DBMS_OUTPUT.PUT_LINE('  h.appendChild(b);h.appendChild(p);ax.classList.add("howable");');
    DBMS_OUTPUT.PUT_LINE('  function set(on){ax.classList.toggle("howopen",on);b.setAttribute("aria-expanded",on?"true":"false");}');
    DBMS_OUTPUT.PUT_LINE('  b.addEventListener("click",function(e){e.stopPropagation();set(!ax.classList.contains("howopen"));});');
    DBMS_OUTPUT.PUT_LINE('  doc.addEventListener("click",function(e){if(ax.classList.contains("howopen")&&!p.contains(e.target)&&e.target!==b)set(false);});');
    DBMS_OUTPUT.PUT_LINE('  window.addEventListener("keydown",function(e){if(e.key==="Escape"&&ax.classList.contains("howopen")){e.stopImmediatePropagation();set(false);b.focus();}},true);');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('/* ---- 2. both designs: the per-table CSV / Markdown copy buttons in one menu */');
    DBMS_OUTPUT.PUT_LINE('function toolMenus(){');
    DBMS_OUTPUT.PUT_LINE('  $$(".tbl-tools").forEach(function(bar){');
    DBMS_OUTPUT.PUT_LINE('    var btns=$$(":scope > .tool-btn",bar);if(!btns.length)return;');
    DBMS_OUTPUT.PUT_LINE('    var d=mk("details","tmenu"),s=mk("summary","",d),p=mk("div","tmenu-p",d);');
    DBMS_OUTPUT.PUT_LINE('    s.setAttribute("aria-label","Copy this table");s.title="Copy this table as CSV or Markdown";s.textContent="\u00B7\u00B7\u00B7";');
    DBMS_OUTPUT.PUT_LINE('    btns.forEach(function(b){var t=txt(b);b.textContent=/MD/.test(t)?"Copy as Markdown":"Copy as CSV";p.appendChild(b);');
    DBMS_OUTPUT.PUT_LINE('      b.addEventListener("click",function(){setTimeout(function(){d.open=false;},900);});});');
    DBMS_OUTPUT.PUT_LINE('    bar.appendChild(d);bar.classList.add("tmenu-on");');
    DBMS_OUTPUT.PUT_LINE('  });');
    DBMS_OUTPUT.PUT_LINE('  doc.addEventListener("click",function(e){$$("details.tmenu[open]").forEach(function(d){if(!d.contains(e.target))d.open=false;});});');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('/* ---- 3. dashboard helpers: per-window bars as one SVG (KPI cards, rows) */');
    DBMS_OUTPUT.PUT_LINE('function fmt(v){');
    DBMS_OUTPUT.PUT_LINE('  if(v==null||isNaN(v))return "\u2014";');
    DBMS_OUTPUT.PUT_LINE('  var a=Math.abs(v),d=v,u="";');
    DBMS_OUTPUT.PUT_LINE('  if(a>=1e9){d=v/1e9;u=" G";}else if(a>=1e6){d=v/1e6;u=" M";}else if(a>=1e4){d=v/1e3;u=" k";}');
    DBMS_OUTPUT.PUT_LINE('  else if(a>=1000)return Math.round(v).toLocaleString("en-US");');
    DBMS_OUTPUT.PUT_LINE('  return String(Number(d.toPrecision(4)))+u;');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('function withUnit(v,unit){var s=fmt(v);if(!unit)return s;if(/^[kMG]?B/.test(unit)&&/ [kMG]$/.test(s))return s.replace(/ ([kMG])$/," $1")+unit;return s+(/^[\/%]/.test(unit)?"":" ")+unit;}');
    DBMS_OUTPUT.PUT_LINE('function rowData(r){');
    DBMS_OUTPUT.PUT_LINE('  if(!r)return null;');
    DBMS_OUTPUT.PUT_LINE('  var v=String(r.getAttribute("data-v")||"").split(",").map(num);if(!v.length)return null;');
    DBMS_OUTPUT.PUT_LINE('  return {v:v,mu:num(r.getAttribute("data-mu")),sd:num(r.getAttribute("data-sd")),sev:r.getAttribute("data-sev")||"",unit:r.getAttribute("data-unit")||""};');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('function wins(){var w=window.AWR_WIN;return w&&w.w?w.w:[];}');
    DBMS_OUTPUT.PUT_LINE('function marks(){return window.AWR_WG&&AWR_WG.markers?AWR_WG.markers():[];}');
    DBMS_OUTPUT.PUT_LINE('/* o: {v, mu, sd, unit}; opt: {w, h, mini} */');
    DBMS_OUTPUT.PUT_LINE('function wbars(o,opt){');
    DBMS_OUTPUT.PUT_LINE('  var v=o.v,N=v.length,W=opt.w,H=opt.h,mini=!!opt.mini,ws=wins(),dates=!mini&&ws.length===N;');
    DBMS_OUTPUT.PUT_LINE('  var top=mini?2:22,bot=mini?1:(dates?18:4),ph=H-top-bot,slot=W/N;');
    DBMS_OUTPUT.PUT_LINE('  var have=v.filter(function(x){return x!=null;}),z=null;');
    DBMS_OUTPUT.PUT_LINE('  if(o.mu!=null){var d=Math.max(o.sd||0,0.02*Math.abs(o.mu));z=[Math.max(0,o.mu-2*d),o.mu+2*d,o.mu];}');
    DBMS_OUTPUT.PUT_LINE('  var max=Math.max.apply(null,have.concat(z?[z[1]]:[]).concat([0]));if(!(max>0))max=1;');
    DBMS_OUTPUT.PUT_LINE('  var y=function(x){return top+ph-Math.max(0,x)/max*ph;};');
    DBMS_OUTPUT.PUT_LINE('  var s=''<svg class="dwb''+(mini?'' mini'':'''')+''" viewBox="0 0 ''+W+'' ''+H+''" width="''+W+''" height="''+H+''"''+(mini?'' preserveAspectRatio="none"'':'''')+'' role="img" aria-label="''+esc(opt.label||"Value per compared window")+''">'';');
    DBMS_OUTPUT.PUT_LINE('  if(z){s+=''<rect class="dz" x="0" y="''+y(z[1]).toFixed(1)+''" width="''+W+''" height="''+Math.max(1,y(z[0])-y(z[1])).toFixed(1)+''"/>'';');
    DBMS_OUTPUT.PUT_LINE('    s+=''<line class="dm" x1="0" x2="''+W+''" y1="''+y(z[2]).toFixed(1)+''" y2="''+y(z[2]).toFixed(1)+''"/>'';}');
    DBMS_OUTPUT.PUT_LINE('  var every=Math.max(1,Math.ceil(46/slot)),lastLab=-1;');
    DBMS_OUTPUT.PUT_LINE('  v.forEach(function(x,i){');
    DBMS_OUTPUT.PUT_LINE('    var cur=i===N-1,bw=Math.min(slot*(cur?0.7:0.58),cur?26:20),cx=slot*i+slot/2,wi=ws[i]||{};');
    DBMS_OUTPUT.PUT_LINE('    var tt=(wi.t||("window "+(i+1)))+": "+(x==null?"no value (window skipped)":withUnit(x,o.unit));');
    DBMS_OUTPUT.PUT_LINE('    if(x!=null){var h=Math.max(1.5,top+ph-y(x));s+=''<rect class="''+(cur?''dbc'':''dbp'')+''" x="''+(cx-bw/2).toFixed(1)+''" y="''+(top+ph-h).toFixed(1)+''" width="''+bw.toFixed(1)+''" height="''+h.toFixed(1)+''" rx="''+(mini?0.8:2)+''"><title>''+esc(tt)+''</title></rect>'';}');
    DBMS_OUTPUT.PUT_LINE('    else if(!mini)s+=''<rect class="dnil" x="''+(cx-3).toFixed(1)+''" y="''+(top+ph-1.5)+''" width="6" height="1.5"><title>''+esc(tt)+''</title></rect>'';');
    DBMS_OUTPUT.PUT_LINE('    if(dates&&(cur||(i%every===0&&N-1-i>=every))){s+=''<text class="dax''+(cur?'' cur'':'''')+''" x="''+(cur?W-1:cx).toFixed(1)+''" y="''+(H-4)+''" text-anchor="''+(cur?''end'':''middle'')+''">''+esc(wi.d||"")+''</text>'';lastLab=i;}');
    DBMS_OUTPUT.PUT_LINE('    if(cur&&!mini&&x!=null)s+=''<text class="dcv" x="''+(W-1)+''" y="''+Math.max(11,top+ph-Math.max(1.5,top+ph-y(x))-4).toFixed(1)+''" text-anchor="end">''+esc(fmt(x))+''</text>'';');
    DBMS_OUTPUT.PUT_LINE('  });');
    DBMS_OUTPUT.PUT_LINE('  if(!mini&&ws.length===N){');
    DBMS_OUTPUT.PUT_LINE('    var tiers=[],lv=v[N-1];if(lv!=null)tiers.push([W-fmt(lv).length*7-6,W]);');
    DBMS_OUTPUT.PUT_LINE('    marks().forEach(function(m){');
    DBMS_OUTPUT.PUT_LINE('      var i=-1;ws.forEach(function(wi,k){if(wi.o===m.o)i=k;});if(i<0)return;');
    DBMS_OUTPUT.PUT_LINE('      var x=slot*i;s+=''<line class="dmk" x1="''+x.toFixed(1)+''" x2="''+x.toFixed(1)+''" y1="''+(top-6)+''" y2="''+(top+ph)+''"><title>''+esc(m.l+", "+m.t)+''</title></line>'';');
    DBMS_OUTPUT.PUT_LINE('      var lw=m.s.length*6+6,clash=function(a){return tiers.some(function(r){return a<r[1]&&a+lw>r[0];});},end=x+lw>W||clash(x),x0=end?x-lw:x;');
    DBMS_OUTPUT.PUT_LINE('      if(clash(x0))return;tiers.push([x0,x0+lw]);');
    DBMS_OUTPUT.PUT_LINE('      s+=''<text class="dml" x="''+(end?x-3:x+3).toFixed(1)+''" y="''+(top-9)+''" text-anchor="''+(end?''end'':''start'')+''"><title>''+esc(m.l+", "+m.t)+''</title>''+esc(m.s)+''</text>'';');
    DBMS_OUTPUT.PUT_LINE('    });');
    DBMS_OUTPUT.PUT_LINE('  }');
    DBMS_OUTPUT.PUT_LINE('  return s+''</svg>'';');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('/* ---- 4. dashboard: the "Jump to" palette (Ctrl+K) instead of the rail */');
    DBMS_OUTPUT.PUT_LINE('function palette(){');
    DBMS_OUTPUT.PUT_LINE('  var tb=$("#topbar"),seg=tb&&$(".seg",tb);if(!tb)return;');
    DBMS_OUTPUT.PUT_LINE('  var b=mk("button","dsearch");b.type="button";b.setAttribute("aria-haspopup","dialog");');
    DBMS_OUTPUT.PUT_LINE('  b.innerHTML=''<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><circle cx="7" cy="7" r="4.5" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M10.5 10.5l3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg><span>Jump to\u2026</span><kbd>Ctrl K</kbd>'';');
    DBMS_OUTPUT.PUT_LINE('  tb.insertBefore(b,seg||null);');
    DBMS_OUTPUT.PUT_LINE('  var dlg=mk("dialog","dpal",doc.body);dlg.setAttribute("aria-label","Jump to a section or a row");');
    DBMS_OUTPUT.PUT_LINE('  dlg.innerHTML=''<div class="dpi"><svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><circle cx="7" cy="7" r="4.5" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M10.5 10.5l3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>''');
    DBMS_OUTPUT.PUT_LINE('    +''<input type="text" role="combobox" aria-expanded="true" aria-controls="dpal-list" aria-autocomplete="list" autocomplete="off" spellcheck="false" placeholder="Section, finding, metric, event, SQL id, segment, file, parameter"></div>''');
    DBMS_OUTPUT.PUT_LINE('    +''<ul id="dpal-list" role="listbox" aria-label="Matches"></ul><p class="dpf"><span><kbd>\u2191</kbd><kbd>\u2193</kbd> move</span><span><kbd>Enter</kbd> open</span><span><kbd>Esc</kbd> close</span></p>'';');
    DBMS_OUTPUT.PUT_LINE('  var inp=$("input",dlg),ul=$("ul",dlg),items=null,res=[],act=0;');
    DBMS_OUTPUT.PUT_LINE('  function build(){');
    DBMS_OUTPUT.PUT_LINE('    items=[];var seen={};');
    DBMS_OUTPUT.PUT_LINE('    function add(id,label,grp,kind){if(!id||seen[id]||!label)return;var el=doc.getElementById(id);if(!el)return;seen[id]=1;items.push({id:id,l:label,g:grp,k:kind,s:(label+" "+grp+" "+id).toLowerCase()});}');
    DBMS_OUTPUT.PUT_LINE('    var grp="";');
    DBMS_OUTPUT.PUT_LINE('    $$("nav.toc .rail-list > *").forEach(function(el){');
    DBMS_OUTPUT.PUT_LINE('      if(el.tagName==="B"){grp=txt(el);return;}');
    DBMS_OUTPUT.PUT_LINE('      if(el.tagName!=="A"||el.hidden||el.classList.contains("more-sections"))return;');
    DBMS_OUTPUT.PUT_LINE('      var h=(el.getAttribute("href")||"").slice(1);');
    DBMS_OUTPUT.PUT_LINE('      add(h,el.getAttribute("data-label")||own(el),el.classList.contains("sub")?"Finding":grp,el.classList.contains("sub")?"finding":"section");');
    DBMS_OUTPUT.PUT_LINE('    });');
    DBMS_OUTPUT.PUT_LINE('    $$("details.drow[id]").forEach(function(d){add(d.id,txt($(".dnm b",d)),"Finding"+MID+txt($(".dnm small",d)),"finding");});');
    DBMS_OUTPUT.PUT_LINE('    $$("main tr[id]").forEach(function(tr){');
    DBMS_OUTPUT.PUT_LINE('      if(tr.closest("details.drow")||!tr.cells||!tr.cells.length)return;');
    DBMS_OUTPUT.PUT_LINE('      var tb=tr.closest("table"),cap=tb&&tb.caption?txt(tb.caption):"",sec=tr.closest("section"),h=sec&&$("h2",sec);');
    DBMS_OUTPUT.PUT_LINE('      var g=cap?cap.replace(/\s+\u2014\s+/g,MID):(h?txt($(".lt",h)||h.firstChild):"");');
    DBMS_OUTPUT.PUT_LINE('      add(tr.id,own(tr.cells[0]).slice(0,90),g,"row");');
    DBMS_OUTPUT.PUT_LINE('    });');
    DBMS_OUTPUT.PUT_LINE('    $$("main [id^=''ash-card-''], main article.fc[id], main [id^=''sm-'']").forEach(function(el){');
    DBMS_OUTPUT.PUT_LINE('      var h=$("h3",el)||el;add(el.id,txt(h).slice(0,90),el.tagName==="ARTICLE"?"Card":"SQL","row");');
    DBMS_OUTPUT.PUT_LINE('    });');
    DBMS_OUTPUT.PUT_LINE('  }');
    DBMS_OUTPUT.PUT_LINE('  function render(q){');
    DBMS_OUTPUT.PUT_LINE('    if(!items)build();');
    DBMS_OUTPUT.PUT_LINE('    var w=q.toLowerCase().split(/\s+/).filter(Boolean);');
    DBMS_OUTPUT.PUT_LINE('    res=items.filter(function(it){return w.every(function(x){return it.s.indexOf(x)>=0;});});');
    DBMS_OUTPUT.PUT_LINE('    if(w.length)res.sort(function(a,b){var pa=a.l.toLowerCase().indexOf(w[0])===0?0:1,pb=b.l.toLowerCase().indexOf(w[0])===0?0:1;');
    DBMS_OUTPUT.PUT_LINE('      if(pa!==pb)return pa-pb;var ka=a.k==="row"?1:0,kb=b.k==="row"?1:0;return ka-kb;});');
    DBMS_OUTPUT.PUT_LINE('    else res=res.filter(function(it){return it.k!=="row";});');
    DBMS_OUTPUT.PUT_LINE('    res=res.slice(0,60);');
    DBMS_OUTPUT.PUT_LINE('    var fi=doc.getElementById("row-filter");');
    DBMS_OUTPUT.PUT_LINE('    if(w.length&&fi)res.push({id:"",l:''Filter every table to rows matching "''+q+''"'',g:"Filter rows",k:"filter",q:q});');
    DBMS_OUTPUT.PUT_LINE('    act=0;ul.innerHTML=res.map(function(it,i){return ''<li role="option" id="dpo-''+i+''" data-i="''+i+''" class="''+it.k+''" aria-selected="''+(i===0)+''"><span class="dpl">''+esc(it.l)+''</span><span class="dpg">''+esc(it.g)+''</span></li>'';}).join("")');
    DBMS_OUTPUT.PUT_LINE('      ||''<li class="dpn" role="option" aria-disabled="true" aria-selected="false">No match</li>'';');
    DBMS_OUTPUT.PUT_LINE('    sel(0);');
    DBMS_OUTPUT.PUT_LINE('  }');
    DBMS_OUTPUT.PUT_LINE('  function sel(i){if(!res.length)return;act=(i+res.length)%res.length;$$("li[data-i]",ul).forEach(function(li,k){li.setAttribute("aria-selected",String(k===act));});');
    DBMS_OUTPUT.PUT_LINE('    var li=$(''li[data-i="''+act+''"]'',ul);if(li){inp.setAttribute("aria-activedescendant",li.id);li.scrollIntoView({block:"nearest"});}}');
    DBMS_OUTPUT.PUT_LINE('  function go(it){');
    DBMS_OUTPUT.PUT_LINE('    dlg.close();if(!it)return;');
    DBMS_OUTPUT.PUT_LINE('    if(it.k==="filter"){var fi=doc.getElementById("row-filter");if(fi){fi.value=it.q;fi.dispatchEvent(new Event("input",{bubbles:true}));}if(window.AWR_setView)AWR_setView("all",true);return;}');
    DBMS_OUTPUT.PUT_LINE('    var el=doc.getElementById(it.id);if(el&&window.AWR_goTo)AWR_goTo(el,el.tagName!=="SECTION",true);');
    DBMS_OUTPUT.PUT_LINE('    try{history.replaceState(null,"","#"+it.id);}catch(e){}');
    DBMS_OUTPUT.PUT_LINE('  }');
    DBMS_OUTPUT.PUT_LINE('  function open(){if(dlg.open)return;inp.value="";render("");try{dlg.showModal();}catch(e){dlg.setAttribute("open","");}inp.focus();}');
    DBMS_OUTPUT.PUT_LINE('  b.addEventListener("click",open);');
    DBMS_OUTPUT.PUT_LINE('  inp.addEventListener("input",function(){render(inp.value.trim());});');
    DBMS_OUTPUT.PUT_LINE('  dlg.addEventListener("keydown",function(e){');
    DBMS_OUTPUT.PUT_LINE('    if(e.key==="ArrowDown"){e.preventDefault();sel(act+1);}');
    DBMS_OUTPUT.PUT_LINE('    else if(e.key==="ArrowUp"){e.preventDefault();sel(act-1);}');
    DBMS_OUTPUT.PUT_LINE('    else if(e.key==="Enter"){e.preventDefault();go(res[act]);}');
    DBMS_OUTPUT.PUT_LINE('    else if(e.key==="Escape"){e.preventDefault();e.stopPropagation();dlg.close();b.focus();}');
    DBMS_OUTPUT.PUT_LINE('    e.stopPropagation();');
    DBMS_OUTPUT.PUT_LINE('  });');
    DBMS_OUTPUT.PUT_LINE('  ul.addEventListener("click",function(e){var li=e.target.closest("li[data-i]");if(li)go(res[+li.getAttribute("data-i")]);});');
    DBMS_OUTPUT.PUT_LINE('  ul.addEventListener("mousemove",function(e){var li=e.target.closest("li[data-i]");if(li&&+li.getAttribute("data-i")!==act)sel(+li.getAttribute("data-i"));});');
    DBMS_OUTPUT.PUT_LINE('  dlg.addEventListener("click",function(e){if(e.target===dlg)dlg.close();});');
    DBMS_OUTPUT.PUT_LINE('  window.addEventListener("keydown",function(e){');
    DBMS_OUTPUT.PUT_LINE('    if((e.metaKey||e.ctrlKey)&&(e.key==="k"||e.key==="K")){e.preventDefault();e.stopImmediatePropagation();open();}');
    DBMS_OUTPUT.PUT_LINE('  },true);');
    DBMS_OUTPUT.PUT_LINE('  window.AWR_palette=open;');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('/* ---- 5. dashboard: Activity as one chart at a time (or both) */');
    DBMS_OUTPUT.PUT_LINE('function activityTabs(){');
    DBMS_OUTPUT.PUT_LINE('  var ax=$("#ashx"),h=ax&&$(".axh",ax);if(!h||!$("#ax-cls")||!$("#ax-ev"))return;');
    DBMS_OUTPUT.PUT_LINE('  var g=mk("div","seg axseg");g.setAttribute("role","group");g.setAttribute("aria-label","Which Activity chart");');
    DBMS_OUTPUT.PUT_LINE('  [["cls","By wait class"],["ev","By wait event"],["both","Both"]].forEach(function(o){');
    DBMS_OUTPUT.PUT_LINE('    var b=mk("button","",g);b.type="button";b.setAttribute("data-ax",o[0]);b.textContent=o[1];');
    DBMS_OUTPUT.PUT_LINE('    b.addEventListener("click",function(){mode(o[0]);});');
    DBMS_OUTPUT.PUT_LINE('  });');
    DBMS_OUTPUT.PUT_LINE('  var how=$(".axhow",h);h.insertBefore(g,how||null);');
    DBMS_OUTPUT.PUT_LINE('  function mode(m){');
    DBMS_OUTPUT.PUT_LINE('    ax.classList.toggle("ax-cls-only",m==="cls");ax.classList.toggle("ax-ev-only",m==="ev");');
    DBMS_OUTPUT.PUT_LINE('    $$("button",g).forEach(function(b){b.setAttribute("aria-pressed",String(b.getAttribute("data-ax")===m));});');
    DBMS_OUTPUT.PUT_LINE('    if(window.AWR_TL&&AWR_TL.redraw)setTimeout(AWR_TL.redraw,0);');
    DBMS_OUTPUT.PUT_LINE('  }');
    DBMS_OUTPUT.PUT_LINE('  mode("cls");');
    DBMS_OUTPUT.PUT_LINE('  window.AWR_axMode=mode;');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('/* ---- 6. dashboard: KPI cards (DB time + one per finding card) */');
    DBMS_OUTPUT.PUT_LINE('function sevOf(card){return card.classList.contains("f-large")?"large":card.classList.contains("f-moderate")?"moderate":"";}');
    DBMS_OUTPUT.PUT_LINE('function sevWord(s){return s==="large"?"Large":s==="moderate"?"Moderate":"Normal";}');
    DBMS_OUTPUT.PUT_LINE('function detailOf(card){var a=$("h3 a.ent",card);return a?doc.getElementById((a.getAttribute("href")||"").slice(1)):null;}');
    DBMS_OUTPUT.PUT_LINE('function famOf(card){return txt($(''nav.toc a.sub[href="#''+card.id+''"]''))||txt($(".fc-k",card));}');
    DBMS_OUTPUT.PUT_LINE('function kpi(o){');
    DBMS_OUTPUT.PUT_LINE('  var a=mk(o.href?"a":"div","dkpi"+(o.sev?" s-"+o.sev:""));if(o.href)a.href=o.href;');
    DBMS_OUTPUT.PUT_LINE('  var bd=o.sev==="large"?"crit":o.sev==="moderate"?"warn":"ok";');
    DBMS_OUTPUT.PUT_LINE('  a.innerHTML=''<span class="kh"><span class="kl">''+esc(o.label)+''</span><span class="badge ''+bd+''">''+sevWord(o.sev)+''</span></span>''');
    DBMS_OUTPUT.PUT_LINE('    +''<span class="kv"><span class="kb">''+esc(o.value)+''</span><span class="ku">''+esc(o.unit)+''</span><span class="kd"></span></span>''');
    DBMS_OUTPUT.PUT_LINE('    +''<span class="kbars"></span><span class="kc">''+esc(o.ctx)+''</span>'';');
    DBMS_OUTPUT.PUT_LINE('  if(o.delta)$(".kd",a).appendChild(o.delta);');
    DBMS_OUTPUT.PUT_LINE('  if(o.data)$(".kbars",a).innerHTML=wbars(o.data,{w:240,h:40,mini:true,label:o.label+" per compared window"});');
    DBMS_OUTPUT.PUT_LINE('  if(o.title)a.title=o.title;');
    DBMS_OUTPUT.PUT_LINE('  return a;');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('function kpis(){');
    DBMS_OUTPUT.PUT_LINE('  var v=$("#verdict");if(!v)return;');
    DBMS_OUTPUT.PUT_LINE('  var row=mk("div","dkpis vw in-s");');
    DBMS_OUTPUT.PUT_LINE('  var hb=$("#hero-dbt"),dbc=$("#findings .cards > article#f-dbtime");');
    DBMS_OUTPUT.PUT_LINE('  if(hb){');
    DBMS_OUTPUT.PUT_LINE('    var big=cl($(".l .big",hb)),u=big?$(".u",big):null,unit=u?txt(u):"";if(u)u.parentNode.removeChild(u);');
    DBMS_OUTPUT.PUT_LINE('    var g=$(".g",hb),z=txt($(".z",g)),ctx=[txt($(".l .sub",hb))];');
    DBMS_OUTPUT.PUT_LINE('    if(dbc){var t=txt($("h3",dbc)).match(/,\s*(mostly .*|all .*)$/);if(t)ctx.push(t[1]);}');
    DBMS_OUTPUT.PUT_LINE('    row.appendChild(kpi({label:"DB time",value:txt(big),unit:unit,sev:dbc?sevOf(dbc):(hb.getAttribute("data-sev")==="large"||hb.getAttribute("data-sev")==="moderate"?hb.getAttribute("data-sev"):""),');
    DBMS_OUTPUT.PUT_LINE('      delta:cl($(".d",g)),data:rowData(hb),ctx:ctx.filter(Boolean).join(MID),href:dbc?"#f-dbtime":"",title:"DB time per compared window"+(z?", "+z:"")}));');
    DBMS_OUTPUT.PUT_LINE('  }');
    DBMS_OUTPUT.PUT_LINE('  $$("#findings .cards > article.fc:not(.chg)").forEach(function(card){');
    DBMS_OUTPUT.PUT_LINE('    if(card.id==="f-dbtime")return;');
    DBMS_OUTPUT.PUT_LINE('    var det=detailOf(card),r=$(".wg .r.bars",card)||(det&&doc.getElementById("tl-"+det.id));');
    DBMS_OUTPUT.PUT_LINE('    var ev=$(".ev .evr dd .id",card),ctx=[txt($(".big .nrm",card)),txt(ev)];');
    DBMS_OUTPUT.PUT_LINE('    var lead=$("h3 a.ent",card);');
    DBMS_OUTPUT.PUT_LINE('    row.appendChild(kpi({label:lead?txt(lead):famOf(card),value:txt($(".big .v",card)),unit:txt($(".big .u",card)),sev:sevOf(card),');
    DBMS_OUTPUT.PUT_LINE('      delta:cl(det&&$("td.c-d .d",det))||cl($("h3 .d",card)),data:rowData(r),ctx:ctx.filter(Boolean).join(MID),href:"#"+card.id,title:famOf(card)+": "+txt($("h3",card))}));');
    DBMS_OUTPUT.PUT_LINE('  });');
    DBMS_OUTPUT.PUT_LINE('  var n=row.children.length;if(!n)return;');
    DBMS_OUTPUT.PUT_LINE('  /* four to a row (a lone DB time card stays a quarter wide); five or six: three to a row */');
    DBMS_OUTPUT.PUT_LINE('  row.style.setProperty("--kn",n===5||n===6?3:4);');
    DBMS_OUTPUT.PUT_LINE('  v.parentNode.insertBefore(row,v.nextSibling);');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('/* ---- 7. dashboard: the findings as one expandable table, What changed beside it */');
    DBMS_OUTPUT.PUT_LINE('/* plan 020: the Summary view prints z only up to 10 sigma (band_ztxt''s');
    DBMS_OUTPUT.PUT_LINE('   p_cap); the findings table clones its bands from the All-sections');
    DBMS_OUTPUT.PUT_LINE('   tables, which keep the exact z, so cap the clone''s pinned text */');
    DBMS_OUTPUT.PUT_LINE('function capz(bd){');
    DBMS_OUTPUT.PUT_LINE('  var b=bd&&$(".ov",bd);if(!b)return bd;');
    DBMS_OUTPUT.PUT_LINE('  var M=String.fromCharCode(8722),S=String.fromCharCode(963),t=txt(b);');
    DBMS_OUTPUT.PUT_LINE('  var z=parseFloat(t.replace(/^[<>]/,"").replace(M,"-"));');
    DBMS_OUTPUT.PUT_LINE('  if(isNaN(z)||Math.abs(z)<=10)return bd;');
    DBMS_OUTPUT.PUT_LINE('  var c=z>0?">+10"+S:"<"+M+"10"+S,al=bd.getAttribute("aria-label");');
    DBMS_OUTPUT.PUT_LINE('  if(al)bd.setAttribute("aria-label",al.split(t).join(c));');
    DBMS_OUTPUT.PUT_LINE('  b.textContent=c;return bd;');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('function drow(o){');
    DBMS_OUTPUT.PUT_LINE('  var d=mk("details","drow"+(o.sev?" s-"+o.sev:"")+(o.lead?" lead":""));');
    DBMS_OUTPUT.PUT_LINE('  if(o.key){d.setAttribute("data-row",o.key);var rid="dr-"+o.key,k=2;while(doc.getElementById(rid))rid="dr-"+o.key+"-"+(k++);d.id=rid;}');
    DBMS_OUTPUT.PUT_LINE('  var s=mk("summary","",d);');
    DBMS_OUTPUT.PUT_LINE('  s.innerHTML=''<span class="dch" aria-hidden="true"></span><span class="dsev"><i aria-hidden="true"></i>''+sevWord(o.sev)+''</span>''');
    DBMS_OUTPUT.PUT_LINE('    +''<span class="dnm"><b>''+esc(o.name)+''</b><small>''+esc(o.fam)+''</small></span><span class="dcur">''+esc(o.cur)+''</span>''');
    DBMS_OUTPUT.PUT_LINE('    +''<span class="dnr">''+esc(o.nrm)+''</span><span class="dbd"></span><span class="ddl"></span><span class="dtr"></span>'';');
    DBMS_OUTPUT.PUT_LINE('  if(o.band)$(".dbd",s).appendChild(capz(o.band));');
    DBMS_OUTPUT.PUT_LINE('  if(o.delta)$(".ddl",s).appendChild(o.delta);');
    DBMS_OUTPUT.PUT_LINE('  if(o.data){var tc=$(".dtr",s),ms=null;');
    DBMS_OUTPUT.PUT_LINE('    if(window.AWR_microStrip){try{ms=AWR_microStrip(o.data.v.map(function(x){return x==null?"":x;}).join(","),o.name);}catch(e){ms=null;}}');
    DBMS_OUTPUT.PUT_LINE('    if(ms&&ms.svg){tc.innerHTML=ms.svg;if(ms.title)tc.title=ms.title;}');
    DBMS_OUTPUT.PUT_LINE('    else tc.innerHTML=wbars(o.data,{w:92,h:18,mini:true,label:o.name+" per compared window"});}');
    DBMS_OUTPUT.PUT_LINE('  var b=mk("div","dbody",d);');
    DBMS_OUTPUT.PUT_LINE('  if(o.body)b.appendChild(o.body);');
    DBMS_OUTPUT.PUT_LINE('  if(o.data&&!o.lead){var bars=mk("div","dbars",b);if(o.body)b.insertBefore(bars,o.body);');
    DBMS_OUTPUT.PUT_LINE('    var draw=function(){var w=Math.max(260,Math.min(620,(bars.clientWidth||b.clientWidth||520)));bars.innerHTML=wbars(o.data,{w:w,h:150,label:o.name+" per compared window"});};');
    DBMS_OUTPUT.PUT_LINE('    d.addEventListener("toggle",function(){if(d.open)draw();});d._draw=function(){if(d.open)draw();};}');
    DBMS_OUTPUT.PUT_LINE('  return d;');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('function findTable(){');
    DBMS_OUTPUT.PUT_LINE('  var fs=$("#findings");if(!fs)return null;');
    DBMS_OUTPUT.PUT_LINE('  /* the cards, or (nothing moved) 07''s "No finding" note */');
    DBMS_OUTPUT.PUT_LINE('  var cw=$(":scope > .cards",fs),calm=$(":scope > .panel.calm.in-s",fs),h2=$(":scope > h2",fs);');
    DBMS_OUTPUT.PUT_LINE('  var cards=cw?$$(":scope > article.fc:not(.chg)",cw):[];');
    DBMS_OUTPUT.PUT_LINE('  var grid=mk("div","dgrid vw in-s");fs.insertBefore(grid,cw||calm||(h2?h2.nextSibling:fs.firstChild));');
    DBMS_OUTPUT.PUT_LINE('  var main=mk("div","dmain",grid);');
    DBMS_OUTPUT.PUT_LINE('  var tabs=mk("div","tabs dtabs",main);tabs.setAttribute("data-tabs","dfind");tabs.setAttribute("role","tablist");tabs.setAttribute("aria-label","Findings");');
    DBMS_OUTPUT.PUT_LINE('  function tab(k,label,n,on){var t=mk("button","",tabs);t.type="button";t.setAttribute("data-t",k);t.setAttribute("role","tab");');
    DBMS_OUTPUT.PUT_LINE('    t.setAttribute("aria-selected",on?"true":"false");t.setAttribute("tabindex",on?"0":"-1");if(on)t.classList.add("on");');
    DBMS_OUTPUT.PUT_LINE('    t.innerHTML=esc(label)+(n!=null?'' <span class="n">''+n+''</span>'':'''');');
    DBMS_OUTPUT.PUT_LINE('    t.id="dfind-t-"+k;t.setAttribute("aria-controls","dfind-p-"+k);');
    DBMS_OUTPUT.PUT_LINE('    var p=mk("div","tabpanel dpanel"+(on?" on":""),main);p.setAttribute("data-tabs","dfind");p.setAttribute("data-t",k);p.setAttribute("role","tabpanel");p.id="dfind-p-"+k;p.setAttribute("aria-labelledby",t.id);return p;}');
    DBMS_OUTPUT.PUT_LINE('  var moved=0,tbl=mk("div","dft");');
    DBMS_OUTPUT.PUT_LINE('  var hd=mk("div","dfh",tbl);hd.setAttribute("aria-hidden","true");');
    DBMS_OUTPUT.PUT_LINE('  hd.innerHTML=''<span></span><span>Severity</span><span>Metric</span><span class="dcur">Current</span><span class="dnr">Normal</span><span class="dbd">vs normal</span><span class="ddl">\u0394</span><span class="dtr">Trend</span>'';');
    DBMS_OUTPUT.PUT_LINE('  cards.forEach(function(card){');
    DBMS_OUTPUT.PUT_LINE('    /* plan 025: a card folded by 07''s script opens: the row is the fold */');
    DBMS_OUTPUT.PUT_LINE('    if(window.AWR_fcOpen)AWR_fcOpen(card);');
    DBMS_OUTPUT.PUT_LINE('    var fam=famOf(card),det=detailOf(card),sev=sevOf(card),lead=$("h3 a.ent",card);');
    DBMS_OUTPUT.PUT_LINE('    var tl=det?doc.getElementById("tl-"+det.id):null;');
    DBMS_OUTPUT.PUT_LINE('    var unit=txt($(".big .u",card)),nrm=txt($(".big .nrm",card)).replace(/^normal\s+/,"");');
    DBMS_OUTPUT.PUT_LINE('    if(unit&&nrm.slice(-unit.length)===unit)nrm=nrm.slice(0,-unit.length).trim();');
    DBMS_OUTPUT.PUT_LINE('    tbl.appendChild(drow({lead:true,key:card.id,sev:sev,name:lead?txt(lead):fam,fam:fam,cur:(txt($(".big .v",card))+(/^[\/%]/.test(unit)?"":" ")+unit).trim(),nrm:nrm,');
    DBMS_OUTPUT.PUT_LINE('      band:cl(det&&$("td.c-band .bd",det))||cl($(".fc-band .bd",card)),delta:cl(det&&$("td.c-d .d",det))||cl($("h3 .d",card)),data:rowData(tl||$(".wg .r.bars",card)),body:card}));');
    DBMS_OUTPUT.PUT_LINE('    moved++;');
    DBMS_OUTPUT.PUT_LINE('    $$(".rel tbody tr",card).forEach(function(tr){');
    DBMS_OUTPUT.PUT_LINE('      if(tr.classList.contains("twin")||!(tr.classList.contains("crit")||tr.classList.contains("warn")))return;');
    DBMS_OUTPUT.PUT_LINE('      var a=$("td:first-child a.ent",tr),id=a?(a.getAttribute("href")||"").slice(1):"",tr2=id?doc.getElementById("tl-"+id):null;');
    DBMS_OUTPUT.PUT_LINE('      var body=mk("div","dnote"),nm=a?txt(a):own(tr.cells[0]);');
    DBMS_OUTPUT.PUT_LINE('      body.innerHTML=''<p>Part of the <b>''+esc(fam)+''</b> finding, led by ''+esc(lead?txt(lead):fam)+''.</p>'';');
    DBMS_OUTPUT.PUT_LINE('      var ln=mk("p","dlinks",body);');
    DBMS_OUTPUT.PUT_LINE('      var cf=mk("a","",ln);cf.href="#"+card.id;cf.textContent="Open the finding";');
    DBMS_OUTPUT.PUT_LINE('      if(tr2){var j=mk("a","jump",ln);j.href="#timeline";j.setAttribute("data-tl",tr2.id);j.textContent="Open in Timeline";}');
    DBMS_OUTPUT.PUT_LINE('      if(id&&doc.getElementById(id)){var al=mk("a","",ln);al.href="#"+id;al.textContent="Row in All sections";}');
    DBMS_OUTPUT.PUT_LINE('      tbl.appendChild(drow({key:id,sev:tr.classList.contains("crit")?"large":"moderate",name:nm,fam:fam,cur:txt($(''td[data-w="0"]'',tr)),nrm:txt($("td.c-rng",tr)),');
    DBMS_OUTPUT.PUT_LINE('        band:cl($("td.c-band .bd",tr)),delta:cl($("td.c-d .d",tr)),data:rowData(tr2),body:body}));');
    DBMS_OUTPUT.PUT_LINE('      moved++;');
    DBMS_OUTPUT.PUT_LINE('    });');
    DBMS_OUTPUT.PUT_LINE('  });');
    DBMS_OUTPUT.PUT_LINE('  var pM=tab("moved","Moved",moved,true);');
    DBMS_OUTPUT.PUT_LINE('  if(moved)pM.appendChild(tbl);else if(calm)pM.appendChild(calm);else{var no=mk("p","dempty",pM);no.textContent="No scored metric moved beyond its normal range.";}');
    DBMS_OUTPUT.PUT_LINE('  var sn=$("#s-normal"),imp=sn&&$(".panel.note.improved",sn);');
    DBMS_OUTPUT.PUT_LINE('  if(sn){var nn=(txt($("h2 .meta",sn)).match(/\d+/)||[null])[0];var pN=tab("normal","Normal",nn,false);pN.appendChild(sn);}');
    DBMS_OUTPUT.PUT_LINE('  if(imp){var pI=tab("improved","Improved",$$(".nr",imp).length,false);pI.appendChild(imp);}');
    DBMS_OUTPUT.PUT_LINE('  /* What changed around it: the plan / config cards + the releases */');
    DBMS_OUTPUT.PUT_LINE('  var side=mk("aside","dside",grid);side.setAttribute("aria-label","What changed around it");');
    DBMS_OUTPUT.PUT_LINE('  var sc=$("#s-changes");if(sc&&!sc.hidden)side.appendChild(sc);');
    DBMS_OUTPUT.PUT_LINE('  var ms=marks();');
    DBMS_OUTPUT.PUT_LINE('  if(ms.length){');
    DBMS_OUTPUT.PUT_LINE('    var rel=mk("div","drel panel",side);');
    DBMS_OUTPUT.PUT_LINE('    rel.innerHTML=''<h3>Releases in the span <span class="n">''+ms.length+''</span></h3><ul>''+ms.map(function(m){return ''<li title="''+esc(m.l+", "+m.at)+''"><i aria-hidden="true"></i><span>''+esc(m.l)+''</span><span class="dt">''+esc(m.t)+''</span></li>'';}).join("")+''</ul>'';');
    DBMS_OUTPUT.PUT_LINE('  }');
    DBMS_OUTPUT.PUT_LINE('  if(!side.children.length)grid.classList.add("noside");');
    DBMS_OUTPUT.PUT_LINE('  return grid;');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('/* plan 026: a plan-change card that 17 moved under the card it explains');
    DBMS_OUTPUT.PUT_LINE('   goes back to "What changed around it", which the dashboard shows');
    DBMS_OUTPUT.PUT_LINE('   beside the findings table */');
    DBMS_OUTPUT.PUT_LINE('function explainsBack(){');
    DBMS_OUTPUT.PUT_LINE('  var sl=$("#changes-slot"),sc=$("#s-changes");if(!sl)return;');
    DBMS_OUTPUT.PUT_LINE('  var ex=$$("#findings article.fc[data-explains]");if(!ex.length)return;');
    DBMS_OUTPUT.PUT_LINE('  ex.reverse().forEach(function(p){sl.insertBefore(p,sl.firstChild);});');
    DBMS_OUTPUT.PUT_LINE('  if(sc&&sc.hidden){sc.hidden=false;var rl=$(''nav.toc a[href="#s-changes"]'');if(rl)rl.hidden=false;}');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('function dashboard(){');
    DBMS_OUTPUT.PUT_LINE('  var bd=doc.body;');
    DBMS_OUTPUT.PUT_LINE('  palette();');
    DBMS_OUTPUT.PUT_LINE('  activityTabs();');
    DBMS_OUTPUT.PUT_LINE('  explainsBack();');
    DBMS_OUTPUT.PUT_LINE('  kpis();');
    DBMS_OUTPUT.PUT_LINE('  findTable();');
    DBMS_OUTPUT.PUT_LINE('  bd.classList.add("d-dash");');
    DBMS_OUTPUT.PUT_LINE('  var rt=null;');
    DBMS_OUTPUT.PUT_LINE('  window.addEventListener("resize",function(){if(rt)clearTimeout(rt);rt=setTimeout(function(){$$("details.drow[open]").forEach(function(d){if(d._draw)d._draw();});},150);});');
    DBMS_OUTPUT.PUT_LINE('  doc.addEventListener("awr:view",function(){setTimeout(function(){$$("details.drow[open]").forEach(function(d){if(d._draw)d._draw();});},60);});');
    DBMS_OUTPUT.PUT_LINE('  if(window.AWR_fitTables)setTimeout(AWR_fitTables,60);');
    DBMS_OUTPUT.PUT_LINE('  if(window.AWR_WG&&AWR_WG.refit)setTimeout(AWR_WG.refit,80);');
    DBMS_OUTPUT.PUT_LINE('  if(window.AWR_TL&&AWR_TL.redraw)setTimeout(AWR_TL.redraw,90);');
    DBMS_OUTPUT.PUT_LINE('  /* a hash that points into a moved block (e.g. #f-io) opens its row */');
    DBMS_OUTPUT.PUT_LINE('  var h=(location.hash||"").slice(1).split("!")[0],el=h&&!/^view=/.test(h)?doc.getElementById(h):null;');
    DBMS_OUTPUT.PUT_LINE('  if(el&&el.closest("details.drow")&&window.AWR_goTo)setTimeout(function(){AWR_goTo(el,false,false);},120);');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('doc.addEventListener("DOMContentLoaded",function(){');
    DBMS_OUTPUT.PUT_LINE('  doc.body.classList.add("d-"+D);');
    DBMS_OUTPUT.PUT_LINE('  try{howToRead();}catch(e){if(window.console)console.warn("design: how-to-read",e);}');
    DBMS_OUTPUT.PUT_LINE('  try{toolMenus();}catch(e){if(window.console)console.warn("design: table menus",e);}');
    DBMS_OUTPUT.PUT_LINE('  if(D==="dashboard"){try{dashboard();}catch(e){if(window.console)console.warn("design: dashboard",e);}}');
    DBMS_OUTPUT.PUT_LINE('});');
    DBMS_OUTPUT.PUT_LINE('})();');
    DBMS_OUTPUT.PUT_LINE('</script>');
END;
/
