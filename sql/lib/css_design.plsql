--
-- sql/lib/css_design.plsql
--
-- The stylesheet of the quiet and dashboard designs (design=quiet|dashboard):
-- zinc neutrals, Geist, one border weight, release flags without boxes,
-- the rail counts as one dot + number, severity as a leading dot in the
-- tables, the verdict counts as one stats line; plus the dashboard's own
-- rules (KPI cards, the findings table, the palette), every one of them
-- under body.d-dash, which js_design sets only once it has built that
-- layout (JS off: the dashboard looks like quiet).  Emitted by
-- sql/lib/design_head.sql after sql/_style.sql, so a rule here wins at
-- equal specificity; it overrides the same tokens, so every component
-- follows.  Never included by the classic design or the fleet report.
--
-- No literal tilde below (SET DEFINE tilde; in CSS that rules out the
-- general-sibling combinator).  GENERATED: the body below (BEGIN .. END)
-- is written by tools/js2plsql.sh from the readable source
-- sql/lib/src/css_design.css -- edit the .css, then run tools/js2plsql.sh
-- (lint check 24 fails on a stale body).  This header is kept as is.
--
BEGIN
    DBMS_OUTPUT.PUT_LINE('<style>');
    DBMS_OUTPUT.PUT_LINE('/* sql/lib/src/css_design.css -- the quiet / dashboard design stylesheet.');
    DBMS_OUTPUT.PUT_LINE('   Generated into sql/lib/css_design.plsql by tools/js2plsql.sh; emitted by');
    DBMS_OUTPUT.PUT_LINE('   sql/lib/design_head.sql after sql/_style.sql, so every rule here wins');
    DBMS_OUTPUT.PUT_LINE('   over the classic one at equal specificity.  Pure ASCII, no tilde. */');
    DBMS_OUTPUT.PUT_LINE('/* ==== 1. tokens: zinc neutrals, one indigo accent (= Current), red /');
    DBMS_OUTPUT.PUT_LINE('   amber severity.  Same token names as in sql/_style.sql, so every component');
    DBMS_OUTPUT.PUT_LINE('   follows; aliases stay on body (see the gotcha in CLAUDE.md). ==== */');
    DBMS_OUTPUT.PUT_LINE(':root{');
    DBMS_OUTPUT.PUT_LINE('  --paper:oklch(1 0 0);--panel:oklch(1 0 0);--panel-2:oklch(0.985 0.001 286);');
    DBMS_OUTPUT.PUT_LINE('  --ink:oklch(0.21 0.006 285.9);--ink-soft:oklch(0.37 0.013 285.8);--muted:oklch(0.552 0.016 285.9);');
    DBMS_OUTPUT.PUT_LINE('  --rule:oklch(0.871 0.006 286.3);--hairline:oklch(0.92 0.004 286.3);--line-soft:oklch(0.945 0.003 286.3);');
    DBMS_OUTPUT.PUT_LINE('  --red:oklch(0.577 0.245 27.3);--red-deep:oklch(0.505 0.213 27.5);--chip-bg:oklch(0.967 0.001 286.4);');
    DBMS_OUTPUT.PUT_LINE('  --track:oklch(0.967 0.001 286.4);');
    DBMS_OUTPUT.PUT_LINE('  --accent:oklch(0.511 0.262 277);--accent-deep:oklch(0.457 0.24 277);--accent-bg:oklch(0.962 0.018 272.3);');
    DBMS_OUTPUT.PUT_LINE('  --fg:oklch(0.37 0.013 285.8);--border:oklch(0.92 0.004 286.3);');
    DBMS_OUTPUT.PUT_LINE('  --crit-fg:oklch(0.505 0.213 27.5);--warn-fg:oklch(0.555 0.163 49);');
    DBMS_OUTPUT.PUT_LINE('  --crit:oklch(0.577 0.245 27.3);--warn:oklch(0.555 0.163 49);--ok:oklch(0.527 0.154 150.1);');
    DBMS_OUTPUT.PUT_LINE('  --skip:oklch(0.552 0.016 285.9);');
    DBMS_OUTPUT.PUT_LINE('  --crit-bg:oklch(0.971 0.013 17.4);--warn-bg:oklch(0.987 0.022 95.3);--ok-bg:oklch(0.982 0.018 155.8);');
    DBMS_OUTPUT.PUT_LINE('  --warn-border:oklch(0.879 0.169 91.6);--skip-bg:oklch(0.967 0.001 286.4);');
    DBMS_OUTPUT.PUT_LINE('  --dot-ok:oklch(0.723 0.219 149.6);--dot-warn:oklch(0.769 0.188 70.1);--dot-crit:oklch(0.637 0.237 25.3);--dot-na:oklch(0.871 0.006 286.3);');
    DBMS_OUTPUT.PUT_LINE('  --spark:oklch(0.21 0.006 285.9);');
    DBMS_OUTPUT.PUT_LINE('  --ink-4:oklch(0.705 0.015 286.1);--zone1:oklch(0.871 0.006 286.3);--zone2:oklch(0.92 0.004 286.3);');
    DBMS_OUTPUT.PUT_LINE('  --tick:oklch(0.705 0.015 286.1);--mean:oklch(0.442 0.017 285.8);--bar:oklch(0.871 0.006 286.3);');
    DBMS_OUTPUT.PUT_LINE('  --acc:oklch(0.511 0.262 277);--acc-ink:oklch(0.457 0.24 277);');
    DBMS_OUTPUT.PUT_LINE('  --acc-band:oklch(0.511 0.262 277 / 6%);--acc-soft:oklch(0.511 0.262 277 / 11%);');
    DBMS_OUTPUT.PUT_LINE('  --crit-dot:oklch(0.637 0.237 25.3);--warn-dot:oklch(0.769 0.188 70.1);');
    DBMS_OUTPUT.PUT_LINE('  --mk:oklch(0.552 0.016 285.9);--mkline:oklch(0.552 0.016 285.9 / 30%);--flagbg:transparent;');
    DBMS_OUTPUT.PUT_LINE('  --hov:oklch(0.21 0.006 285.9 / 4%);--pin:oklch(0.769 0.188 70.1 / 12%);--flash:oklch(0.511 0.262 277 / 20%);');
    DBMS_OUTPUT.PUT_LINE('  --ring:oklch(0.705 0.015 286.1);--radius:12px;');
    DBMS_OUTPUT.PUT_LINE('  --font:"Geist",ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;');
    DBMS_OUTPUT.PUT_LINE('  --mono:"Geist Mono",ui-monospace,"SF Mono",Menlo,Consolas,monospace;');
    DBMS_OUTPUT.PUT_LINE('}');
    DBMS_OUTPUT.PUT_LINE('@media screen{body.dark{');
    DBMS_OUTPUT.PUT_LINE('  --paper:oklch(0.141 0.005 285.8);--panel:oklch(0.178 0.005 285.8);--panel-2:oklch(0.21 0.006 285.9);');
    DBMS_OUTPUT.PUT_LINE('  --ink:oklch(0.985 0 0);--ink-soft:oklch(0.871 0.006 286.3);--muted:oklch(0.705 0.015 286.1);');
    DBMS_OUTPUT.PUT_LINE('  --rule:oklch(0.37 0.013 285.8);--hairline:oklch(0.274 0.006 286);--line-soft:oklch(0.24 0.006 286);');
    DBMS_OUTPUT.PUT_LINE('  --red:oklch(0.704 0.191 22.2);--red-deep:oklch(0.808 0.114 19.6);--chip-bg:oklch(0.24 0.006 286);');
    DBMS_OUTPUT.PUT_LINE('  --track:oklch(0.24 0.006 286);');
    DBMS_OUTPUT.PUT_LINE('  --accent:oklch(0.673 0.182 276.9);--accent-deep:oklch(0.785 0.115 274.7);--accent-bg:oklch(0.257 0.09 281.3);');
    DBMS_OUTPUT.PUT_LINE('  --fg:oklch(0.871 0.006 286.3);--border:oklch(0.274 0.006 286);');
    DBMS_OUTPUT.PUT_LINE('  --crit-fg:oklch(0.704 0.191 22.2);--warn-fg:oklch(0.828 0.189 84.4);');
    DBMS_OUTPUT.PUT_LINE('  --crit:oklch(0.704 0.191 22.2);--warn:oklch(0.828 0.189 84.4);--ok:oklch(0.792 0.209 151.7);');
    DBMS_OUTPUT.PUT_LINE('  --skip:oklch(0.705 0.015 286.1);');
    DBMS_OUTPUT.PUT_LINE('  --crit-bg:oklch(0.258 0.092 26);--warn-bg:oklch(0.279 0.077 45.6);--ok-bg:oklch(0.266 0.065 152.9);');
    DBMS_OUTPUT.PUT_LINE('  --warn-border:oklch(0.473 0.137 46.2);--skip-bg:oklch(0.24 0.006 286);');
    DBMS_OUTPUT.PUT_LINE('  --dot-ok:oklch(0.723 0.219 149.6);--dot-warn:oklch(0.769 0.188 70.1);--dot-crit:oklch(0.637 0.237 25.3);--dot-na:oklch(0.37 0.013 285.8);');
    DBMS_OUTPUT.PUT_LINE('  --spark:oklch(0.985 0 0);');
    DBMS_OUTPUT.PUT_LINE('  --ink-4:oklch(0.442 0.017 285.8);--zone1:oklch(0.37 0.013 285.8);--zone2:oklch(0.274 0.006 286);');
    DBMS_OUTPUT.PUT_LINE('  --tick:oklch(0.552 0.016 285.9);--mean:oklch(0.871 0.006 286.3);--bar:oklch(0.37 0.013 285.8);');
    DBMS_OUTPUT.PUT_LINE('  --acc:oklch(0.673 0.182 276.9);--acc-ink:oklch(0.785 0.115 274.7);');
    DBMS_OUTPUT.PUT_LINE('  --acc-band:oklch(0.673 0.182 276.9 / 9%);--acc-soft:oklch(0.673 0.182 276.9 / 15%);');
    DBMS_OUTPUT.PUT_LINE('  --crit-dot:oklch(0.704 0.191 22.2);--warn-dot:oklch(0.769 0.188 70.1);');
    DBMS_OUTPUT.PUT_LINE('  --mk:oklch(0.705 0.015 286.1);--mkline:oklch(0.871 0.006 286.3 / 24%);--flagbg:transparent;');
    DBMS_OUTPUT.PUT_LINE('  --hov:oklch(1 0 0 / 5%);--pin:oklch(0.769 0.188 70.1 / 14%);--flash:oklch(0.673 0.182 276.9 / 24%);');
    DBMS_OUTPUT.PUT_LINE('  --ring:oklch(0.552 0.016 285.9);');
    DBMS_OUTPUT.PUT_LINE('}}');
    DBMS_OUTPUT.PUT_LINE('/* ==== 2. type: Geist, tabular figures; Geist Mono only for Oracle names');
    DBMS_OUTPUT.PUT_LINE('   (sql_id, plan hash, segment, file, parameter) ==== */');
    DBMS_OUTPUT.PUT_LINE('body{font-family:var(--font);font-feature-settings:"tnum" 1;letter-spacing:-.003em}');
    DBMS_OUTPUT.PUT_LINE('td.mono,code,.mono,dl.sql-meta dd.mono,.fc .evr .id,.fc .cfg-wg .l .nm,.chip,#param-changes td.pname code{font-family:var(--mono)}');
    DBMS_OUTPUT.PUT_LINE('code{font-size:.92em}');
    DBMS_OUTPUT.PUT_LINE('.fc .evr .id.txt{font-family:var(--font)}');
    DBMS_OUTPUT.PUT_LINE('.ashx .at,.ashx .cft,.ashx .xhn,.wg .axn i,.bd .ov{font-family:var(--font)}');
    DBMS_OUTPUT.PUT_LINE('::selection{background:var(--acc-soft)}');
    DBMS_OUTPUT.PUT_LINE(':focus-visible{outline:2px solid var(--ring);outline-offset:2px}');
    DBMS_OUTPUT.PUT_LINE('/* ==== 3. chrome: top bar, view switch, rail ==== */');
    DBMS_OUTPUT.PUT_LINE('.topbar{background:color-mix(in oklch,var(--paper) 88%,transparent);border-bottom:1px solid var(--hairline);gap:var(--s2) var(--s5)}');
    DBMS_OUTPUT.PUT_LINE('.topbar .db b{font-size:14px;font-weight:600}');
    DBMS_OUTPUT.PUT_LINE('.topbar .db span{font-size:13px}');
    DBMS_OUTPUT.PUT_LINE('.topbar .win{font-size:13px;gap:10px;overflow:hidden}');
    DBMS_OUTPUT.PUT_LINE('.topbar .win > span:last-child{overflow:hidden;text-overflow:ellipsis}');
    DBMS_OUTPUT.PUT_LINE('.topbar .win b{font-weight:500}');
    DBMS_OUTPUT.PUT_LINE('.cchip{background:none;color:var(--acc-ink);padding:0 8px 0 18px;position:relative;border:1px solid var(--hairline);border-radius:8px;line-height:24px}');
    DBMS_OUTPUT.PUT_LINE('.cchip::before{content:"";position:absolute;left:8px;top:50%;width:6px;height:6px;margin-top:-3px;border-radius:50%;background:var(--acc)}');
    DBMS_OUTPUT.PUT_LINE('.seg{border:0;border-radius:10px;padding:3px;background:var(--chip-bg);gap:2px}');
    DBMS_OUTPUT.PUT_LINE('.seg button{border-radius:7px;font-weight:500;color:var(--muted);padding:3px 11px}');
    DBMS_OUTPUT.PUT_LINE('.seg button[aria-pressed="true"]{background:var(--panel);color:var(--ink);box-shadow:0 1px 2px oklch(0 0 0 / 8%),0 0 0 1px var(--hairline)}');
    DBMS_OUTPUT.PUT_LINE('.topbar .theme-icon-btn{border-color:var(--hairline);box-shadow:0 1px 2px oklch(0 0 0 / 4%)}');
    DBMS_OUTPUT.PUT_LINE('nav.toc{background:var(--panel-2);border-right-color:var(--hairline);padding:16px 12px 14px}');
    DBMS_OUTPUT.PUT_LINE('nav.toc .rail-brand{border-bottom:0;padding:2px 8px 10px;margin-bottom:4px}');
    DBMS_OUTPUT.PUT_LINE('nav.toc .rail-brand span{font-size:13px;font-weight:600;letter-spacing:-.01em;text-transform:none}');
    DBMS_OUTPUT.PUT_LINE('nav.toc b{font-size:12px;font-weight:500;letter-spacing:0;text-transform:none;color:var(--muted);margin:14px 8px 4px}');
    DBMS_OUTPUT.PUT_LINE('nav.toc a{border-radius:6px;padding:4px 8px;font-weight:400;color:var(--ink);min-height:28px}');
    DBMS_OUTPUT.PUT_LINE('nav.toc a:hover{background:var(--hov)}');
    DBMS_OUTPUT.PUT_LINE('nav.toc a.on{background:var(--chip-bg);font-weight:500}');
    DBMS_OUTPUT.PUT_LINE('nav.toc a.sub{padding-left:20px;color:var(--muted)}');
    DBMS_OUTPUT.PUT_LINE('nav.toc a .st{display:none}');
    DBMS_OUTPUT.PUT_LINE('nav.toc a .cnt{background:none;padding:0;font-size:12px;font-weight:500;color:var(--muted);display:inline-flex;align-items:center;gap:5px;line-height:1}');
    DBMS_OUTPUT.PUT_LINE('nav.toc a .cnt.c,nav.toc a .cnt.w{background:none;color:var(--muted)}');
    DBMS_OUTPUT.PUT_LINE('nav.toc a .cnt::before{content:"";width:6px;height:6px;border-radius:50%;background:var(--crit-dot)}');
    DBMS_OUTPUT.PUT_LINE('nav.toc a .cnt.w::before{background:var(--warn-dot)}');
    DBMS_OUTPUT.PUT_LINE('nav.toc a .cnt + .cnt{margin-left:8px}');
    DBMS_OUTPUT.PUT_LINE('nav.toc .rail-filter input{border-color:var(--hairline);border-radius:8px;padding:6px 40px 6px 10px;box-shadow:0 1px 2px oklch(0 0 0 / 4%)}');
    DBMS_OUTPUT.PUT_LINE('nav.toc .rail-filter input:focus{border-color:var(--ring);box-shadow:0 0 0 3px oklch(0.705 0.015 286.1 / 25%)}');
    DBMS_OUTPUT.PUT_LINE('nav.toc .rail-filter .kbd{border:0;background:var(--chip-bg);font-family:var(--mono);font-size:10px;border-radius:4px}');
    DBMS_OUTPUT.PUT_LINE('nav.toc .rail-foot{background:var(--panel-2)}');
    DBMS_OUTPUT.PUT_LINE('nav.toc .next-finding{border-radius:8px}');
    DBMS_OUTPUT.PUT_LINE('/* ==== 4. surfaces: one border weight, no shadow, no card inside a card ==== */');
    DBMS_OUTPUT.PUT_LINE('section{border-color:var(--hairline);border-radius:var(--radius)}');
    DBMS_OUTPUT.PUT_LINE('.panel{border-color:var(--hairline);border-radius:var(--radius)}');
    DBMS_OUTPUT.PUT_LINE('h2{font-size:16px;line-height:24px;letter-spacing:-.01em;border-bottom:0;padding:var(--s5) 0 var(--s2);margin-bottom:var(--s2)}');
    DBMS_OUTPUT.PUT_LINE('h2 .h2sub{font-size:13px}');
    DBMS_OUTPUT.PUT_LINE('h2 > .meta{font-size:12px;color:var(--muted)}');
    DBMS_OUTPUT.PUT_LINE('.dotk{width:7px;height:7px}');
    DBMS_OUTPUT.PUT_LINE('h3{font-size:14px}');
    DBMS_OUTPUT.PUT_LINE('section.vhead > h2{font-size:18px;border-top-color:var(--hairline)}');
    DBMS_OUTPUT.PUT_LINE('footer.report{border-top-color:var(--hairline)}');
    DBMS_OUTPUT.PUT_LINE('/* ==== 5. verdict: plain type, the counts as one stats line ==== */');
    DBMS_OUTPUT.PUT_LINE('section.hero{padding-top:var(--s6)}');
    DBMS_OUTPUT.PUT_LINE('.hero .verdict{font-size:26px;line-height:1.28;font-weight:600;letter-spacing:-.022em;max-width:34em}');
    DBMS_OUTPUT.PUT_LINE('.hero .verdict.quiet{font-size:24px}');
    DBMS_OUTPUT.PUT_LINE('.hero .verdict a.ent{text-decoration-color:var(--rule)}');
    DBMS_OUTPUT.PUT_LINE('.hero .because{font-size:15px;color:var(--muted);margin-top:var(--s2)}');
    DBMS_OUTPUT.PUT_LINE('.hero .because code{background:var(--chip-bg);padding:1px 5px;border-radius:5px}');
    DBMS_OUTPUT.PUT_LINE('.hero .pills{gap:0;margin-top:var(--s4)}');
    DBMS_OUTPUT.PUT_LINE('.hero .pills li{display:flex;align-items:center}');
    DBMS_OUTPUT.PUT_LINE('.hero .pills li + li::before{content:"";width:1px;height:12px;background:var(--hairline);margin:0 12px}');
    DBMS_OUTPUT.PUT_LINE('.hero .pills a,.hero .pills span.pl{border:0;background:none;padding:0;border-radius:0;font-size:13px;color:var(--muted);gap:5px}');
    DBMS_OUTPUT.PUT_LINE('.hero .pills a:hover{color:var(--ink);text-decoration:underline;text-decoration-color:var(--rule);text-underline-offset:3px}');
    DBMS_OUTPUT.PUT_LINE('.hero .pills b{font-weight:600;color:var(--ink)}');
    DBMS_OUTPUT.PUT_LINE('.hero .hnotes{font-size:13px}');
    DBMS_OUTPUT.PUT_LINE('/* ==== 6. tables: hairlines, severity as a leading dot ==== */');
    DBMS_OUTPUT.PUT_LINE('table{font-size:13px}');
    DBMS_OUTPUT.PUT_LINE('thead th{font-size:12px;color:var(--muted);font-weight:500;border-bottom-color:var(--hairline)}');
    DBMS_OUTPUT.PUT_LINE('tbody td{border-bottom-color:var(--line-soft)}');
    DBMS_OUTPUT.PUT_LINE('tbody tr:hover{background:var(--hov);--row-bg:var(--panel)}');
    DBMS_OUTPUT.PUT_LINE('tr.crit td:first-child,tr:has(> td.c-band .bd.s-large) > td:first-child,');
    DBMS_OUTPUT.PUT_LINE('tr.warn td:first-child,tr:has(> td.c-band .bd.s-moderate) > td:first-child{box-shadow:none}');
    DBMS_OUTPUT.PUT_LINE('tr.crit > td:first-child::before,tr:has(> td.c-band .bd.s-large) > td:first-child::before,');
    DBMS_OUTPUT.PUT_LINE('tr.warn > td:first-child::before,tr:has(> td.c-band .bd.s-moderate) > td:first-child::before{content:"";display:inline-block;width:6px;height:6px;border-radius:50%;background:var(--crit-dot);margin:0 8px 1px 0;vertical-align:middle}');
    DBMS_OUTPUT.PUT_LINE('tr.warn > td:first-child::before,tr:has(> td.c-band .bd.s-moderate):not(.crit) > td:first-child::before{background:var(--warn-dot)}');
    DBMS_OUTPUT.PUT_LINE('tr.twin > td:first-child::before{opacity:.45}');
    DBMS_OUTPUT.PUT_LINE('td[data-w="0"]{background-color:var(--acc-band)}');
    DBMS_OUTPUT.PUT_LINE('th[data-w="0"],th.cur-col{color:var(--acc-ink)}');
    DBMS_OUTPUT.PUT_LINE('td a{text-decoration-color:var(--rule)}');
    DBMS_OUTPUT.PUT_LINE('.badge{border-radius:6px;font-size:11.5px;font-weight:500;padding:1px 7px;border:1px solid transparent}');
    DBMS_OUTPUT.PUT_LINE('.badge.crit{background:color-mix(in oklch,var(--crit) 10%,transparent);border-color:color-mix(in oklch,var(--crit) 22%,transparent)}');
    DBMS_OUTPUT.PUT_LINE('.badge.warn{background:color-mix(in oklch,var(--warn-dot) 14%,transparent);border-color:color-mix(in oklch,var(--warn-dot) 30%,transparent)}');
    DBMS_OUTPUT.PUT_LINE('.badge.ok{background:color-mix(in oklch,var(--ok) 10%,transparent)}');
    DBMS_OUTPUT.PUT_LINE('.chip{border-color:var(--hairline);border-radius:5px;font-weight:500}');
    DBMS_OUTPUT.PUT_LINE('.copy-btn,dl.sql-meta dt{text-transform:none;letter-spacing:0}');
    DBMS_OUTPUT.PUT_LINE('.topsql-toggle button{border-radius:7px;border-color:var(--hairline);font-weight:500;letter-spacing:0;padding:3px 10px}');
    DBMS_OUTPUT.PUT_LINE('.topsql-toggle button.active{background:var(--ink);border-color:var(--ink);color:var(--panel)}');
    DBMS_OUTPUT.PUT_LINE('.tip{border-color:var(--hairline);border-radius:8px;box-shadow:0 4px 16px oklch(0 0 0 / 10%)}');
    DBMS_OUTPUT.PUT_LINE('/* CSV / MD copy behind one menu (js_design wraps .tbl-tools) */');
    DBMS_OUTPUT.PUT_LINE('.tbl-tools.tmenu-on{margin:6px 0 -6px}');
    DBMS_OUTPUT.PUT_LINE('.tmenu{position:relative}');
    DBMS_OUTPUT.PUT_LINE('.tmenu > summary{list-style:none;cursor:pointer;width:28px;height:24px;display:grid;place-items:center;border-radius:6px;color:var(--muted);font-weight:700;letter-spacing:.08em;line-height:1}');
    DBMS_OUTPUT.PUT_LINE('.tmenu > summary::-webkit-details-marker{display:none}');
    DBMS_OUTPUT.PUT_LINE('.tmenu > summary:hover,.tmenu[open] > summary{background:var(--hov);color:var(--ink)}');
    DBMS_OUTPUT.PUT_LINE('.tmenu .tmenu-p{position:absolute;right:0;top:calc(100% + 4px);z-index:30;display:flex;flex-direction:column;min-width:150px;padding:4px;background:var(--panel);border:1px solid var(--hairline);border-radius:10px;box-shadow:0 8px 24px oklch(0 0 0 / 12%)}');
    DBMS_OUTPUT.PUT_LINE('.tmenu .tool-btn{border:0;background:none;text-align:left;padding:6px 8px;border-radius:6px;font-size:13px;font-weight:400;color:var(--ink)}');
    DBMS_OUTPUT.PUT_LINE('.tmenu .tool-btn:hover{background:var(--hov)}');
    DBMS_OUTPUT.PUT_LINE('/* ==== 7. the window component: release flags without boxes, priors on hover ==== */');
    DBMS_OUTPUT.PUT_LINE('.wg .flag{background:none;padding:0 4px;color:var(--muted);font-size:11px}');
    DBMS_OUTPUT.PUT_LINE('.wg .flag::before{border-left:1px dashed var(--mk)}');
    DBMS_OUTPUT.PUT_LINE('.wg .pole{border-left:1px dashed var(--mk)}');
    DBMS_OUTPUT.PUT_LINE('.wg .c.mk,.wg .h.mk{box-shadow:inset 1px 0 0 var(--mkline)}');
    DBMS_OUTPUT.PUT_LINE('.wg i.b{border-radius:3px 3px 0 0}');
    DBMS_OUTPUT.PUT_LINE('body.js-wg .wg.allv .c:not(.cur) .v:not(.nil){opacity:0}');
    DBMS_OUTPUT.PUT_LINE('.wg .c.hc .v{opacity:1!important}');
    DBMS_OUTPUT.PUT_LINE('.wg .ruler .gh{border-left-color:var(--hairline)}');
    DBMS_OUTPUT.PUT_LINE('/* ==== 8. Activity: flags drawn once, boxless; "How to read" popover ==== */');
    DBMS_OUTPUT.PUT_LINE('.ashx .cfh{fill:none}');
    DBMS_OUTPUT.PUT_LINE('.ashx .cf{stroke:var(--muted);stroke-width:1}');
    DBMS_OUTPUT.PUT_LINE('.ashx .cfl{stroke:var(--mk);stroke-width:1;stroke-dasharray:3 3;opacity:.7}');
    DBMS_OUTPUT.PUT_LINE('.ashx .cft{fill:var(--muted);font-size:11px}');
    DBMS_OUTPUT.PUT_LINE('.ashx .xw{opacity:.1}');
    DBMS_OUTPUT.PUT_LINE('.ashx .xw.cur{opacity:.3}');
    DBMS_OUTPUT.PUT_LINE('.ashx .axr{border-color:var(--hairline);border-radius:8px}');
    DBMS_OUTPUT.PUT_LINE('.ashx .axct h3{font-weight:500;color:var(--ink)}');
    DBMS_OUTPUT.PUT_LINE('.ashx .axk{gap:var(--s3)}');
    DBMS_OUTPUT.PUT_LINE('.ashx.howable .axh{position:relative}');
    DBMS_OUTPUT.PUT_LINE('.ashx.howable .axn2{display:none}');
