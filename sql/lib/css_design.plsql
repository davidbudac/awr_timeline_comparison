    DBMS_OUTPUT.PUT_LINE('@media (max-width:980px){.dsearch kbd{display:none}}');
    DBMS_OUTPUT.PUT_LINE('@media (max-width:900px){.dft{--dcols:18px 84px minmax(120px,1fr) 96px 104px 72px}.dft .dbd,.dft .dtr{display:none}}');
    DBMS_OUTPUT.PUT_LINE('@media (max-width:640px){.dft{--dcols:14px minmax(110px,1fr) 92px 64px}.dft .dsev,.dft .dnr,.dft .dfh > span:nth-child(2){display:none}.drow .dbody{padding-left:0}.dkpis{grid-template-columns:minmax(0,1fr)}}');
    DBMS_OUTPUT.PUT_LINE('/* phones: a wide table scrolls inside its own box (its header stops being sticky there) */');
    DBMS_OUTPUT.PUT_LINE('@media (max-width:700px){.tblwrap{overflow-x:auto;overscroll-behavior-x:contain}.tblwrap table thead th{position:static}');
    DBMS_OUTPUT.PUT_LINE('  .topbar .win{flex-wrap:wrap;white-space:normal;row-gap:2px}');
    DBMS_OUTPUT.PUT_LINE('  h2 > .meta{flex-wrap:wrap;white-space:normal;margin-left:0}');
    DBMS_OUTPUT.PUT_LINE('  body.vs main > section.lib > h2{flex-wrap:wrap}');
    DBMS_OUTPUT.PUT_LINE('  body.vs main > section.lib > h2 > .lt{flex-basis:auto}');
    DBMS_OUTPUT.PUT_LINE('  .ngrid,.dpanel #s-normal .ngrid{grid-template-columns:minmax(0,1fr)}.calm{padding:var(--s2) var(--s4)}.calm-notes{grid-template-columns:minmax(0,1fr)}}');
    DBMS_OUTPUT.PUT_LINE('@media (prefers-reduced-motion:reduce){.drow .dch,.tmenu-p,.axn2{transition:none}}');
    DBMS_OUTPUT.PUT_LINE('</style>');
END;
/
