    DBMS_OUTPUT.PUT_LINE('.axhow{display:inline-flex;align-items:center;gap:6px;font:inherit;font-size:12px;color:var(--muted);background:none;border:0;border-radius:6px;padding:2px 6px;cursor:pointer}');
